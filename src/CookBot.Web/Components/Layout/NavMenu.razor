@rendermode InteractiveServer
@inject CurrentUserService UserService
@inject Microsoft.Extensions.Options.IOptions<CookBot.Application.DTOs.CookBotSettings> CookBotSettingsOptions

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/cookbooks" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">Cookbooks</MudNavLink>
    <MudNavLink Href="/pantry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Kitchen">Pantry</MudNavLink>
    <MudNavLink Href="/grocery-lists" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">Grocery Lists</MudNavLink>
    @if (_aiEnabled)
    {
        <MudNavLink Href="/ai" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoAwesome">AI Assistant</MudNavLink>
        <MudNavLink Href="/prompt-builder" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ContentPaste">Prompt Builder</MudNavLink>
    }
    <MudNavLink Href="/profile" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
</MudNavMenu>

@code {
    private bool _aiEnabled;

    protected override async Task OnInitializedAsync()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        var user = await UserService.GetCurrentUserAsync();
        _aiEnabled = CookBotSettingsOptions.Value.AiFeaturesEnabled && (user?.Profile?.AiEnabled ?? false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UserService.CurrentUserId.HasValue) return;

        var user = await UserService.GetCurrentUserAsync();
        var newValue = CookBotSettingsOptions.Value.AiFeaturesEnabled && (user?.Profile?.AiEnabled ?? false);
        if (newValue != _aiEnabled)
        {
            _aiEnabled = newValue;
            StateHasChanged();
        }
    }
}
