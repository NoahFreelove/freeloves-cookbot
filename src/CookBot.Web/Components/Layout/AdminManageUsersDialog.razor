@inject CurrentUserService UserService
@inject ICbDialogService CbDialogService
@inject ICbToastService Toast

@* Phase 7 / Plan 07-05: AdminManageUsersDialog migrated to CbDialog slots (D-27).
   Body lists users with a delete-icon button (admin only); footer hosts Add user
   + Close. Inner dialogs (AddUserDialog, ConfirmDialog) launched via
   CbDialogService. Toasts via ICbToastService. ZERO Mud*. *@

<div>
    @if (!_isAdmin)
    {
        <div class="cb-card" style="background:var(--cream-2);color:var(--ink-2);padding:12px;margin-bottom:12px;border:none;font-size:13px;">
            To remove users, select an account that has <strong>admin</strong> permission
            (the <strong>Home Chef</strong> account on a typical install), then open this
            dialog again.
        </div>
    }

    <p style="margin:0 0 14px 0;font-size:13px;color:var(--ink-3);">
        Removing a user deletes their cookbooks, recipes, pantries, grocery lists,
        conversations, and profile. This cannot be undone.
    </p>

    <div style="display:flex;flex-direction:column;gap:6px;">
        @foreach (var user in _users)
        {
            <div class="cb-card" style="padding:10px 12px;display:flex;align-items:center;gap:10px;">
                <span style="flex:1;font-size:14px;color:var(--ink);">@user.DisplayName</span>
                @if (!user.IsCookBotAdmin)
                {
                    <button type="button"
                            class="cb-btn ghost"
                            style="padding:4px 8px;color:@(_isAdmin ? "var(--warn)" : "var(--ink-4)");"
                            disabled="@(!_isAdmin)"
                            title="@(_isAdmin ? "Remove this user" : "Sign in as an admin user in the header to enable removal")"
                            aria-label="@($"Delete user {user.DisplayName}")"
                            @onclick="@(() => ConfirmDeleteUser(user))">
                        <Icon Name="@Icon.Names.Trash" Size="14" />
                    </button>
                }
                else
                {
                    <span style="font-size:12px;color:var(--ink-3);">Admin</span>
                }
            </div>
        }
    </div>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px;">
        @if (_isAdmin)
        {
            <CbButton Variant="CbButton.CbButtonVariant.Primary" StartIcon="@Icon.Names.Plus"
                      OnClick="ShowAddUserDialog">
                Add user
            </CbButton>
        }
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Close">Close</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }

    [Parameter] public EventCallback OnUsersChanged { get; set; }

    private List<User> _users = new();
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await UserService.IsCookBotAdminAsync();
        _users = await UserService.GetAllUsersAsync();
    }

    private void Close() => DialogInstance?.Close(CbDialogResult.Ok());

    private async Task ShowAddUserDialog()
    {
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.ExtraSmall, FullWidth: true);
        var result = await CbDialogService.ShowAsync<AddUserDialog>("Add user", null, options);
        if (result != null && !result.Canceled && result.Data is string name && !string.IsNullOrWhiteSpace(name))
        {
            await UserService.CreateUserAsync(name);
            _users = await UserService.GetAllUsersAsync();
            await OnUsersChanged.InvokeAsync();
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteUser(User user)
    {
        var parameters = new CbDialogParameters
        {
            ["Title"] = "Delete user",
            ["Message"] = $"Remove \"{user.DisplayName}\" and all of their data? This cannot be undone.",
            ["ConfirmLabel"] = "Delete",
            ["Destructive"] = true,
        };
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.ExtraSmall, FullWidth: true);
        var confirmResult = await CbDialogService.ShowAsync<CookBot.Web.Components.Dialogs.ConfirmDialog>("Delete user", parameters, options);

        if (confirmResult == null || confirmResult.Canceled || confirmResult.Data is not true || !UserService.CurrentUserId.HasValue)
            return;

        var result = await UserService.DeleteUserAsAdminAsync(UserService.CurrentUserId.Value, user.Id);
        switch (result)
        {
            case AdminDeleteUserResult.Success:
                Toast.Show($"User \"{user.DisplayName}\" removed.", CbToastSeverity.Info);
                _users = await UserService.GetAllUsersAsync();
                await OnUsersChanged.InvokeAsync();
                break;
            case AdminDeleteUserResult.NotAuthorized:
                Toast.Show("Only an admin user can delete other users.", CbToastSeverity.Error);
                break;
            case AdminDeleteUserResult.CannotDeleteAdminAccount:
                Toast.Show("Admin accounts cannot be deleted from here.", CbToastSeverity.Warning);
                break;
            case AdminDeleteUserResult.UserNotFound:
                Toast.Show("User was already removed.", CbToastSeverity.Warning);
                _users = await UserService.GetAllUsersAsync();
                await OnUsersChanged.InvokeAsync();
                break;
        }
        StateHasChanged();
    }
}
