@inherits LayoutComponentBase
@inject CurrentUserService UserService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ICbTopBarService TopBarService
@implements IDisposable

@* MainLayout — Phase 5 / Plan 05-05 / SHELL-01 / D-19 (Phase 7 / Plan 07-07 final).

   Cb-only shell: cb-shell CSS grid + Sidebar + TopBar + main column,
   with CbDialogHost + CbToastHost mounted globally.

   Invariants preserved verbatim from the previous layout:
     - cookbot_dark_mode localStorage key + body.dark-mode class toggle (D-04)
     - sessionStorage.cookbot_current_user restore (UserService.CurrentUserId)
     - Auto-create "Home Chef" admin user when no users exist
     - CascadingValue Name="CurrentUserId" so existing pages keep reading it
     - cookbot.applyDefaults() called once on first render (Plan 05-01)

   _isDarkMode field is retained: it drives the body.dark-mode class via the
   existing JS interop (no theme provider needed; tokens live in cookbot-design.css). *@

<CbDialogHost />
<CbToastHost />

<div class="cb cb-shell @(_drawerCollapsed ? "is-collapsed" : "")">
    @if (!_drawerCollapsed)
    {
        <Sidebar />
    }
    <main style="display:flex;flex-direction:column;min-width:0;">
        <TopBar IsDarkMode="_isDarkMode"
                IsDarkModeChanged="OnDarkModeChanged"
                OnUserSwitched="OnUserSwitched"
                IsDrawerCollapsed="_drawerCollapsed"
                OnToggleDrawer="OnToggleDrawer"
                RightSlot="@TopBarService.RightSlot" />
        <div style="flex:1;overflow:auto;padding:24px;">
            <CascadingValue Value="UserService.CurrentUserId" Name="CurrentUserId">
                @Body
            </CascadingValue>
        </div>
    </main>
</div>

@code {
    private List<User> _users = new();
    private bool _isDarkMode;
    private bool _drawerCollapsed;

    protected override async Task OnInitializedAsync()
    {
        // Phase 10 / Plan 10-09 / POLISH-04 / D-56 — subscribe to TopBar right-slot changes.
        // Mirrors CbToastHost subscribe-in-OnInitialized / unsubscribe-in-Dispose pattern.
        TopBarService.OnChanged += HandleSlotChanged;

        // Auto-create Home Chef admin if no users exist (preserved from existing layout).
        _users = await UserService.GetAllUsersAsync();
        if (!_users.Any())
        {
            await UserService.CreateUserAsync("Home Chef", isCookBotAdmin: true);
            _users = await UserService.GetAllUsersAsync();
        }

        // Default user during prerender (preserved). OnAfterRenderAsync overrides with sessionStorage.
        if (!UserService.CurrentUserId.HasValue && _users.Any())
        {
            var defaultUser = _users.FirstOrDefault(u => u.DisplayName == "Home Chef")
                ?? _users.OrderBy(u => u.Id).First();
            UserService.CurrentUserId = defaultUser.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Apply data-accent / data-density defaults on <html> (Plan 05-01 cookbot-shell.js).
                await JS.InvokeVoidAsync("cookbot.applyDefaults");

                // Restore session-stored user.
                var stored = await JS.InvokeAsync<string?>("sessionStorage.getItem", "cookbot_current_user");
                if (stored != null && int.TryParse(stored, out var savedId) && _users.Any(u => u.Id == savedId))
                {
                    UserService.CurrentUserId = savedId;
                }

                // Restore dark-mode preference (preserved verbatim from existing layout).
                var darkPref = await JS.InvokeAsync<string?>("localStorage.getItem", "cookbot_dark_mode");
                if (darkPref == "true")
                {
                    _isDarkMode = true;
                    await JS.InvokeVoidAsync("document.body.classList.toggle", "dark-mode", true);
                }

                // Restore sidebar collapse preference.
                var drawerPref = await JS.InvokeAsync<string?>("localStorage.getItem", "cookbot_drawer_collapsed");
                if (drawerPref == "true")
                {
                    _drawerCollapsed = true;
                }

                StateHasChanged();
            }
            catch (InvalidOperationException)
            {
                // JS interop unavailable during prerender — skip session restore.
            }
        }
    }

    private async Task OnDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "cookbot_dark_mode", newValue.ToString().ToLower());
            await JS.InvokeVoidAsync("document.body.classList.toggle", "dark-mode", newValue);
        }
        catch (InvalidOperationException) { /* prerender — ignore */ }
    }

    private void OnUserSwitched()
    {
        // TopBar issues Navigation.NavigateTo(forceLoad: true) after a successful switch,
        // which reloads the whole page; MainLayout's OnAfterRenderAsync re-runs and re-reads
        // sessionStorage. No extra work needed here.
    }

    private async Task OnToggleDrawer()
    {
        _drawerCollapsed = !_drawerCollapsed;
        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "cookbot_drawer_collapsed",
                _drawerCollapsed.ToString().ToLower());
        }
        catch (InvalidOperationException) { /* prerender — ignore */ }
    }

    // Phase 10 / Plan 10-09 / POLISH-04 / T-10-09-01 — slot-change handler.
    // Called by ICbTopBarService.OnChanged whenever a page sets or clears RightSlot.
    // InvokeAsync marshals back onto the Blazor renderer thread before calling StateHasChanged.
    private void HandleSlotChanged() => _ = InvokeAsync(StateHasChanged);

    // Phase 10 / Plan 10-09 / POLISH-04 / T-10-09-01 — unsubscribe from OnChanged on dispose
    // to prevent the event from holding a reference to the disposed component.
    public void Dispose() => TopBarService.OnChanged -= HandleSlotChanged;
}
