@inherits LayoutComponentBase
@inject CurrentUserService UserService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.RamenDining" Class="ml-2" />
        <MudText Typo="Typo.h5" Class="ml-2" Style="font-weight: 600;">CookBot</MudText>
        <MudSpacer />
        @if (_users.Any())
        {
            <MudSelect T="int" Value="_selectedUserId" ValueChanged="OnUserChanged"
                       Variant="Variant.Text" Dense="true" Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                       Class="mt-0 mr-2" Style="color: white; max-width: 180px; min-width: 120px;">
                @foreach (var user in _users)
                {
                    <MudSelectItem Value="@user.Id">@user.DisplayName</MudSelectItem>
                }
            </MudSelect>
        }
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="mr-1 text-none"
                   Style="color: white; text-transform: none;"
                   StartIcon="@Icons.Material.Filled.ManageAccounts"
                   OnClick="ShowAdminManageUsersDialog">
            Manage users
        </MudButton>
        <MudTooltip Text="Add User">
            <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Inherit"
                           OnClick="ShowAddUserDialog" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 px-4 pb-4">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            <CascadingValue Value="UserService.CurrentUserId" Name="CurrentUserId">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private List<User> _users = new();
    private int _selectedUserId;
    private MudTheme _theme = null!;

    [CascadingParameter]
    private Task<User?>? CurrentUser { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _theme = new MudTheme
        {
            PaletteLight = new PaletteLight
            {
                Primary = "#E65100",
                Secondary = "#2E7D32",
                AppbarBackground = "#E65100",
                Background = "#FFF8E1",
                Surface = "#FFFFFF",
                DrawerBackground = "#FFF3E0",
                DrawerText = "#3E2723",
                TextPrimary = "#3E2723",
                TextSecondary = "#5D4037",
            },
            Typography = new Typography
            {
                Default = new DefaultTypography
                {
                    FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" }
                }
            }
        };

        // Load users during initialization so the selector renders during prerender
        _users = await UserService.GetAllUsersAsync();

        // If no users exist at all, auto-create a default one
        if (!_users.Any())
        {
            await UserService.CreateUserAsync("Home Chef", isCookBotAdmin: true);
            _users = await UserService.GetAllUsersAsync();
        }

        // Set a default user during prerender so pages don't show "no user selected"
        // OnAfterRenderAsync will override this with the sessionStorage value if available
        if (!UserService.CurrentUserId.HasValue && _users.Any())
        {
            var defaultUser = _users.FirstOrDefault(u => u.DisplayName == "Home Chef")
                ?? _users.OrderBy(u => u.Id).First();
            UserService.CurrentUserId = defaultUser.Id;
            _selectedUserId = defaultUser.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restore session from browser storage (JS interop only available after circuit connects)
            try
            {
                var stored = await JS.InvokeAsync<string?>("sessionStorage.getItem", "cookbot_current_user");
                if (stored != null && int.TryParse(stored, out var savedId) && _users.Any(u => u.Id == savedId))
                {
                    UserService.CurrentUserId = savedId;
                    _selectedUserId = savedId;
                    StateHasChanged();
                }
            }
            catch (InvalidOperationException)
            {
                // JS interop not available — skip session restore
            }
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task OnUserChanged(int userId)
    {
        if (await UserService.UserHasPasswordAsync(userId))
        {
            var user = _users.First(u => u.Id == userId);
            var parameters = new DialogParameters<PasswordPromptDialog>
            {
                { x => x.UserId, userId },
                { x => x.UserName, user.DisplayName },
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
            var dialog = await DialogService.ShowAsync<PasswordPromptDialog>("Password Required", parameters, options);
            var result = await dialog.Result;
            if (result == null || result.Canceled)
            {
                _selectedUserId = UserService.CurrentUserId ?? _selectedUserId;
                StateHasChanged();
                return;
            }
        }

        _selectedUserId = userId;
        UserService.CurrentUserId = userId;
        await JS.InvokeVoidAsync("sessionStorage.setItem", "cookbot_current_user", userId.ToString());
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task ShowAddUserDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddUserDialog>("Add User", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is string name && !string.IsNullOrWhiteSpace(name))
        {
            var user = await UserService.CreateUserAsync(name);
            _users = await UserService.GetAllUsersAsync();
            _selectedUserId = user.Id;
            UserService.CurrentUserId = user.Id;
            await JS.InvokeVoidAsync("sessionStorage.setItem", "cookbot_current_user", user.Id.ToString());
            StateHasChanged();
        }
    }

    private async Task ShowAdminManageUsersDialog()
    {
        var parameters = new DialogParameters<AdminManageUsersDialog>
        {
            { x => x.OnUsersChanged, EventCallback.Factory.Create(this, HandleAdminUsersChanged) },
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<AdminManageUsersDialog>("Manage users", parameters, options);
    }

    private async Task HandleAdminUsersChanged()
    {
        _users = await UserService.GetAllUsersAsync();
        if (!_users.Any())
        {
            await UserService.CreateUserAsync("Home Chef", isCookBotAdmin: true);
            _users = await UserService.GetAllUsersAsync();
        }

        if (UserService.CurrentUserId is int uid && !_users.Any(u => u.Id == uid))
        {
            var next = _users[0];
            UserService.CurrentUserId = next.Id;
            _selectedUserId = next.Id;
            await JS.InvokeVoidAsync("sessionStorage.setItem", "cookbot_current_user", next.Id.ToString());
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        if (!_users.Any(u => u.Id == _selectedUserId))
            _selectedUserId = UserService.CurrentUserId ?? _users[0].Id;

        StateHasChanged();
    }
}
