@inject CurrentUserService UserService

@* Phase 7 / Plan 07-05: PasswordPromptDialog migrated to CbDialog slots (D-27).
   Returns CbDialogResult.Ok(true) on successful unlock and Cancel() on dismiss.
   Enter key on the password field submits. The "incorrect password" state is
   shown inline (the dialog stays open for retry). *@

<div>
    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
        <span>Password for <strong>@UserName</strong></span>
        <CbInput Type="password" @bind-Value="_password"
                 Placeholder="Password" />
    </label>
    @if (_error)
    {
        <p style="margin:8px 0 0 0;font-size:13px;color:var(--warn);">Incorrect password.</p>
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Submit"
                  Disabled="@string.IsNullOrWhiteSpace(_password)">Unlock</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public string UserName { get; set; } = "";

    private string _password = "";
    private bool _error;

    private void Cancel() => DialogInstance?.Cancel();

    private async Task Submit()
    {
        _error = false;
        if (await UserService.VerifyPasswordAsync(UserId, _password))
        {
            DialogInstance?.Close(CbDialogResult.Ok(true));
        }
        else
        {
            _error = true;
            _password = "";
        }
    }
}
