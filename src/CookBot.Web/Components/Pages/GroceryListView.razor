@page "/grocery-lists"
@page "/grocery-lists/from-recipe/{RecipeId:int}"
@using CookBot.Infrastructure.Data
@using CookBot.Domain.Enums
@inject CurrentUserService UserService
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookBot.Application.Services.GroceryListService GroceryListService
@inject CookBot.Application.Services.PantryService PantryService
@inject NavigationManager Navigation
@inject ICbDialogService CbDialogService
@inject ICbToastService Toast
@rendermode InteractiveServer

@* Phase 7 / Plan 07-03 / GR-01..04.
   Custom Razor rewrite against Phase 5 atoms per
   `.planning/design-handoff/project/screens/grocery-phone.jsx`.
   Mobile-first layout that works on desktop too — narrower main column on mobile
   via standard CSS (max-width:560px on the .grocery-list block).
   - Per-list header: name + sub-line "{N} items · from {M} recipes" + share / more icons.
   - Progress card: "Progress" label + tabular-numeral counter ({checked} / {total}) + 6px-tall accent fill bar.
   - Aisle-categorized sections (eyebrow + CbCard Padding=0): each row has a custom
     24px circle checkbox (accent-fill + check icon when checked, 2px line border when
     unchecked), item name (line-through when checked, opacity 0.45), quantity
     right-aligned tabular numeral. Click anywhere on row toggles purchased state.
   - Bottom action bar: full-width accent CbButton "Add item" (50px height, 25px radius).
   Phase 7 hard invariant: zero Mud* symbols in this file. *@

<PageTitle>CookBot - Grocery Lists</PageTitle>

<UserGuard>
    <div style="max-width:1180px;">

        @* ── Page header ──────────────────────────────────────────────────────── *@
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:24px;flex-wrap:wrap;">
            <div style="flex:1;min-width:240px;">
                <h1 style="font-size:32px;letter-spacing:-0.025em;line-height:1.05;margin:0;">Grocery Lists</h1>
                <div style="font-size:13px;color:var(--ink-3);margin-top:6px;">
                    @if (_groceryLists.Count == 0)
                    {
                        <text>No lists yet — create one to get started.</text>
                    }
                    else
                    {
                        <text>@_groceryLists.Count list@(_groceryLists.Count == 1 ? "" : "s")</text>
                    }
                </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Plus" OnClick="ShowNewListDialog">
                    New list
                </CbButton>
            </div>
        </div>

        @if (_generatingFromRecipe && _recipe != null)
        {
            <div role="status"
                 style="background:var(--accent-soft);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:18px;font-size:13.5px;color:var(--accent-ink);">
                Generating shopping list for <strong>@_recipe.Name</strong>…
            </div>
        }

        @if (_groceryLists.Count == 0)
        {
            <CbCard Padding="48" Style="text-align:center;">
                <Icon Name="@Icon.Names.Cart" Size="40" />
                <h3 style="font-size:18px;margin:14px 0 6px 0;">No grocery lists yet</h3>
                <p style="color:var(--ink-3);font-size:13.5px;margin:0 0 18px 0;max-width:32rem;margin-left:auto;margin-right:auto;line-height:1.55;">
                    Create a list with <strong>New list</strong>, or open a recipe and use
                    "What do I need?" to add missing ingredients.
                </p>
                <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Plus" OnClick="ShowNewListDialog">
                    Create a list
                </CbButton>
            </CbCard>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:32px;">
                @foreach (var list in _groceryLists)
                {
                    @RenderList(list)
                }
            </div>
        }
    </div>
</UserGuard>

@code {
    [Parameter] public int RecipeId { get; set; }
    private List<GroceryList> _groceryLists = new();
    private Recipe? _recipe;
    private bool _generatingFromRecipe;

    private int? _loadedUserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UserService.CurrentUserId.HasValue && _loadedUserId != UserService.CurrentUserId.Value)
        {
            _loadedUserId = UserService.CurrentUserId.Value;

            if (RecipeId > 0)
            {
                _generatingFromRecipe = true;
                var uid = UserService.CurrentUserId.Value;
                if (!await DbContext.UserCanAccessRecipeAsync(RecipeId, uid))
                {
                    Toast.Show("You do not have access to that recipe.", CbToastSeverity.Warning);
                    Navigation.NavigateTo("/cookbooks");
                }
                else
                {
                    _recipe = await DbContext.Recipes
                        .Include(r => r.RecipeIngredients).ThenInclude(ri => ri.Ingredient)
                        .FirstOrDefaultAsync(r => r.Id == RecipeId);

                    if (_recipe != null)
                    {
                        var list = await GroceryListService.GenerateFromRecipeAsync(uid, _recipe);
                        if (list.Items.Any())
                        {
                            Toast.Show($"Shopping list created with {list.Items.Count} items!", CbToastSeverity.Success);
                        }
                        else
                        {
                            Toast.Show("You have everything you need!", CbToastSeverity.Info);
                        }
                    }
                }

                _generatingFromRecipe = false;
            }

            await LoadLists();
            StateHasChanged();
        }
    }

    private async Task LoadLists()
    {
        if (UserService.CurrentUserId is int userId)
        {
            _groceryLists = await DbContext.GroceryLists
                .Include(g => g.Items).ThenInclude(i => i.Ingredient)
                .Where(g => g.UserId == userId)
                .OrderByDescending(g => g.CreatedAt)
                .ToListAsync();
        }
    }

    private RenderFragment RenderList(GroceryList list) => __builder =>
    {
        var total = list.Items.Count;
        var checkedCount = list.Items.Count(i => i.IsPurchased);
        var pct = total == 0 ? 0 : (int)Math.Round((double)checkedCount / total * 100);
        var groups = list.Items
            .OrderBy(i => i.Ingredient.Category)
            .ThenBy(i => i.Ingredient.Name, StringComparer.OrdinalIgnoreCase)
            .GroupBy(i => i.Ingredient.Category)
            .ToList();

        <section class="grocery-list" style="max-width:560px;display:flex;flex-direction:column;gap:14px;">

            @* ── Per-list header: name + sub + share + more ─────────────── *@
            <header style="display:flex;align-items:center;gap:12px;">
                <div style="flex:1;min-width:0;">
                    <div style="font-size:20px;font-weight:600;letter-spacing:-0.018em;line-height:1.15;">
                        @list.Name
                    </div>
                    <div style="font-size:12.5px;color:var(--ink-3);margin-top:2px;">
                        @total item@(total == 1 ? "" : "s") · created @list.CreatedAt.ToString("MMM d, yyyy")
                    </div>
                </div>
                <button type="button"
                        title="Mark all purchased & move to pantry"
                        aria-label="Mark all purchased and move to pantry"
                        @onclick="@(() => MarkPurchased(list))"
                        style="@IconBtnStyle">
                    <Icon Name="@Icon.Names.Share" Size="18" />
                </button>
                <button type="button"
                        title="Delete list"
                        aria-label="Delete list"
                        @onclick="@(() => ConfirmDeleteList(list))"
                        style="@IconBtnStyle">
                    <Icon Name="@Icon.Names.More" Size="18" />
                </button>
            </header>

            @* ── Progress card (GR-02) ───────────────────────────────────── *@
            <CbCard Padding="14">
                <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:8px;">
                    <span style="font-size:13px;font-weight:500;">Progress</span>
                    <span class="num" style="font-size:13px;color:var(--ink-3);">
                        @checkedCount / @total
                    </span>
                </div>
                <div role="progressbar"
                     aria-valuenow="@checkedCount" aria-valuemin="0" aria-valuemax="@total"
                     aria-label="Items purchased"
                     style="height:6px;background:var(--cream-2);border-radius:3px;overflow:hidden;">
                    <div style="width:@(pct)%;height:100%;background:var(--accent);transition:width 160ms ease;"></div>
                </div>
            </CbCard>

            @* ── Aisle-categorized sections (GR-03) ──────────────────────── *@
            @if (groups.Count == 0)
            {
                <CbCard Padding="20" Style="text-align:center;color:var(--ink-3);font-size:13.5px;">
                    No items yet. Use Add item to build this list.
                </CbCard>
            }
            else
            {
                foreach (var group in groups)
                {
                    var aisleItems = group.ToList();
                    <div>
                        <CbEyebrow>@group.Key.ToString()</CbEyebrow>
                        <CbCard Padding="0" Style="overflow:hidden;margin-top:8px;">
                            @for (var i = 0; i < aisleItems.Count; i++)
                            {
                                var item = aisleItems[i];
                                var isLast = i == aisleItems.Count - 1;
                                @RenderRow(item, isLast)
                            }
                        </CbCard>
                    </div>
                }
            }

            @* ── Bottom action: Add item (GR-04) ─────────────────────────── *@
            <div style="margin-top:4px;">
                <CbButton Variant="CbButton.CbButtonVariant.Accent" FullWidth="true" StartIcon="@Icon.Names.Plus"
                          Style="height:50px;border-radius:25px;font-size:15px;"
                          OnClick="@(() => ShowAddItemDialog(list))">
                    Add item
                </CbButton>
            </div>
        </section>
    };

    private RenderFragment RenderRow(GroceryListItem item, bool isLast) => __builder =>
    {
        // The whole row is clickable — toggles purchased state. Rendered as a div with
        // role="button" + tabindex + keydown handler (rather than a real <button>) so
        // we can nest a real <button> for the trash action without producing invalid
        // HTML. Custom 24px circle checkbox per the design (accent-fill + check glyph
        // when checked, 2px line border when unchecked) is rendered inline so we get
        // the round shape and accent-fill behavior.
        var done = item.IsPurchased;
        var border = isLast ? "none" : "1px solid var(--line)";
        var rowStyle = $"display:flex;align-items:center;gap:14px;padding:14px 16px;border-bottom:{border};cursor:pointer;user-select:none;";
        var boxBorder = done ? "none" : "2px solid var(--line-strong)";
        var boxBg = done ? "var(--accent)" : "transparent";
        var boxStyle = $"width:24px;height:24px;border-radius:12px;border:{boxBorder};background:{boxBg};display:grid;place-items:center;flex-shrink:0;color:var(--accent-ink);";
        var nameStyle = done
            ? "flex:1;font-size:15px;font-weight:500;text-decoration:line-through;opacity:0.45;min-width:0;overflow:hidden;text-overflow:ellipsis;"
            : "flex:1;font-size:15px;font-weight:500;min-width:0;overflow:hidden;text-overflow:ellipsis;";
        var qtyStyle = done
            ? "font-size:13px;color:var(--ink-3);opacity:0.45;white-space:nowrap;"
            : "font-size:13px;color:var(--ink-3);white-space:nowrap;";

        <div role="button"
             tabindex="0"
             aria-pressed="@done"
             aria-label="@($"Toggle {item.Ingredient.Name}")"
             @onclick="@(() => TogglePurchased(item))"
             @onkeydown="@(e => OnRowKeyDown(e, item))"
             style="@rowStyle">
            <span style="@boxStyle">
                @if (done)
                {
                    <Icon Name="@Icon.Names.Check" Size="14" />
                }
            </span>
            <span style="@nameStyle">@item.Ingredient.Name</span>
            <span class="num" style="@qtyStyle">
                @FormatQuantity(item)
            </span>
            <button type="button"
                    title="Remove from list"
                    aria-label="@($"Remove {item.Ingredient.Name} from list")"
                    @onclick="@(() => RemoveItem(item))"
                    @onclick:stopPropagation="true"
                    style="@RemoveBtnStyle">
                <Icon Name="@Icon.Names.Trash" Size="14" />
            </button>
        </div>
    };

    private async Task OnRowKeyDown(KeyboardEventArgs e, GroceryListItem item)
    {
        if (e.Key == " " || e.Key == "Enter" || e.Code == "Space")
        {
            await TogglePurchased(item);
        }
    }

    private static string FormatQuantity(GroceryListItem item)
    {
        var amount = item.Amount;
        var amountText = amount == Math.Floor(amount)
            ? amount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
            : amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var unit = CookBot.Application.Services.UnitParser.ToDisplayString(item.Unit);
        return string.IsNullOrWhiteSpace(unit) ? amountText : $"{amountText} {unit}";
    }

    private const string IconBtnStyle =
        "display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:17px;background:transparent;border:1px solid var(--line);color:var(--ink-2);cursor:pointer;flex-shrink:0;";

    private const string RemoveBtnStyle =
        "display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:14px;background:transparent;border:none;color:var(--ink-3);cursor:pointer;flex-shrink:0;margin-left:4px;";

    private async Task TogglePurchased(GroceryListItem item)
    {
        item.IsPurchased = !item.IsPurchased;
        // Persist the checkbox state first — DeductAsync below early-returns when the item
        // isn't in the pantry, which would otherwise leave this flag unsaved.
        await DbContext.SaveChangesAsync();

        // Two-way pantry sync: checking an item stocks it into the personal pantry;
        // unchecking deducts the same amount back out (mirrors MarkPurchased's bulk add).
        if (UserService.CurrentUserId is int uid)
        {
            var personalPantry = await PantryService.EnsurePersonalPantryAsync(uid);
            if (item.IsPurchased)
                await PantryService.AddOrUpdateAsync(personalPantry.Id, item.IngredientId, item.Amount, item.Unit, null);
            else
                await PantryService.DeductAsync(personalPantry.Id, item.IngredientId, item.Amount, item.Unit);
        }
    }

    private async Task MarkPurchased(GroceryList list)
    {
        var unpurchased = list.Items.Where(i => !i.IsPurchased).ToList();
        if (!unpurchased.Any())
        {
            Toast.Show("All items already purchased!", CbToastSeverity.Info);
            return;
        }

        if (!UserService.CurrentUserId.HasValue) return;

        var personalPantry = await PantryService.EnsurePersonalPantryAsync(UserService.CurrentUserId.Value);
        foreach (var item in unpurchased)
        {
            item.IsPurchased = true;
            await PantryService.AddOrUpdateAsync(
                personalPantry.Id,
                item.IngredientId,
                item.Amount,
                item.Unit,
                null);
        }
        await DbContext.SaveChangesAsync();
        Toast.Show($"{unpurchased.Count} items added to pantry!", CbToastSeverity.Success);
    }

    private async Task ConfirmDeleteList(GroceryList list)
    {
        var parameters = new CbDialogParameters()
            .Add(nameof(ConfirmDialog.Message), $"Delete the list \"{list.Name}\"? This can't be undone.")
            .Add(nameof(ConfirmDialog.ConfirmLabel), "Delete")
            .Add(nameof(ConfirmDialog.CancelLabel), "Cancel")
            .Add(nameof(ConfirmDialog.Destructive), true);
        var result = await CbDialogService.ShowAsync<ConfirmDialog>("Delete list", parameters);
        if (result.Canceled || result.Data is not true) return;

        DbContext.GroceryLists.Remove(list);
        await DbContext.SaveChangesAsync();
        _groceryLists.Remove(list);
        Toast.Show("Grocery list deleted.", CbToastSeverity.Info);
    }

    private async Task ShowNewListDialog()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        var result = await CbDialogService.ShowAsync<NewGroceryListDialog>("New grocery list");
        if (result.Canceled || result.Data is not string name)
            return;

        var displayName = string.IsNullOrWhiteSpace(name)
            ? $"Shopping list — {DateTime.UtcNow:MMM d, yyyy}"
            : name;

        var list = new GroceryList
        {
            UserId = UserService.CurrentUserId.Value,
            Name = displayName,
            CreatedAt = DateTime.UtcNow,
        };
        DbContext.GroceryLists.Add(list);
        await DbContext.SaveChangesAsync();
        await LoadLists();
        Toast.Show("Grocery list created.", CbToastSeverity.Success);
    }

    private async Task ShowAddItemDialog(GroceryList list)
    {
        if (!UserService.CurrentUserId.HasValue || list.UserId != UserService.CurrentUserId.Value)
            return;

        var ingredients = await DbContext.Ingredients.OrderBy(i => i.Name).ToListAsync();
        var parameters = new CbDialogParameters()
            .Add(nameof(AddGroceryListItemDialog.Ingredients), ingredients);
        var result = await CbDialogService.ShowAsync<AddGroceryListItemDialog>("Add item", parameters);
        if (result.Canceled || result.Data is not AddGroceryListItemDialog.GroceryItemResult data)
            return;

        var item = new GroceryListItem
        {
            GroceryListId = list.Id,
            IngredientId = data.IngredientId,
            Amount = data.Amount,
            Unit = data.Unit,
        };
        DbContext.GroceryListItems.Add(item);
        await DbContext.SaveChangesAsync();
        await LoadLists();
        Toast.Show("Item added to list.", CbToastSeverity.Success);
    }

    private async Task RemoveItem(GroceryListItem item)
    {
        DbContext.GroceryListItems.Remove(item);
        await DbContext.SaveChangesAsync();
        await LoadLists();
        Toast.Show("Item removed from list.", CbToastSeverity.Info);
    }
}
