@page "/recipes/{RecipeId:int}"
@using CookBot.Application.Services
@using CookBot.Infrastructure.Data
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CurrentUserService UserService
@inject CookBot.Application.Services.GroceryListService GroceryListService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>CookBot - @(_recipe?.Name ?? "Recipe")</PageTitle>

<UserGuard>
@if (_recipe != null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo($"/cookbooks/{_recipe.CookbookId}"))" />
        <MudText Typo="Typo.h4" Style="font-weight: 600;">@_recipe.Name</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Href="@($"/recipes/{RecipeId}/cook")">
            Start Cooking
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => Navigation.NavigateTo($"/recipes/{_recipe.Id}/edit"))">
            Edit
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd"
                   OnClick="AddAllToShoppingList" Disabled="_addingToList">
            Add all to shopping list
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                   OnClick="AddMissingToShoppingList" Disabled="_addingToList">
            Add what I need
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CheckCircle"
                   OnClick="MarkAsMade">
            I made this!
        </MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2" Style="border-radius: 12px;">
                <MudStack Row="true" Spacing="2" Class="mb-3">
                    @if (_recipe.PrepTimeMinutes.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                            Prep: @(_recipe.PrepTimeMinutes)m
                        </MudChip>
                    }
                    @if (_recipe.CookTimeMinutes.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                            Cook: @(_recipe.CookTimeMinutes)m
                        </MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">
                        @_recipe.Servings servings
                    </MudChip>
                </MudStack>

                @if (_tags.Any())
                {
                    <MudStack Row="true" Spacing="1" Class="mb-4" Wrap="Wrap.Wrap">
                        @foreach (var tag in _tags)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@tag</MudChip>
                        }
                    </MudStack>
                }

                <MudText Typo="Typo.h6" Class="mb-2">Ingredients</MudText>
                <MudNumericField @bind-Value="_targetServings" Label="Servings" Min="1" Max="100"
                    Variant="Variant.Outlined" Class="mt-2 mb-3" Style="max-width: 150px;" />
                <MudList T="string" Dense="true">
                    @foreach (var ri in _recipe.RecipeIngredients.OrderBy(i => i.RecipeLocalId))
                    {
                        <MudListItem>
                            <MudText>
                                <b>@RecipeScalingService.FormatScaledAmount(ri.Amount, _recipe.Servings, _targetServings) @ri.Unit</b>
                                @ri.Ingredient.Name
                                @if (!string.IsNullOrEmpty(ri.Note))
                                {
                                    <span style="color: #888;"> (@ri.Note)</span>
                                }
                            </MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-6" Elevation="2" Style="border-radius: 12px;">
                <MudText Typo="Typo.h6" Class="mb-3">Steps</MudText>
                @foreach (var step in _recipe.Steps.OrderBy(s => s.Order))
                {
                    @if (step.IsSection)
                    {
                        <MudText Typo="Typo.h6" Class="mt-4 mb-2 recipe-body">
                            @((MarkupString)RecipeStepTextFormatter.ToHtml(step.Text))
                        </MudText>
                    }
                    else
                    {
                        <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                            <div class="recipe-body" style="line-height: 1.6;">
                                @((MarkupString)RecipeStepTextFormatter.ToHtml(step.Text))
                            </div>
                            @foreach (var timer in step.Timers)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mt-1">
                                    @timer.Duration @timer.Unit
                                </MudChip>
                            }
                        </MudPaper>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else if (_loaded)
{
    <MudText>Recipe not found or you do not have access.</MudText>
}
</UserGuard>

@code {
    [Parameter] public int RecipeId { get; set; }
    private Recipe? _recipe;
    private bool _loaded;
    private bool _addingToList;
    private int _targetServings = 1;
    private List<string> _tags = new();

    private bool _initialized;
    private int _boundRecipeId;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (_boundRecipeId != RecipeId)
        {
            _boundRecipeId = RecipeId;
            _initialized = false;
            _recipe = null;
            _loaded = false;
            _tags = new();
            _targetServings = 1;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UserService.CurrentUserId.HasValue) return;
        var userId = UserService.CurrentUserId.Value;

        if (!_initialized)
        {
            _initialized = true;

            if (!await DbContext.UserCanAccessRecipeAsync(RecipeId, userId))
            {
                _recipe = null;
            }
            else
            {
                _recipe = await DbContext.Recipes
                    .Include(r => r.RecipeIngredients).ThenInclude(ri => ri.Ingredient)
                    .Include(r => r.Cookbook).ThenInclude(c => c.Shares)
                    .FirstOrDefaultAsync(r => r.Id == RecipeId);

                if (_recipe != null)
                {
                    _targetServings = _recipe.Servings;
                    _tags = System.Text.Json.JsonSerializer.Deserialize<List<string>>(_recipe.TagsJson) ?? new();
                }
            }

            _loaded = true;
            StateHasChanged();
        }
    }

    private async Task AddAllToShoppingList()
    {
        if (_recipe == null || !UserService.CurrentUserId.HasValue) return;
        _addingToList = true;
        StateHasChanged();

        var list = await GroceryListService.GenerateAllFromRecipeAsync(
            UserService.CurrentUserId.Value, _recipe);
        _addingToList = false;

        if (list.Items.Any())
        {
            Snackbar.Add($"Added {list.Items.Count} items to shopping list!", Severity.Success);
            Navigation.NavigateTo("/grocery-lists");
        }
        else
        {
            Snackbar.Add("This recipe has no ingredients.", Severity.Info);
        }
    }

    private async Task AddMissingToShoppingList()
    {
        if (_recipe == null || !UserService.CurrentUserId.HasValue) return;
        _addingToList = true;
        StateHasChanged();

        var list = await GroceryListService.GenerateFromRecipeAsync(
            UserService.CurrentUserId.Value, _recipe);
        _addingToList = false;

        if (list.Items.Any())
        {
            Snackbar.Add($"Added {list.Items.Count} missing items to shopping list!", Severity.Success);
            Navigation.NavigateTo("/grocery-lists");
        }
        else
        {
            Snackbar.Add("You already have everything you need!", Severity.Info);
        }
    }

    private void MarkAsMade()
    {
        Navigation.NavigateTo($"/recipes/{RecipeId}/made");
    }
}
