@page "/recipes/{RecipeId:int}"
@using System.Text.Json
@using CookBot.Application.DTOs
@using CookBot.Application.Recipes
@using CookBot.Application.Services
@using CookBot.Domain.Entities
@using CookBot.Domain.Enums
@using CookBot.Domain.Recipes
@using CookBot.Infrastructure.Data
@using CookBot.Infrastructure.Services
@using CookBot.Web.Components.Atoms
@using CookBot.Web.Services
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject RecipePhotoService RecipePhotoSvc
@inject CurrentUserService UserService
@inject JsonRecipeSerializer RecipeSerializer
@inject NavigationManager Navigation
@inject ICbDialogService CbDialogService
@inject IRecipeMadeService RecipeMadeService
@inject ICbTopBarService TopBarService
@inject RecipeUnitDisplayService UnitDisplayService
@inject IJSRuntime JS
@inject RecipePhotoUrlValidator UrlValidator
@inject INutritionService NutritionSvc
@implements IDisposable
@rendermode InteractiveServer

@*  Recipe View — Phase 6 / Plan 06-03 / RV-01..RV-05.
    Editorial rewrite against Phase 5 atoms per design handoff
    `screens/recipe-view.jsx`. Consumes the canonical RecipeDocument
    directly (Recipe.CanonicalDocumentJson) — NEVER reads
    Recipe.IngredientsJson / StepsJson / IngredientRefs (legacy columns — see CLEAN-02).
    Phase 6 SC#3 gate.

    PRAGMATIC notes:
      - The TopBar (MainLayout) does not currently expose a per-page right
        slot via cascading parameter; per CONTEXT D-17 fallback, Share/Cook
        actions render inline at the top of the page content.
      - "Notes from your last cook" and made-count are sourced from
        IRecipeMadeService (GetLastCookAsync / GetMadeCountAsync, wired in
        slice 09). The callout hides when there is no logged cook.
      - RecipeDocument has no description field; the 17px lead paragraph
        from the design hides when no description is available. *@

<PageTitle>CookBot - @(_doc?.Name ?? _recipe?.Name ?? "Recipe")</PageTitle>

@* INTEROP-01 — Prerender JSON-LD (trusted-LAN: emitted for every recipe whose doc is
   available at prerender time). Loaded in OnParametersSetAsync (prerender-safe, no JS interop).
   TODO(AuthMode): gate prerendered JSON-LD per-user once server-side auth lands. *@
@if (_jsonLd is not null)
{
    <HeadContent>
        @* Emit the whole <script> tag as one raw MarkupString. Rendering it as a Razor
           element routes the type attribute through HtmlEncoder.Default, which encodes
           '+' → '&#x2B;' (type="application/ld&#x2B;json") — spec-decodable but non-standard,
           and it breaks literal "application/ld+json" matching (uat-harness, naive validators).
           _jsonLd is already HTML-safe-encoded by the projector (< > & → \u00xx), so there is
           no </script> breakout risk in the raw payload. *@
        @((MarkupString)("<script type=\"application/ld+json\">" + _jsonLd + "</script>"))
    </HeadContent>
}

<UserGuard>
@if (_doc != null && _recipe != null)
{
    @* Inline action row — also rendered in TopBar.RightSlot on wide viewports (Phase 10 / Plan 10-09 / POLISH-04).
       D-59: class="recipe-actions-inline-fallback" is hidden above 720px by CSS media query; the TopBar slot
       shows the same _topBarActions RenderFragment instead. Below 720px the slot is hidden and this row shows. *@
    <div class="recipe-actions-inline-fallback">
        @_topBarActions
    </div>

    <article class="recipe-article">

        @* Hero (RV-01) *@
        <div class="recipe-hero">
            <div>
                @if (_doc.Tags.Count > 0)
                {
                    <CbEyebrow><div style="margin-bottom:14px;">@string.Join(" · ", _doc.Tags)</div></CbEyebrow>
                }
                <h1 class="cb-recipe-cap" style="margin:0;">@_doc.Name</h1>

                @* D-39 view-side mirror — Description is the recipe's lede, rendered directly
                   under the title to mirror RecipeEditor's reading order (name → description
                   → ingredients). Hidden when the canonical doc has no description. *@
                @if (!string.IsNullOrWhiteSpace(_doc.Description))
                {
                    <p class="recipe-lede" style="font-size:16px;color:var(--ink-2);margin:8px 0 0 0;line-height:1.5;">@_doc.Description</p>
                }

                @* Phase 12 — Provenance credit (FORMAT-04, UI-SPEC §4, D-12-08: link safety via UrlValidator) *@
                @if (_doc.Provenance is { } prov && (prov.AuthorName != null || prov.SourceName != null))
                {
                    var credit = BuildProvenanceCredit(prov);
                    <div style="margin-top:8px;">
                        @if (_validatedSourceUrl != null)
                        {
                            <a href="@_validatedSourceUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               style="font-size:14px;font-style:italic;color:var(--ink-3);text-decoration:underline;text-underline-offset:3px;">
                                @credit
                            </a>
                        }
                        else
                        {
                            <p style="font-size:14px;font-style:italic;color:var(--ink-3);margin:0;">@credit</p>
                        }
                    </div>
                }

                <div style="display:flex;gap:24px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line);">
                    <div>
                        <div class="eyebrow" style="font-size:10px;">Active</div>
                        <div class="num" style="font-size:22px;font-weight:600;margin-top:4px;">
                            @(_doc.PrepTimeMinutes?.ToString() ?? "—")<span style="font-size:13px;color:var(--ink-3);margin-left:4px;">min</span>
                        </div>
                    </div>
                    <div>
                        <div class="eyebrow" style="font-size:10px;">Total</div>
                        <div class="num" style="font-size:22px;font-weight:600;margin-top:4px;">
                            @TotalTimeText<span style="font-size:13px;color:var(--ink-3);margin-left:4px;">min</span>
                        </div>
                    </div>
                    <div>
                        <div class="eyebrow" style="font-size:10px;">Serves</div>
                        <div class="num" style="font-size:22px;font-weight:600;margin-top:4px;">@_doc.Servings</div>
                    </div>
                    <div>
                        <div class="eyebrow" style="font-size:10px;">Made</div>
                        <div class="num" style="font-size:22px;font-weight:600;margin-top:4px;">
                            @_madeCount<span style="font-size:13px;color:var(--ink-3);margin-left:4px;">×</span>
                        </div>
                    </div>
                </div>
            </div>
            @* Phase 14 / Plan 14-04 / GALLERY-03 — Gallery hero + thumbnail strip.
               Hero shows the currently displayed photo (_displayedPhotoId). Falls back to
               _doc.PhotoUrl (canonical mirror) when the gallery row is not yet loaded.
               One-shot _failedPhotoIds prevents the browser looping onerror (P14 / PITFALL H4).
               referrerpolicy='no-referrer' + loading='lazy' on every img (T-14-15 / PHOTO-08). *@
            @{
                var displayedPhoto = _photos.Count > 0
                    ? _photos.FirstOrDefault(p => p.Id == _displayedPhotoId) ?? _photos[0]
                    : null;
                var heroUrl = displayedPhoto is not null && !_failedPhotoIds.Contains(displayedPhoto.Id)
                    ? displayedPhoto.Url
                    : (!_heroPhotoFailed ? _doc.PhotoUrl : null);
            }
            @if (!string.IsNullOrEmpty(heroUrl))
            {
                <img src="@heroUrl"
                     alt="@($"{_doc.Name} hero photo")"
                     referrerpolicy="no-referrer"
                     loading="lazy"
                     @onerror="HandleHeroPhotoError"
                     style="width:100%;height:420px;object-fit:cover;border-radius:10px;display:block;" />
            }
            else
            {
                <StripedPlaceholder Width="100%" Height="420" Label="hero photo · 4:3" />
            }

            @* Caption below hero — display only when non-empty (UI-SPEC §Surface 1 §Caption) *@
            @if (!string.IsNullOrWhiteSpace(displayedPhoto?.Caption))
            {
                <p style="font-size:14px;color:var(--ink-3);margin-top:4px;font-style:italic;margin-bottom:0;">@displayedPhoto.Caption</p>
            }

            @* Thumbnail strip — only when > 1 photo (UI-SPEC §Surface 1 §Thumbnail strip) *@
            @if (_photos.Count > 1)
            {
                <div class="recipe-gallery-strip">
                    @for (int i = 0; i < _photos.Count; i++)
                    {
                        var photo = _photos[i];
                        var idx = i;
                        if (_failedPhotoIds.Contains(photo.Id)) continue;
                        <img src="@photo.Url"
                             alt="@($"{_doc.Name} photo {idx + 1}")"
                             referrerpolicy="no-referrer"
                             loading="lazy"
                             @onerror="@(() => { _failedPhotoIds.Add(photo.Id); StateHasChanged(); })"
                             tabindex="0"
                             role="button"
                             aria-label="@($"View {_doc.Name} photo {idx + 1}")"
                             aria-pressed="@((photo.Id == _displayedPhotoId).ToString().ToLowerInvariant())"
                             style="@(photo.Id == _displayedPhotoId ? "outline:2px solid var(--accent);outline-offset:2px;" : "")"
                             @onclick="@(() => SwapHero(photo.Id))"
                             @onkeydown="@((KeyboardEventArgs e) => { if (e.Key is "Enter" or " ") SwapHero(photo.Id); })" />
                    }
                </div>
            }
        </div>

        @* Two-column body (RV-02, RV-03) *@
        <div class="recipe-body-grid">

            @* LEFT — sticky sidebar (RV-02) *@
            <aside style="position:sticky;top:80px;align-self:start;">
                <CbEyebrow><div style="margin-bottom:10px;">Ingredients</div></CbEyebrow>

                <div style="display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--paper);border:1px solid var(--line);border-radius:10px;margin-bottom:16px;">
                    <Icon Name="@Icon.Names.Scale" Size="16" />
                    <span style="font-size:13px;color:var(--ink-3);flex:1;">Scale recipe</span>
                    <button type="button"
                            style="width:26px;height:26px;border-radius:13px;border:1px solid var(--line);background:var(--paper);cursor:pointer;color:var(--ink);"
                            @onclick="DecrementServings"
                            disabled="@(_targetServings <= 1)"
                            aria-label="Decrease servings">−</button>
                    <span class="num" style="min-width:32px;text-align:center;font-weight:600;">@_targetServings</span>
                    <button type="button"
                            style="width:26px;height:26px;border-radius:13px;border:1px solid var(--line);background:var(--paper);cursor:pointer;color:var(--ink);"
                            @onclick="IncrementServings"
                            disabled="@(_targetServings >= 100)"
                            aria-label="Increase servings">+</button>
                </div>

                @* CLEANUP-04 — per-recipe unit toggle. Default = converted (user's UnitSystem).
                   Toggle flips to original (AI-emitted) units for this recipe only.
                   localStorage key: cookbot_units_<recipeId>. *@
                <div style="margin-bottom:12px;">
                    <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                              StartIcon="@Icon.Names.Scale"
                              OnClick="ToggleUnitMode">
                        @(_unitMode == "converted" ? "Show original units" : "Show converted units")
                    </CbButton>
                </div>

                @foreach (var ing in _doc.Ingredients)
                {
                    <div style="display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);align-items:baseline;">
                        <span class="num" style="flex:0 0 64px;color:var(--ink-2);font-weight:500;font-size:14px;">@FormatQty(ing)</span>
                        <span style="flex:1;min-width:0;color:var(--ink-2);font-size:14px;line-height:1.45;word-break:break-word;">
                            @(string.IsNullOrWhiteSpace(ing.Name) ? "(unnamed)" : ing.Name)@(string.IsNullOrWhiteSpace(ing.Note) ? "" : $" ({ing.Note})")
                        </span>
                    </div>
                    @* Phase 12 — substitution sub-lines (FORMAT-01, UI-SPEC §2, D-12-04: amounts do NOT scale) *@
                    @if (ing.Substitutions.Count > 0)
                    {
                        <div style="padding:4px 0 8px 0;border-bottom:1px solid var(--line);">
                            @foreach (var sub in ing.Substitutions)
                            {
                                <div style="display:flex;align-items:baseline;gap:8px;margin-top:4px;padding-left:8px;">
                                    <span style="font-size:11px;color:var(--ink-4);flex-shrink:0;">or</span>
                                    <span style="font-size:13px;color:var(--ink-3);line-height:1.45;">
                                        @(sub.Name != null ? $"{FormatSubAmount(sub)} {sub.Name}".TrimStart() : sub.Note)
                                        @if (sub.Name != null && sub.Note != null) { <span> — @sub.Note</span> }
                                    </span>
                                </div>
                            }
                        </div>
                    }
                }

                @if (_doc.Tags.Count > 0)
                {
                    <div style="display:flex;gap:6px;margin-top:14px;flex-wrap:wrap;">
                        @foreach (var tag in _doc.Tags)
                        {
                            <CbChip Variant="CbChip.CbChipVariant.Tag" Label="@tag" />
                        }
                    </div>
                }

                @* Phase 12 — Equipment checklist (FORMAT-02, UI-SPEC §1; ephemeral state, never persisted) *@
                @if (_doc.Equipment.Count > 0)
                {
                    <CbEyebrow><div style="margin-top:16px;margin-bottom:8px;">Equipment</div></CbEyebrow>
                    <ul role="list" aria-label="Equipment list" style="list-style:none;margin:0;padding:0;">
                        @foreach (var item in _doc.Equipment)
                        {
                            var captured = item;
                            <li>
                                <label class="cb-checkbox" style="padding:10px 0;display:flex;align-items:center;gap:8px;cursor:pointer;">
                                    <input type="checkbox"
                                           checked="@_checkedEquipment.Contains(captured)"
                                           @onchange="@(() => ToggleEquipment(captured))" />
                                    <span class="box"></span>
                                    <span style="font-size:14px;color:var(--ink-2);@(_checkedEquipment.Contains(captured) ? "text-decoration:line-through;color:var(--ink-4);" : "")">@captured</span>
                                </label>
                            </li>
                        }
                    </ul>
                }
            </aside>

            @* RIGHT — Method (RV-03) *@
            <div>
                <CbEyebrow><div style="margin-bottom:18px;">Method</div></CbEyebrow>

                @{
                    var contentIndex = 0;
                }
                @foreach (var step in _doc.Steps)
                {
                    @if (step is SectionStep sectionStep)
                    {
                        <div style="padding:24px 0 8px 0;border-bottom:1px solid var(--line);">
                            <div style="font-size:18px;font-weight:600;letter-spacing:-0.015em;">@sectionStep.Heading</div>
                        </div>
                    }
                    else if (step is ContentStep content)
                    {
                        contentIndex++;
                        <div class="recipe-step-grid">
                            <div class="num" style="font-size:28px;font-weight:600;color:var(--accent);letter-spacing:-0.03em;line-height:1;">@(contentIndex.ToString("D2"))</div>
                            <div>
                                <div style="font-size:15px;line-height:1.6;color:var(--ink-2);">@StripIngredientLinks(content.Text)</div>
                                @if (content.Timers is { Count: > 0 })
                                {
                                    <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
                                        @foreach (var t in content.Timers)
                                        {
                                            <CbChip Variant="CbChip.CbChipVariant.Timer" Icon="@Icon.Names.Clock">
                                                @t.Duration @t.Unit
                                            </CbChip>
                                        }
                                    </div>
                                }
                                @* CLEANUP-04 — per-step temperature display. Renders converted when
                                   _unitMode=="converted", raw value otherwise. *@
                                @if (content.Temperature != null)
                                {
                                    var tempDisplay = _unitMode == "converted" && _unitSystem.HasValue
                                        ? UnitDisplayService.FormatTemperature(content.Temperature, _unitSystem.Value)
                                        : $"{content.Temperature.Value}°{content.Temperature.Unit}";
                                    <div style="margin-top:8px;display:inline-flex;align-items:center;gap:5px;font-size:13px;color:var(--ink-3);font-weight:500;">
                                        <Icon Name="@Icon.Names.Flame" Size="13" />
                                        @tempDisplay
                                    </div>
                                }
                                @* Phase 12 — doneness cue (FORMAT-03, UI-SPEC §3) *@
                                @if (!string.IsNullOrWhiteSpace(content.DonenessCue))
                                {
                                    <div style="margin-top:8px;display:inline-flex;align-items:center;gap:4px;
                                                font-size:13px;color:var(--ink-3);font-weight:400;font-style:italic;line-height:1.4;">
                                        <Icon Name="@Icon.Names.Check" Size="13" />
                                        @content.DonenessCue
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @* Last-cook notes (RV-04) — hidden when no notes; v1.2 has no log so always hidden today.
                   Kept as a conditional so the callout lights up automatically once a log lands. *@
                @if (!string.IsNullOrWhiteSpace(_lastCookNote))
                {
                    <div style="margin-top:28px;padding:20px;background:var(--cream-2);border-radius:12px;">
                        <CbEyebrow><div style="margin-bottom:8px;">Notes from your last cook</div></CbEyebrow>
                        <p style="font-size:14px;line-height:1.55;color:var(--ink-2);margin:0;">
                            "@_lastCookNote"@(_lastCookDate.HasValue ? $" — {_lastCookDate.Value:MMM d}" : "")
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Phase 15 / NUTR-04/05 — 5-state nutrition panel (UI-SPEC §State Machine).
           Placement: inside recipe-article, after recipe-body-grid, margin-top:48px (2xl). *@
        <section aria-label="Estimated nutrition" style="margin-top:48px;">
            <CbCard Padding="24">
                @if (_nutritionError)
                {
                    @* ── State 5: Error ──────────────────────────────────────────────── *@
                    <CbEyebrow><div style="margin-bottom:8px;">Estimated nutrition</div></CbEyebrow>
                    <div role="status" aria-live="polite"
                         style="display:flex;align-items:center;gap:8px;
                                background:var(--error-soft);border-radius:var(--t-radius-sm);
                                padding:8px 16px;margin-top:8px;font-size:14px;color:var(--error);">
                        Nutrition calculation failed — try again.
                    </div>
                    <div style="margin-top:16px;">
                        <CbButton Variant="CbButton.CbButtonVariant.Accent" OnClick="CalculateNutrition">
                            Try again
                        </CbButton>
                    </div>
                }
                else if (_nutritionCache == null || _nutritionCalculating)
                {
                    @* ── State 1 (null cache) or State 4 (calculating) ───────────────── *@
                    <CbEyebrow><div style="margin-bottom:8px;">Estimated nutrition</div></CbEyebrow>
                    <p style="font-size:14px;color:var(--ink-3);margin:0 0 12px 0;">Nutrition not yet calculated.</p>
                    <CbButton Variant="CbButton.CbButtonVariant.Accent"
                              Disabled="@_nutritionCalculating"
                              OnClick="CalculateNutrition">
                        @if (_nutritionCalculating)
                        {
                            <span class="cb-pulse">Calculating…</span>
                        }
                        else
                        {
                            <text>Calculate nutrition</text>
                        }
                    </CbButton>
                }
                else
                {
                    @* ── State 2 (IsStale=false) or State 3 (IsStale=true) ────────────── *@
                    var cache = _nutritionCache!;
                    // Per-ingredient EnergyKcal is a whole-recipe total; divide by servings when
                    // "Per serving" is active so the coverage rows track the toggle and stay
                    // consistent with the headline macros (nutrition-coverage-rows-ignore-toggle fix).
                    var servings = Math.Max(1, _doc.Servings);
                    var matches = ParsePerIngredientMatches(cache.PerIngredientMatchJson);
                    var visibleRows = _showAllMatches
                        ? matches
                        : matches.Where(m => m.Confidence == "UNMATCHED" || m.Confidence == "MEDIUM").ToList();
                    // WR-05: Use cache.MatchedIngredients as the single source of truth for
                    // the matched count (energy-bearing matches).  The previous panel-local
                    // Count(m.Confidence != "UNMATCHED") differed from the service definition
                    // (which also requires EnergyKcal.HasValue), so the toggle-button count
                    // could diverge from the headline number.  Using the cached field keeps
                    // both the "Matched N of total" headline and "Show all N matches" button
                    // consistent with what NutritionService actually counted.
                    var matchedCount = cache.MatchedIngredients;

                    @* 2a. Panel header row *@
                    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                        <CbEyebrow>Estimated nutrition</CbEyebrow>
                        @* Per-serving / Total segmented toggle *@
                        <div role="radiogroup"
                             aria-label="Nutrition display mode"
                             style="display:flex;border:1px solid var(--line-strong);border-radius:999px;padding:4px;gap:4px;"
                             @onkeydown="HandleToggleKeyDown">
                            <button role="radio"
                                    aria-checked="@(_nutritionPerServing ? "true" : "false")"
                                    class="@(_nutritionPerServing ? "cb-btn accent" : "cb-btn subtle")"
                                    style="height:32px;padding:0 16px;font-size:14px;font-weight:400;"
                                    @onclick="@(() => { _nutritionPerServing = true; StateHasChanged(); })">
                                Per serving
                            </button>
                            <button role="radio"
                                    aria-checked="@(!_nutritionPerServing ? "true" : "false")"
                                    class="@(!_nutritionPerServing ? "cb-btn accent" : "cb-btn subtle")"
                                    style="height:32px;padding:0 16px;font-size:14px;font-weight:400;"
                                    @onclick="@(() => { _nutritionPerServing = false; StateHasChanged(); })">
                                Total
                            </button>
                        </div>
                    </div>

                    @* State 3 stale banner (between header row and macro row) *@
                    @if (cache.IsStale)
                    {
                        <div role="status" aria-live="polite"
                             style="display:flex;align-items:center;gap:8px;
                                    background:var(--warn-soft);border-radius:var(--t-radius-sm);
                                    padding:8px 16px;margin-top:8px;font-size:14px;color:var(--warn);">
                            <Icon Name="@Icon.Names.Clock" Size="14" />
                            Recipe has changed — values may be outdated.
                            <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                                      style="margin-left:auto;"
                                      OnClick="CalculateNutrition">
                                Recalculate nutrition
                            </CbButton>
                        </div>
                    }

                    @* 2b. Macro stat row (4-up grid; collapses to 2-col at <=720px via the
                       .nutrition-macro-grid class — the columns MUST live in CSS, not inline,
                       so the media query can actually override them. nutrition-macro-grid-not-responsive fix. *@
                    <div class="nutrition-macro-grid" style="margin-top:16px;@(cache.IsStale ? "opacity:0.7;" : "")">
                        @{
                            double energy  = _nutritionPerServing ? cache.PerServingEnergyKcal : cache.TotalEnergyKcal;
                            double protein = _nutritionPerServing ? cache.PerServingProteinG    : cache.TotalProteinG;
                            double carbs   = _nutritionPerServing ? cache.PerServingCarbG       : cache.TotalCarbG;
                            double fat     = _nutritionPerServing ? cache.PerServingFatG        : cache.TotalFatG;
                        }
                        <div>
                            <div class="num" style="font-size:28px;font-weight:600;color:var(--accent);">@energy.ToString("0")</div>
                            <div style="font-size:12.5px;color:var(--ink-3);font-weight:400;">kcal · Energy</div>
                        </div>
                        <div>
                            <div class="num" style="font-size:28px;font-weight:600;color:var(--accent);">@protein.ToString("0.#")</div>
                            <div style="font-size:12.5px;color:var(--ink-3);font-weight:400;">g · Protein</div>
                        </div>
                        <div>
                            <div class="num" style="font-size:28px;font-weight:600;color:var(--accent);">@carbs.ToString("0.#")</div>
                            <div style="font-size:12.5px;color:var(--ink-3);font-weight:400;">g · Carbs</div>
                        </div>
                        <div>
                            <div class="num" style="font-size:28px;font-weight:600;color:var(--accent);">@fat.ToString("0.#")</div>
                            <div style="font-size:12.5px;color:var(--ink-3);font-weight:400;">g · Fat</div>
                        </div>
                    </div>

                    @* 2c. Horizontal rule *@
                    <hr class="cb-rule" style="margin:16px 0;" />

                    @* 2d. Coverage summary *@
                    <div style="font-size:12.5px;color:var(--ink-3);margin-bottom:16px;">
                        Matched @cache.MatchedIngredients of @cache.TotalIngredients ingredients
                    </div>

                    @* 2e. Coverage list *@
                    @foreach (var row in visibleRows)
                    {
                        <div style="display:flex;align-items:baseline;gap:8px;padding:8px 0;border-bottom:1px solid var(--line);">
                            @if (row.Confidence == "HIGH")
                            {
                                <span class="cb-chip cb-badge cb-badge-in-stock" style="flex-shrink:0;">HIGH</span>
                            }
                            else if (row.Confidence == "MEDIUM")
                            {
                                <span class="cb-chip cb-badge cb-badge-low" style="flex-shrink:0;">≈</span>
                            }
                            else
                            {
                                <span class="cb-chip cb-badge cb-badge-out" style="flex-shrink:0;">—</span>
                            }
                            <div style="flex:1;min-width:0;">
                                <div style="font-size:14px;color:var(--ink-2);">@row.Name</div>
                                @if (row.Confidence != "UNMATCHED" && row.CnfFoodDescription != null)
                                {
                                    <div style="font-size:12.5px;color:var(--ink-4);">@row.CnfFoodDescription [@row.CnfFoodId]</div>
                                }
                            </div>
                            <div class="num" style="font-size:14px;color:@(row.Confidence == "UNMATCHED" ? "var(--ink-4)" : "var(--ink-2)");">
                                @if (row.Confidence == "UNMATCHED")
                                {
                                    <text>--</text>
                                }
                                else if (row.Confidence == "MEDIUM")
                                {
                                    <text>≈@(row.EnergyKcal.HasValue ? (_nutritionPerServing ? row.EnergyKcal.Value / servings : row.EnergyKcal.Value).ToString("0") : "--")</text>
                                }
                                else
                                {
                                    <text>@(row.EnergyKcal.HasValue ? (_nutritionPerServing ? row.EnergyKcal.Value / servings : row.EnergyKcal.Value).ToString("0") : "--")</text>
                                }
                            </div>
                        </div>
                    }
                    @if (matchedCount > 0)
                    {
                        <div style="margin-top:8px;">
                            <button class="cb-btn ghost"
                                    style="font-size:12.5px;"
                                    @onclick="@(() => { _showAllMatches = !_showAllMatches; StateHasChanged(); })">
                                @if (_showAllMatches)
                                {
                                    <text>Hide matched</text>
                                }
                                else
                                {
                                    <text>Show all @matchedCount matches</text>
                                }
                            </button>
                        </div>
                    }
                }

                @* ── Nutrition disclaimer — always visible in ALL states, never conditional ──────── *@
                <div role="note"
                     aria-label="Nutrition data notice"
                     style="font-size:12.5px;color:var(--ink-3);line-height:1.4;margin-top:16px;">
                    Estimated nutrition — not suitable for medical dietary planning. Data: Health Canada, Canadian Nutrient File (2015).
                </div>
            </CbCard>
        </section>

    </article>
}
else if (_loaded && _recipe != null && _doc == null)
{
    <div style="max-width:720px;margin:48px auto;padding:0 32px;">
        <CbCard Padding="28">
            <CbEyebrow><div style="margin-bottom:6px;">Recipe needs migration</div></CbEyebrow>
            <p style="font-size:15px;line-height:1.5;color:var(--ink-2);">
                This recipe was saved before the canonical format landed. Open it in the editor and save once
                to migrate the document.
            </p>
            <div style="margin-top:14px;">
                <CbButton Variant="CbButton.CbButtonVariant.Primary" StartIcon="@Icon.Names.Pencil"
                          OnClick="@(() => Navigation.NavigateTo($"/recipes/{RecipeId}/edit"))">Open in editor</CbButton>
            </div>
        </CbCard>
    </div>
}
else if (_loaded)
{
    <div style="max-width:720px;margin:48px auto;padding:0 32px;font-size:15px;color:var(--ink-2);">
        Recipe not found or you do not have access.
    </div>
}
</UserGuard>

@code {
    [Parameter] public int RecipeId { get; set; }

    // Phase 10 / Plan 10-09 / POLISH-04 / W-02 — RenderFragment fed to TopBar.RightSlot.
    // Constructed once in OnInitialized using the Razor @<text> markup-template form (W-02
    // committed shape). The same fragment also renders in the inline fallback below 720px.
    private RenderFragment? _topBarActions;

    protected override void OnInitialized()
    {
        // W-02: @<text> markup-template construction — identical shape in RecipeView + RecipeEditor.
        _topBarActions = @<text>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Pencil" OnClick="EditRecipe">Edit</CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Share" OnClick="OpenShareDialog">Share</CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Clock" OnClick="OpenScheduleDialog">Schedule</CbButton>
            @* INTEROP-03/04 — Cooklang one-way export. "Export only · one-way" title conveys
               no re-import path exists (INTEROP-04 SC3). Download via existing cookBotDownloadFile JS helper. *@
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Download"
                      OnClick="ExportCooklang"
                      title="Export only · one-way (no re-import)">Export as .cook</CbButton>
            @* Compares the recipe against your pantry and starts a shopping list of what you're missing
               (GroceryListService.GenerateFromRecipeAsync via the /grocery-lists/from-recipe route). *@
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Cart"
                      OnClick="@(() => Navigation.NavigateTo($"/grocery-lists/from-recipe/{RecipeId}"))"
                      title="Compare against your pantry and add what's missing to a grocery list">What do I need?</CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Flame" OnClick="StartCooking">Cook this</CbButton>
        </text>;
        // D-57 (revised by 999.1): SetRightSlot stamps the current URL; CbTopBarService's
        // LocationChanged handler keeps the slot when the destination URL matches the stamp.
        TopBarService.SetRightSlot(_topBarActions);
    }

    // Phase 10 / Plan 10-09 / POLISH-04 — IDisposable required by @implements directive.
    // D-57: service auto-clears on navigation; Dispose is a no-op here but satisfies the contract.
    public void Dispose() { }

    private CookBot.Domain.Entities.Recipe? _recipe;
    private RecipeDocument? _doc;
    // INTEROP-01 — prerender JSON-LD projection; populated in OnParametersSetAsync
    // (prerender-safe, no JS interop). Null when the recipe id does not exist or
    // deserialization fails.
    private string? _jsonLd;
    private bool _loaded;
    private int _targetServings = 1;

    // Phase 12 — provenance link safety (D-12-08). Computed in OnParametersSet via UrlValidator.
    // Null means the SourceUrl is absent, empty, or fails the http/https allowlist.
    private string? _validatedSourceUrl;

    // Phase 12 — equipment checklist ephemeral state (UI-SPEC §1; never persisted, resets on navigation).
    private readonly HashSet<string> _checkedEquipment = new();

    // CLEANUP-04 — unit display mode. Default = "converted" (user's UnitSystem).
    // Per-recipe toggle writes cookbot_units_<recipeId> to localStorage.
    private UnitSystem? _unitSystem;
    private string _unitMode = "converted";

    // Last-cook callout state — populated from the RecipeMade log entity (Plan 07-09 Feature 2).
    // The conditional in markup hides the callout when there are no logged cooks for this user.
    private string? _lastCookNote;
    private DateTime? _lastCookDate;
    // Made-count surfaces the per-user cook log; 0 reads as "0×" in the hero stat row.
    private int _madeCount;

    private bool _initialized;
    private int _boundRecipeId;

    // PHOTO-10 / PITFALL H4 — one-shot photo-load-failure flag. Once an <img> @onerror
    // fires we set this to true and re-render with the StripedPlaceholder fallback;
    // the browser cannot keep retrying because the DOM element is no longer an <img>.
    // Reset alongside _recipe / _doc when the bound RecipeId changes.
    private bool _heroPhotoFailed;

    // Phase 14 / Plan 14-04 / GALLERY-03 — multi-photo gallery state.
    // _photos: ordered list loaded via RecipePhotoService.GetPhotosAsync.
    // _displayedPhotoId: ephemeral client-side swap state (NEVER mutates IsPrimary / canonical — P15).
    // _failedPhotoIds: one-shot per-photo error tracking; replaces the single _heroPhotoFailed for gallery imgs.
    private List<RecipePhoto> _photos = new();
    private int _displayedPhotoId;
    private readonly HashSet<int> _failedPhotoIds = new();

    // Phase 15 / NUTR-04 — nutrition panel state (5-state machine, UI-SPEC).
    // _nutritionCache: null = not yet calculated; non-null = calculated (may be stale).
    // _nutritionCalculating: State 4 (in-progress). _nutritionError: State 5 (error).
    // _showAllMatches: toggles the coverage list between unmatched+low-confidence only and all rows.
    // _nutritionPerServing: true = per-serving (default, D-15-15); false = total values.
    private RecipeNutritionCache? _nutritionCache;
    private bool _nutritionCalculating;
    private bool _nutritionError;
    private bool _showAllMatches;
    private bool _nutritionPerServing = true;

    private string TotalTimeText
    {
        get
        {
            var prep = _doc?.PrepTimeMinutes ?? 0;
            var cook = _doc?.CookTimeMinutes ?? 0;
            var total = prep + cook;
            return total > 0 ? total.ToString() : "—";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (_boundRecipeId != RecipeId)
        {
            _boundRecipeId = RecipeId;
            _initialized = false;
            _recipe = null;
            _doc = null;
            _jsonLd = null;
            _loaded = false;
            _targetServings = 1;
            // PHOTO-10 / PITFALL H4 — reset the photo-failure flag for the new recipe so
            // its hero gets a fresh chance to load even if the previous recipe had a broken URL.
            _heroPhotoFailed = false;
            // Phase 14 / Plan 14-04 — reset gallery state for the new recipe.
            _photos = new();
            _displayedPhotoId = 0;
            _failedPhotoIds.Clear();
            // CLEANUP-04 — reset unit mode for new recipe so localStorage re-read picks it up.
            _unitMode = "converted";
            // Phase 12 — reset provenance URL and equipment state for the new recipe.
            _validatedSourceUrl = null;
            _checkedEquipment.Clear();
            // Phase 15 — reset nutrition panel state for the new recipe.
            _nutritionCache = null;
            _nutritionCalculating = false;
            _nutritionError = false;
            _showAllMatches = false;
            _nutritionPerServing = true;

            // INTEROP-01 — prerender-safe DB read + JSON-LD projection.
            // This runs in OnParametersSetAsync (no JS interop) so the JSON-LD block
            // is available in the INITIAL HTTP response (prerender pass).
            //
            // Trusted-LAN prerender posture: at prerender time, CurrentUserService.CurrentUserId
            // resolves to the default "Home Chef"/first user (MainLayout only restores the real
            // user from sessionStorage in OnAfterRenderAsync). A per-user UserCanAccessRecipeAsync
            // check here would authorize as the WRONG user and is meaningless under the current
            // trusted-LAN posture (CLAUDE.md: "AuthMode flag reserved for future use").
            // Therefore the prerender JSON-LD load is NOT gated on UserCanAccessRecipeAsync.
            // TODO(AuthMode): gate prerendered JSON-LD per-user once server-side auth lands.
            await LoadRecipeDocumentForPrerenderAsync();
        }
    }

    /// <summary>
    /// Prerender-safe DB read: loads the canonical RecipeDocument for JSON-LD projection.
    /// Only EF Core reads — no JS interop. Called from OnParametersSetAsync so the JSON-LD
    /// block is in the INITIAL HTTP response (INTEROP-01 gating fix).
    /// Does NOT gate on UserCanAccessRecipeAsync (trusted-LAN posture; see TODO(AuthMode)).
    /// </summary>
    private async Task LoadRecipeDocumentForPrerenderAsync()
    {
        try
        {
            var entity = await DbContext.Recipes
                .Include(r => r.Cookbook)
                .FirstOrDefaultAsync(r => r.Id == RecipeId);

            if (entity is not { CanonicalDocumentJson: { Length: > 0 } json })
                return;

            RecipeDocument? doc;
            try
            {
                doc = RecipeSerializer.Deserialize(json);
            }
            catch (JsonException)
            {
                return; // malformed canonical JSON — no JSON-LD
            }

            if (doc is null) return;

            // INTEROP-02 — resolve the absolute-HTTPS image URL at the Web layer.
            // Only an absolute https:// URL is accepted; relative/http/local → null (image omitted).
            string? absoluteImageUrl = null;
            if (!string.IsNullOrWhiteSpace(doc.PhotoUrl))
            {
                if (UrlValidator.TryValidate(doc.PhotoUrl, out var normalized, out _) && normalized != null)
                {
                    // Accept only absolute https URLs; http or relative → omit (D4 / §Pattern 4).
                    if (normalized.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                        absoluteImageUrl = normalized;
                }
                else
                {
                    // Try composing with BaseUri when PhotoUrl is relative.
                    try
                    {
                        var baseUri = new Uri(Navigation.BaseUri);
                        if (baseUri.Scheme == "https")
                        {
                            var composed = new Uri(baseUri, doc.PhotoUrl);
                            if (composed.Scheme == "https")
                                absoluteImageUrl = composed.AbsoluteUri;
                        }
                    }
                    catch (UriFormatException) { /* invalid relative path — omit */ }
                }
            }

            // Phase 15 / NUTR-06 / SC5 — at prerender time, _nutritionCache is always null
            // (the interactive circuit hasn't run yet). The interactive path rebuilds _jsonLd
            // with nutrition once the cache is loaded. Pass null here so the prerender JSON-LD
            // omits nutrition (correct: no nutrition has been computed yet at this point).
            _jsonLd = JsonLdRecipeProjector.Project(doc, absoluteImageUrl, nutrition: null);
        }
        catch (Exception)
        {
            // Best-effort: if the prerender load fails for any reason, _jsonLd stays null.
            // The interactive OnAfterRenderAsync path will populate _doc and _recipe normally.
            _jsonLd = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UserService.CurrentUserId.HasValue) return;
        var userId = UserService.CurrentUserId.Value;

        if (!_initialized)
        {
            _initialized = true;

            if (!await DbContext.UserCanAccessRecipeAsync(RecipeId, userId))
            {
                _recipe = null;
                _doc = null;
            }
            else
            {
                // Load the entity so we can resolve canonical doc + cookbook id for share/cook nav.
                // Note: we DO NOT read legacy columns (IngredientsJson / StepsJson / TagsJson dropped) /
                // RecipeIngredients / Steps for rendering — only Recipe.CanonicalDocumentJson is consumed.
                _recipe = await DbContext.Recipes
                    .Include(r => r.Cookbook)
                    .FirstOrDefaultAsync(r => r.Id == RecipeId);

                if (_recipe is { CanonicalDocumentJson: { Length: > 0 } json })
                {
                    try
                    {
                        _doc = RecipeSerializer.Deserialize(json);
                        _targetServings = _doc.Servings > 0 ? _doc.Servings : 1;

                        // Phase 12 — compute validated provenance source URL for link safety (D-12-08).
                        // UrlValidator returns true + normalized URL only when the scheme is http/https.
                        // Anything else (javascript:, data:, malformed) → _validatedSourceUrl stays null
                        // and the provenance credit renders as plain text.
                        // WR-02: mirror the credit-block display guard (line 71) so we only validate
                        // the URL when the <a> element will actually render (AuthorName or SourceName present).
                        var prov12 = _doc.Provenance;
                        if (prov12 is { } p12 &&
                            (p12.AuthorName != null || p12.SourceName != null) &&
                            !string.IsNullOrWhiteSpace(p12.SourceUrl) &&
                            UrlValidator.TryValidate(p12.SourceUrl, out var normalized, out _) &&
                            normalized != null)
                        {
                            _validatedSourceUrl = normalized;
                        }
                        else
                        {
                            _validatedSourceUrl = null;
                        }
                    }
                    catch (JsonException)
                    {
                        // Malformed canonical JSON — fall through to the migration prompt.
                        _doc = null;
                    }
                }

                // Phase 14 / Plan 14-04 / GALLERY-03 — load ordered photo gallery.
                // GetPhotosAsync enforces ownership; result is ordered by SortOrder.
                try
                {
                    var photos = await RecipePhotoSvc.GetPhotosAsync(RecipeId, userId);
                    _photos = photos.ToList();
                    // Default displayed photo = primary (IsPrimary=true), else first.
                    var primary = _photos.FirstOrDefault(p => p.IsPrimary) ?? _photos.FirstOrDefault();
                    _displayedPhotoId = primary?.Id ?? 0;
                }
                catch
                {
                    // Non-fatal — gallery falls back to _doc.PhotoUrl hero (canonical mirror, D-14-01)
                    _photos = new();
                    _displayedPhotoId = 0;
                }

                // Plan 07-09 Feature 2 — surface real RecipeMade data (count + last-cook callout).
                _madeCount = await RecipeMadeService.GetMadeCountAsync(RecipeId, userId);
                var lastCook = await RecipeMadeService.GetLastCookAsync(RecipeId, userId);
                if (lastCook != null)
                {
                    _lastCookNote = string.IsNullOrWhiteSpace(lastCook.Notes) ? null : lastCook.Notes;
                    _lastCookDate = lastCook.CompletedAt;
                }

                // CLEANUP-04 — load the user's UnitSystem for display-time conversion.
                var profile = await DbContext.UserProfiles.FirstOrDefaultAsync(p => p.UserId == userId);
                if (profile != null)
                    _unitSystem = profile.UnitSystem;

                // Phase 15 / NUTR-04 — load existing nutrition cache (best-effort; never blocks the page).
                // On load we only READ the cache (null = not yet calculated, non-null = computed/stale).
                // We NEVER call ComputeAsync on load — only on explicit CTA click (SC1/P7).
                try
                {
                    _nutritionCache = await NutritionSvc.GetCacheAsync(RecipeId, userId);
                }
                catch
                {
                    _nutritionCache = null; // best-effort — nutrition unavailable, panel shows State 1
                }

                // Phase 15 / NUTR-06 / SC5 — rebuild JSON-LD with nutrition when a current cache exists.
                // The prerender path produced _jsonLd without nutrition; now that we have the cache,
                // rebuild it with per-serving NutritionInfoDto if the cache is current (IsStale=false).
                if (_doc != null)
                {
                    try
                    {
                        NutritionInfoDto? nutritionDto = _nutritionCache is { IsStale: false }
                            ? new NutritionInfoDto(
                                _nutritionCache.PerServingEnergyKcal,
                                _nutritionCache.PerServingProteinG,
                                _nutritionCache.PerServingFatG,
                                _nutritionCache.PerServingCarbG)
                            : null;

                        // Resolve absoluteImageUrl (same logic as LoadRecipeDocumentForPrerenderAsync).
                        string? absoluteImageUrlForLd = null;
                        if (!string.IsNullOrWhiteSpace(_doc.PhotoUrl))
                        {
                            if (UrlValidator.TryValidate(_doc.PhotoUrl, out var normUrl, out _) && normUrl != null &&
                                normUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                            {
                                absoluteImageUrlForLd = normUrl;
                            }
                            else
                            {
                                try
                                {
                                    var baseUri = new Uri(Navigation.BaseUri);
                                    if (baseUri.Scheme == "https")
                                    {
                                        var composed = new Uri(baseUri, _doc.PhotoUrl);
                                        if (composed.Scheme == "https")
                                            absoluteImageUrlForLd = composed.AbsoluteUri;
                                    }
                                }
                                catch (UriFormatException) { /* invalid relative path — omit */ }
                            }
                        }

                        _jsonLd = JsonLdRecipeProjector.Project(_doc, absoluteImageUrlForLd, nutritionDto);
                    }
                    catch
                    {
                        // Best-effort — keep existing _jsonLd if rebuild fails.
                    }
                }
            }

            _loaded = true;

            // CLEANUP-04 — read per-recipe unit-mode from localStorage (prerender-safe).
            // Done after _loaded so the component has rendered at least once. Default = "converted".
            try
            {
                var stored = await JS.InvokeAsync<string?>("localStorage.getItem", $"cookbot_units_{RecipeId}");
                if (stored == "original" || stored == "converted")
                    _unitMode = stored;
            }
            catch (InvalidOperationException) { /* prerender — JS interop unavailable */ }

            StateHasChanged();
        }
    }

    private void IncrementServings()
    {
        if (_targetServings < 100) _targetServings++;
    }

    private void DecrementServings()
    {
        if (_targetServings > 1) _targetServings--;
    }

    private string FormatQty(IngredientEntry ing)
    {
        if (ing.Amount <= 0) return string.IsNullOrWhiteSpace(ing.Unit) ? "—" : ing.Unit;
        var origServings = _doc?.Servings > 0 ? _doc.Servings : 1;

        // CLEANUP-04: SCALE-THEN-FORMAT ORDER.
        // In the converted path: scale first (returns a raw double), then pass to
        // FormatIngredientAmount so FractionFormatter runs EXACTLY ONCE inside the converter.
        // In the original path: keep the existing FormatScaledAmount path (scales + formats).
        if (_unitMode == "converted" && _unitSystem.HasValue && !string.IsNullOrWhiteSpace(ing.Unit))
        {
            var scaled = RecipeScalingService.ScaleAmount(ing.Amount, origServings, _targetServings);
            return UnitDisplayService.FormatIngredientAmount(scaled, ing.Unit, _unitSystem.Value);
        }

        var formatted = RecipeScalingService.FormatScaledAmount(ing.Amount, origServings, _targetServings);
        var unitDisplay = string.IsNullOrWhiteSpace(ing.Unit) ? "" : $" {UnitParser.ToDisplayString(ing.Unit)}";
        return $"{formatted}{unitDisplay}";
    }

    // CLEANUP-04 — per-recipe unit toggle. Flips between "converted" and "original".
    // Writes cookbot_units_<recipeId> to localStorage (prerender-safe).
    private async Task ToggleUnitMode()
    {
        _unitMode = _unitMode == "converted" ? "original" : "converted";
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", $"cookbot_units_{RecipeId}", _unitMode);
        }
        catch (InvalidOperationException) { /* prerender */ }
    }

    private static string StripIngredientLinks(string text)
        => CookBot.Application.Services.RecipeStepTextFormatter.ToPlainText(text);

    private async Task OpenShareDialog()
    {
        // Sharing is cookbook-scoped (CookbookShares). ShareCookbookDialog opens via
        // CbDialogService (migrated in Phase 7 / Plan 07-01).
        if (_recipe?.Cookbook == null) return;
        var parameters = new CbDialogParameters
        {
            ["CookbookId"] = _recipe.CookbookId,
            ["CookbookName"] = _recipe.Cookbook.Name,
        };
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Sm, FullWidth: true, CloseOnEscape: true);
        await CbDialogService.ShowAsync<ShareCookbookDialog>("Share & export — \"" + _recipe.Cookbook.Name + "\"", parameters, options);
    }

    private void StartCooking()
    {
        Navigation.NavigateTo($"/recipes/{RecipeId}/cook");
    }

    private void EditRecipe()
    {
        Navigation.NavigateTo($"/recipes/{RecipeId}/edit");
    }

    /// <summary>
    /// PHOTO-10 / PITFALL H4 — Blazor-side one-shot debounce for a broken hero photo URL.
    /// Setting _heroPhotoFailed and calling StateHasChanged causes the @if branch in markup
    /// to flip to StripedPlaceholder, removing the <img> element entirely; the browser cannot
    /// re-fire onerror because the element is gone.
    /// </summary>
    private void HandleHeroPhotoError()
    {
        _heroPhotoFailed = true;
        StateHasChanged();
    }

    /// <summary>
    /// Phase 14 / Plan 14-04 / GALLERY-03 / D-14 — client-side-only hero swap.
    /// Sets _displayedPhotoId to the clicked thumbnail's photo ID.
    /// This is EPHEMERAL display state ONLY — it does NOT call any service, does NOT
    /// change IsPrimary, and does NOT mutate canonical data (P15).
    /// </summary>
    private void SwapHero(int photoId)
    {
        _displayedPhotoId = photoId;
        StateHasChanged();
    }

    private async Task OpenScheduleDialog()
    {
        // Plan 07-09 Feature 1 — opens the ScheduleRecipeDialog via CbDialogService.
        if (_recipe == null) return;
        var parameters = new CbDialogParameters
        {
            ["RecipeId"] = _recipe.Id,
            ["RecipeName"] = _doc?.Name ?? _recipe.Name,
        };
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Sm, FullWidth: true, CloseOnEscape: true);
        await CbDialogService.ShowAsync<CookBot.Web.Components.Dialogs.ScheduleRecipeDialog>(
            $"Schedule \"{_doc?.Name ?? _recipe.Name}\"", parameters, options);
    }

    // INTEROP-03/04 — Cooklang one-way export.
    // Projects _doc via CooklangRecipeProjector and downloads via the existing cookBotDownloadFile
    // JS blob helper. No new endpoint, no new JS. "Export only · one-way" — no re-import path.
    private async Task ExportCooklang()
    {
        if (_doc is null) return;
        var cook = CooklangRecipeProjector.Project(_doc);
        var bytes = System.Text.Encoding.UTF8.GetBytes(cook);
        var stem = CookbookDownloadHelper.SafeFileStem(_doc.Name);
        await JS.InvokeVoidAsync("cookBotDownloadFile", $"{stem}.cook", "text/plain",
            Convert.ToBase64String(bytes));
    }

    // Phase 12 — Equipment checklist toggle (UI-SPEC §1; ephemeral, never persisted).
    private void ToggleEquipment(string item)
    {
        if (!_checkedEquipment.Add(item))
            _checkedEquipment.Remove(item);
    }

    // Phase 12 — Provenance credit composition (UI-SPEC §4 copy contract).
    private static string BuildProvenanceCredit(CookBot.Domain.Recipes.RecipeProvenance prov)
    {
        if (prov.SourceName != null && prov.AuthorName != null)
            return $"Adapted from {prov.SourceName} by {prov.AuthorName}";
        if (prov.SourceName != null)
            return $"Adapted from {prov.SourceName}";
        if (prov.AuthorName != null)
            return $"By {prov.AuthorName}";
        return string.Empty;
    }

    // Phase 12 — Substitution amount formatter (UI-SPEC §2; D-12-04: static display, NO servings scale).
    private static string FormatSubAmount(CookBot.Domain.Recipes.IngredientSubstitution sub)
    {
        if (sub.Amount != null && sub.Unit != null)
            return $"{sub.Amount} {sub.Unit}";
        if (sub.Amount != null)
            return $"{sub.Amount}";
        return string.Empty;
    }

    // ── Phase 15 / NUTR-04 — Nutrition panel methods ────────────────────────────────

    /// <summary>
    /// CTA handler — the ONLY compute trigger (SC1/P7).
    /// Transitions to State 4 (calculating), calls ComputeAsync, then to State 2 or 5.
    /// Never triggered on load or save.
    /// </summary>
    private async Task CalculateNutrition()
    {
        if (!UserService.CurrentUserId.HasValue) return;
        var userId = UserService.CurrentUserId.Value;

        _nutritionCalculating = true;
        _nutritionError = false;
        StateHasChanged();

        try
        {
            _nutritionCache = await NutritionSvc.ComputeAsync(RecipeId, userId);

            // Phase 15 / NUTR-06 / SC5 — rebuild JSON-LD with fresh per-serving nutrition.
            if (_doc != null)
            {
                try
                {
                    var nutritionDto = new NutritionInfoDto(
                        _nutritionCache.PerServingEnergyKcal,
                        _nutritionCache.PerServingProteinG,
                        _nutritionCache.PerServingFatG,
                        _nutritionCache.PerServingCarbG);

                    string? absoluteImageUrlForLd = null;
                    if (!string.IsNullOrWhiteSpace(_doc.PhotoUrl))
                    {
                        if (UrlValidator.TryValidate(_doc.PhotoUrl, out var normUrl, out _) && normUrl != null &&
                            normUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                        {
                            absoluteImageUrlForLd = normUrl;
                        }
                        else
                        {
                            try
                            {
                                var baseUri = new Uri(Navigation.BaseUri);
                                if (baseUri.Scheme == "https")
                                {
                                    var composed = new Uri(baseUri, _doc.PhotoUrl);
                                    if (composed.Scheme == "https")
                                        absoluteImageUrlForLd = composed.AbsoluteUri;
                                }
                            }
                            catch (UriFormatException) { /* invalid relative path — omit */ }
                        }
                    }

                    _jsonLd = JsonLdRecipeProjector.Project(_doc, absoluteImageUrlForLd, nutritionDto);
                }
                catch
                {
                    // Best-effort — keep existing _jsonLd if rebuild fails.
                }
            }
        }
        catch
        {
            _nutritionError = true;
        }
        finally
        {
            _nutritionCalculating = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Parses the PerIngredientMatchJson blob from RecipeNutritionCache into a typed list
    /// for rendering the coverage list. Returns empty list on parse failure (best-effort).
    /// </summary>
    private static List<PerIngredientDisplayRow> ParsePerIngredientMatches(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            return JsonSerializer.Deserialize<List<PerIngredientDisplayRow>>(json, options) ?? [];
        }
        catch
        {
            return [];
        }
    }

    /// <summary>
    /// Keyboard navigation for the per-serving / total segmented toggle (role="radiogroup").
    /// Arrow keys move between the two options per ARIA pattern.
    /// </summary>
    private void HandleToggleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowUp" or "ArrowRight" or "ArrowDown")
        {
            _nutritionPerServing = !_nutritionPerServing;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Typed view model for rendering one row in the coverage list.
    /// Maps the per-ingredient JSON schema produced by NutritionService.
    /// </summary>
    private sealed class PerIngredientDisplayRow
    {
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("cnfFoodId")]
        public int? CnfFoodId { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("cnfFoodDescription")]
        public string? CnfFoodDescription { get; set; }

        [System.Text.Json.Serialization.JsonPropertyName("confidence")]
        public string Confidence { get; set; } = string.Empty;

        [System.Text.Json.Serialization.JsonPropertyName("energyKcal")]
        public double? EnergyKcal { get; set; }
    }
}
