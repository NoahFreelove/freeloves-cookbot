@inject CurrentUserService UserService
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookBot.Application.Services.PantryService PantryService
@inject ICbToastService Toast

@* Phase 7 / Plan 07-02: "Manage members" dialog migrated to CbDialog slots.
   Renders inside CbDialogHost; Title is supplied at ShowAsync call. *@

<div>
    @if (_members.Any())
    {
        <div style="font-size:11.5px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px;">
            Current members
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px;">
            @foreach (var member in _members)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;background:var(--cream-2);border-radius:8px;">
                    <Icon Name="@Icon.Names.User" Size="14" />
                    <span style="flex:1;font-size:13.5px;color:var(--ink-2);">@member.User.DisplayName</span>
                    <button type="button"
                            class="cb-btn ghost"
                            style="padding:4px 8px;font-size:12px;"
                            aria-label="@($"Remove {member.User.DisplayName}")"
                            @onclick="@(() => RemoveMember(member))">
                        <Icon Name="@Icon.Names.Trash" Size="13" />
                    </button>
                </div>
            }
        </div>
        <div style="height:1px;background:var(--line);margin:0 0 16px 0;"></div>
    }

    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
        <span>Add member</span>
        <CbSelect TValue="int" @bind-Value="_selectedUserId" Disabled="@(!_availableUsers.Any())"
                  Placeholder="@(_availableUsers.Any() ? null : "No users available")">
            @foreach (var user in _availableUsers)
            {
                <CbOption TValue="int" Value="@user.Id" Label="@user.DisplayName" />
            }
        </CbSelect>
    </label>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Close">Close</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="AddMember"
                  Disabled="@(_selectedUserId == 0)">Add</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public int PantryId { get; set; }
    [Parameter] public string PantryName { get; set; } = "";
    [Parameter] public int OwnerUserId { get; set; }

    private List<PantryMember> _members = new();
    private List<User> _availableUsers = new();
    private int _selectedUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadMembers();
    }

    private async Task LoadMembers()
    {
        _members = await DbContext.PantryMembers
            .Include(pm => pm.User)
            .Where(pm => pm.PantryId == PantryId)
            .ToListAsync();

        var memberUserIds = _members.Select(m => m.UserId).ToHashSet();
        memberUserIds.Add(OwnerUserId);

        _availableUsers = await DbContext.Users
            .Where(u => !memberUserIds.Contains(u.Id))
            .OrderBy(u => u.DisplayName)
            .ToListAsync();

        _selectedUserId = _availableUsers.FirstOrDefault()?.Id ?? 0;
    }

    private async Task AddMember()
    {
        if (_selectedUserId == 0) return;

        await PantryService.AddMemberAsync(PantryId, _selectedUserId);
        Toast.Show("Member added!", CbToastSeverity.Success);
        await LoadMembers();
        StateHasChanged();
    }

    private async Task RemoveMember(PantryMember member)
    {
        await PantryService.RemoveMemberAsync(PantryId, member.UserId);
        Toast.Show("Member removed.", CbToastSeverity.Info);
        await LoadMembers();
        StateHasChanged();
    }

    private void Close() => DialogInstance?.Close(CbDialogResult.Ok(true));
}
