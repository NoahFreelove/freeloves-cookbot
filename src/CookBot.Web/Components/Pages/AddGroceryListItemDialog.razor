@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@using CookBot.Application.Services

@* Phase 7 / Plan 07-03: grocery list "Add item" dialog using CbDialog slots.
   Renders inside CbDialogHost; Title is supplied at ShowAsync call.
   Ingredient picker is a CbSelect over the loaded ingredient list plus a CbInput
   "or add new ingredient" name field (matches Plan 07-02 pantry AddPantryItemDialog
   pattern — no Cb autocomplete atom yet). Amount uses CbInput type="number" with
   culture-invariant double parsing. Unit picker uses CbSelect over CommonUnits. *@

<div>
    <div style="display:flex;flex-direction:column;gap:14px;">
        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Ingredient</span>
            <CbSelect TValue="int?" @bind-Value="_selectedIngredientId" Placeholder="Select an existing ingredient…">
                @foreach (var ing in Ingredients)
                {
                    <CbOption TValue="int?" Value="@(ing.Id)" Label="@ing.Name" />
                }
            </CbSelect>
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Or add new ingredient</span>
            <CbInput @bind-Value="_newIngredientName" Placeholder="Leave blank to use selection above" />
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Amount</span>
            <CbInput Type="number" @bind-Value="_amountText" Placeholder="1" />
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Unit</span>
            <CbSelect TValue="string" @bind-Value="_unit">
                @foreach (var u in CommonUnits)
                {
                    <CbOption TValue="string" Value="@u" Label="@u" />
                }
            </CbSelect>
        </label>
    </div>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Submit"
                  Disabled="@(!CanSubmit)">Add</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public List<Ingredient> Ingredients { get; set; } = new();

    private int? _selectedIngredientId;
    private string _newIngredientName = "";
    private string _amountText = "1";
    private string _unit = "piece";

    private static readonly string[] CommonUnits = new[]
    {
        "tsp", "tbsp", "fl oz", "cup", "pint", "quart", "gallon",
        "ml", "liter", "oz", "lb", "g", "kg", "pinch", "dash",
        "piece", "slice", "clove", "bunch", "can", "bottle", "bag"
    };

    private bool HasAmount =>
        !string.IsNullOrWhiteSpace(_amountText) &&
        double.TryParse(_amountText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) &&
        v > 0;

    private bool CanSubmit =>
        (_selectedIngredientId.HasValue || !string.IsNullOrWhiteSpace(_newIngredientName))
        && HasAmount;

    private void Cancel() => DialogInstance?.Cancel();

    private async Task Submit()
    {
        int ingredientId;
        if (!string.IsNullOrWhiteSpace(_newIngredientName))
        {
            var normalized = IngredientResolver.Normalize(_newIngredientName);
            var existing = await DbContext.Ingredients.FirstOrDefaultAsync(i => i.NormalizedName == normalized);
            if (existing != null)
            {
                ingredientId = existing.Id;
            }
            else
            {
                var newIng = new Ingredient { Name = _newIngredientName.Trim(), NormalizedName = normalized };
                DbContext.Ingredients.Add(newIng);
                await DbContext.SaveChangesAsync();
                ingredientId = newIng.Id;
            }
        }
        else
        {
            ingredientId = _selectedIngredientId!.Value;
        }

        var amount = double.Parse(_amountText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture);
        var unit = string.IsNullOrWhiteSpace(_unit) ? "piece" : _unit.Trim();
        DialogInstance?.Close(CbDialogResult.Ok(new GroceryItemResult(ingredientId, Math.Round(amount, 2), unit)));
    }

    public record GroceryItemResult(int IngredientId, double Amount, string Unit);
}
