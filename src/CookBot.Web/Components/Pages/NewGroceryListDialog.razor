@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="List name" Variant="Variant.Outlined" AutoFocus="true"
                      Placeholder="e.g. Weekly shop"
                      HelperText="Leave blank to use a default name with today's date" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _name = "";

    private void Cancel() => MudDialog.Cancel();

    private void Submit() => MudDialog.Close(DialogResult.Ok(_name.Trim()));
}
