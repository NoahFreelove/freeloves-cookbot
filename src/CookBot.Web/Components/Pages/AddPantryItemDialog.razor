@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@using CookBot.Application.Services

@* Phase 7 / Plan 07-02: pantry "Add item" dialog using CbDialog slots.
   Renders inside CbDialogHost; Title is supplied at ShowAsync call.
   Ingredient picker is a CbSelect over the loaded ingredient list plus a CbInput
   "or add new ingredient" name field. Amount uses CbInput type="number".
   Expiration date uses native HTML <input type="date">. *@

<div>
    <div style="display:flex;flex-direction:column;gap:14px;">
        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Ingredient</span>
            <CbSelect TValue="int?" @bind-Value="_selectedIngredientId" Placeholder="Select an existing ingredient…">
                @foreach (var ing in Ingredients)
                {
                    <CbOption TValue="int?" Value="@(ing.Id)" Label="@ing.Name" />
                }
            </CbSelect>
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Or add new ingredient</span>
            <CbInput @bind-Value="_newIngredientName" Placeholder="Leave blank to use selection above" />
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Amount (optional)</span>
            <CbInput Type="number" @bind-Value="_amountText" Placeholder="Leave blank to track only that you have it (in stock)." />
            <span style="font-size:11.5px;color:var(--ink-3);">
                Leave blank to track only that you have it (in stock), not a quantity.
            </span>
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Unit</span>
            <CbSelect TValue="string" @bind-Value="_unit" Disabled="@(!HasAmount)">
                @foreach (var u in CommonUnits)
                {
                    <CbOption TValue="string" Value="@u" Label="@u" />
                }
            </CbSelect>
            @if (!HasAmount)
            {
                <span style="font-size:11.5px;color:var(--ink-3);">Not used when amount is blank.</span>
            }
        </label>

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Expiration date (optional)</span>
            <input type="date" class="cb-input" value="@(_expiration?.ToString("yyyy-MM-dd"))"
                   @onchange="OnExpirationChanged" />
        </label>
    </div>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Submit"
                  Disabled="@(!CanSubmit)">Add</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public List<Ingredient> Ingredients { get; set; } = new();

    private int? _selectedIngredientId;
    private string _newIngredientName = "";
    private string _amountText = "";
    private string _unit = "cup";
    private DateTime? _expiration;

    private static readonly string[] CommonUnits = new[]
    {
        "tsp", "tbsp", "fl oz", "cup", "pint", "quart", "gallon",
        "ml", "liter", "oz", "lb", "g", "kg", "pinch", "dash",
        "piece", "slice", "clove", "bunch", "can", "bottle", "bag"
    };

    private bool HasAmount =>
        !string.IsNullOrWhiteSpace(_amountText) &&
        double.TryParse(_amountText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) &&
        v > 0;

    private bool CanSubmit =>
        (_selectedIngredientId.HasValue || !string.IsNullOrWhiteSpace(_newIngredientName))
        && (string.IsNullOrWhiteSpace(_amountText) || HasAmount);

    private void OnExpirationChanged(ChangeEventArgs e)
    {
        var raw = e.Value as string;
        if (string.IsNullOrWhiteSpace(raw))
        {
            _expiration = null;
        }
        else if (DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.AssumeLocal, out var dt))
        {
            _expiration = dt;
        }
    }

    private void Cancel() => DialogInstance?.Cancel();

    private async Task Submit()
    {
        int ingredientId;
        if (!string.IsNullOrWhiteSpace(_newIngredientName))
        {
            var normalized = CookBot.Application.Services.IngredientResolver.Normalize(_newIngredientName);
            var existing = await DbContext.Ingredients.FirstOrDefaultAsync(i => i.NormalizedName == normalized);
            if (existing != null)
            {
                ingredientId = existing.Id;
            }
            else
            {
                var newIng = new Ingredient { Name = _newIngredientName, NormalizedName = normalized };
                DbContext.Ingredients.Add(newIng);
                await DbContext.SaveChangesAsync();
                ingredientId = newIng.Id;
            }
        }
        else
        {
            ingredientId = _selectedIngredientId!.Value;
        }

        double amount;
        string unit;
        if (!HasAmount)
        {
            amount = 1;
            unit = PantryAiImport.UnmeasuredUnit;
        }
        else
        {
            amount = double.Parse(_amountText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture);
            unit = string.IsNullOrWhiteSpace(_unit) ? "cup" : _unit;
        }

        DialogInstance?.Close(CbDialogResult.Ok(new PantryItemResult(ingredientId, amount, unit, _expiration)));
    }

    public record PantryItemResult(int IngredientId, double Amount, string Unit, DateTime? Expiration);
}
