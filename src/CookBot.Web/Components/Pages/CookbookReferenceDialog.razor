@* Phase 7 / Plan 07-01: cookbook-reference-token picker for the prompt builder.
   Renders inside CbDialogHost; supplies Body + Footer markup only. *@
@using CookBot.Domain.Entities
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@rendermode InteractiveServer

<div>
    <p style="font-size:13.5px;color:var(--ink-2);line-height:1.5;margin:0 0 14px 0;">
        Inserts a token into your system prompt. When you chat, it is replaced by the recipe titles in that cookbook so the assistant knows what you have already saved.
    </p>

    @if (!_cookbooks.Any())
    {
        <p style="font-size:13.5px;color:var(--ink-3);">No cookbooks available.</p>
    }
    else
    {
        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
            <span>Cookbook</span>
            <CbSelect TValue="int" Value="_selectedId" ValueChanged="@((int v) => _selectedId = v)">
                @foreach (var c in _cookbooks)
                {
                    <CbOption TValue="int" Value="@c.Id" Label="@($"{c.Name} (ID {c.Id})")" />
                }
            </CbSelect>
        </label>
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Ok" Disabled="!_cookbooks.Any()">Insert token</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }

    [Parameter] public int UserId { get; set; }

    private List<Cookbook> _cookbooks = new();
    private int _selectedId;

    protected override async Task OnInitializedAsync()
    {
        _cookbooks = await DbContext.Cookbooks
            .AsNoTracking()
            .Where(c => c.UserId == UserId || c.Shares.Any(s => s.SharedWithUserId == UserId))
            .OrderBy(c => c.Name)
            .ToListAsync();
        _selectedId = _cookbooks.FirstOrDefault()?.Id ?? 0;
    }

    private void Cancel() => DialogInstance?.Cancel();

    private void Ok() => DialogInstance?.Close(CbDialogResult.Ok(_selectedId));
}
