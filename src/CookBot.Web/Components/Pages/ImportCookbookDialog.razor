@inject CurrentUserService UserService
@inject CookbookTransferService TransferService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Import cookbook</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Upload a <strong>.json</strong> file exported from CookBot. A new cookbook will be created in your account.
        </MudText>
        <MudTextField @bind-Value="_overrideName" Label="Cookbook name (optional)" Variant="Variant.Outlined"
                      Class="mb-3" HelperText="Leave blank to use the name from the file." />
        <InputFile OnChange="OnFileSelected" accept=".json,application/json" class="mb-2" />
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-2" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string? _overrideName;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (_busy || !UserService.CurrentUserId.HasValue) return;
        var file = e.File;
        if (file == null) return;

        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var doc = TransferService.Deserialize(json, out var errors);
            if (doc == null)
            {
                Snackbar.Add(string.Join(" ", errors), Severity.Error);
                return;
            }
            if (errors.Count > 0)
            {
                // Partial-success surface (UI-SPEC Surface 8): some recipes failed validation
                // but the envelope is intact. Show a warning so the user sees per-recipe issues.
                Snackbar.Add($"Import completed with {errors.Count} warning(s): {string.Join(" | ", errors)}", Severity.Warning);
            }

            var newId = await TransferService.ImportAsNewCookbookAsync(
                UserService.CurrentUserId.Value, doc,
                string.IsNullOrWhiteSpace(_overrideName) ? null : _overrideName.Trim());
            Snackbar.Add("Cookbook imported.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(newId));
            Navigation.NavigateTo($"/cookbooks/{newId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
