@page "/recipes/{RecipeId:int}/made"
@using CookBot.Infrastructure.Data
@using CookBot.Web.Components.Atoms
@inject CurrentUserService UserService
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookBot.Application.Services.PantryService PantryService
@inject NavigationManager Navigation
@inject ICbToastService Toast
@rendermode InteractiveServer

<PageTitle>CookBot - I Made This!</PageTitle>

@*  RecipeMade — Phase 7 / Plan 07-07 rewrite against Phase 5 atoms.
    Logic is preserved verbatim from the prior markup; only the render tree
    and the toast call (now ICbToastService) change. *@

<UserGuard>
@if (_recipe != null)
{
    <div class="cb" style="max-width:600px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
            <button type="button"
                    class="cb-btn ghost"
                    style="padding:6px 12px;"
                    aria-label="Back"
                    @onclick="GoBack">
                <Icon Name="@Icon.Names.ArrowL" Size="14" />
            </button>
            <h1 style="font-size:24px;font-weight:600;margin:0;">I Made This!</h1>
        </div>

        <CbCard>
            <h2 style="font-size:18px;font-weight:600;margin:0 0 16px 0;">@_recipe.Name</h2>

            <div style="margin-bottom:16px;">
                <div class="cb-label">Servings multiplier</div>
                <input type="number"
                       class="cb-input"
                       step="0.25"
                       min="0.25"
                       max="10"
                       value="@_servingsMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="OnServingsMultiplierInput"
                       style="max-width:160px;" />
                <div style="margin-top:6px;color:var(--ink-3);font-size:12px;">
                    Original: @_recipe.Servings servings. Adjust if you made more or less.
                </div>
            </div>

            <div class="eyebrow" style="margin-bottom:8px;">Ingredients to deduct from pantry:</div>

            <ul style="list-style:none;padding:0;margin:0 0 16px 0;display:flex;flex-direction:column;gap:6px;">
                @foreach (var ri in _recipe.RecipeIngredients.OrderBy(r => r.RecipeLocalId))
                {
                    var scaled = Math.Round(ri.Amount * _servingsMultiplier, 2);
                    <li style="font-size:14px;">
                        <b>@scaled @CookBot.Application.Services.UnitParser.ToDisplayString(ri.Unit)</b>
                        @ri.Ingredient.Name
                    </li>
                }
            </ul>

            @if (_deducted)
            {
                <div class="cb-card"
                     style="background:var(--green-soft);border-color:var(--green);padding:12px;margin-bottom:16px;">
                    Pantry updated! @_deductedCount ingredient(s) deducted.
                </div>
            }

            <div style="display:flex;gap:8px;">
                <CbButton Variant="CbButton.CbButtonVariant.Primary"
                          StartIcon="@Icon.Names.Check"
                          OnClick="DeductFromPantry"
                          Disabled="@_deducted">
                    Deduct from Pantry
                </CbButton>
                <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="GoBack">Cancel</CbButton>
            </div>
        </CbCard>
    </div>
}
else if (_loaded)
{
    <p>Recipe not found or you do not have access.</p>
}
</UserGuard>

@code {
    [Parameter] public int RecipeId { get; set; }
    private Recipe? _recipe;
    private double _servingsMultiplier = 1.0;
    private bool _deducted;
    private int _deductedCount;
    private bool _loaded;
    private bool _initialized;
    private int _boundRecipeId;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (_boundRecipeId != RecipeId)
        {
            _boundRecipeId = RecipeId;
            _initialized = false;
            _recipe = null;
            _loaded = false;
            _deducted = false;
            _deductedCount = 0;
            _servingsMultiplier = 1.0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UserService.CurrentUserId.HasValue) return;
        var userId = UserService.CurrentUserId.Value;

        if (!_initialized)
        {
            _initialized = true;

            if (!await DbContext.UserCanAccessRecipeAsync(RecipeId, userId))
            {
                _recipe = null;
            }
            else
            {
                _recipe = await DbContext.Recipes
                    .Include(r => r.RecipeIngredients).ThenInclude(ri => ri.Ingredient)
                    .FirstOrDefaultAsync(r => r.Id == RecipeId);
            }

            _loaded = true;
            StateHasChanged();
        }
    }

    private void OnServingsMultiplierInput(ChangeEventArgs e)
    {
        if (e.Value is string s
            && double.TryParse(s, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            && parsed >= 0.25 && parsed <= 10)
        {
            _servingsMultiplier = parsed;
        }
    }

    private async Task DeductFromPantry()
    {
        if (_recipe == null || !UserService.CurrentUserId.HasValue) return;

        var personalPantry = await PantryService.EnsurePersonalPantryAsync(UserService.CurrentUserId.Value);
        _deductedCount = 0;

        foreach (var ri in _recipe.RecipeIngredients)
        {
            var scaledAmount = ri.Amount * _servingsMultiplier;
            await PantryService.DeductAsync(personalPantry.Id, ri.IngredientId, scaledAmount, ri.Unit);
            _deductedCount++;
        }

        _deducted = true;
        Toast.Show($"Deducted {_deductedCount} ingredients from pantry!", CbToastSeverity.Success);
    }

    private void GoBack() => Navigation.NavigateTo($"/recipes/{RecipeId}");
}
