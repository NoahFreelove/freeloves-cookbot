@* Phase 7 / Plan 07-01: save-AI-draft-recipe-to-cookbook dialog.
   Renders inside CbDialogHost; supplies Body + Footer markup only. *@
@inject CookBot.Application.Services.RecipeService RecipeService
@inject CookBot.Domain.Interfaces.IRecipeFormatParser Parser
@inject CurrentUserService UserService
@inject ICbToastService Toast

<div>
    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:18px;">
        <span>Select Cookbook</span>
        <CbSelect TValue="int" Value="_selectedCookbookId" ValueChanged="@((int v) => _selectedCookbookId = v)">
            @foreach (var cb in Cookbooks)
            {
                <CbOption TValue="int" Value="@cb.Id" Label="@cb.Name" />
            }
        </CbSelect>
    </label>

    <div style="display:flex;justify-content:flex-end;gap:8px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Save"
                  Disabled="@(_selectedCookbookId == 0 || _saving)">
            @(_saving ? "Saving..." : "Save")
        </CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public List<Cookbook> Cookbooks { get; set; } = new();
    [Parameter] public string RecipeContent { get; set; } = "";

    private int _selectedCookbookId;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Cookbooks.Any())
            _selectedCookbookId = Cookbooks.First().Id;
    }

    private void Cancel() => DialogInstance?.Cancel();

    private async Task Save()
    {
        _saving = true;
        try
        {
            if (!Parser.TryParse(RecipeContent, out var parsed, out var errors) || parsed == null)
            {
                Toast.Show($"Invalid recipe format: {string.Join(", ", errors)}", CbToastSeverity.Error);
                return;
            }
            var userId = UserService.CurrentUserId
                ?? throw new InvalidOperationException("Not logged in.");
            await RecipeService.CreateAsync(_selectedCookbookId, userId, parsed);
            DialogInstance?.Close(CbDialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Toast.Show($"Error saving: {ex.Message}", CbToastSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
