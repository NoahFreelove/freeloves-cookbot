@using CookBot.Domain.Entities
@inject CurrentUserService UserService
@inject AiApiKeyShareService ShareService
@inject AiApiKeyResolutionService AiKeyResolver
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject ICbToastService Toast
@rendermode InteractiveServer

@* Phase 7 / Plan 07-05: SharedKeysDialog migrated to CbDialog slots (D-27).
   Body shows three sections — outgoing shares (manage who you share with),
   incoming shares info (who shares with you + active key status), and a
   preferred-owner picker when multiple sharers exist. Footer hosts Close.
   Inner dropdowns + buttons use Cb atoms. Toasts via ICbToastService. *@

<div>
    @if (!UserService.CurrentUserId.HasValue)
    {
        <p style="margin:0;font-size:14px;color:var(--ink-3);">Select a user in the header first.</p>
    }
    else
    {
        <p style="margin:0 0 16px 0;font-size:13px;color:var(--ink-3);">
            People you share with can use your Anthropic key for CookBot AI features.
            They never see the key, and you can revoke access anytime.
        </p>

        <div style="font-size:13px;font-weight:600;color:var(--ink);margin-bottom:8px;">Share your key with</div>
        <div style="display:flex;gap:8px;align-items:flex-end;margin-bottom:16px;">
            <div style="flex:1;">
                <CbSelect TValue="int" @bind-Value="_addRecipientId">
                    <CbOption TValue="int" Value="0" Label="Select user…" />
                    @foreach (var u in _eligibleRecipients)
                    {
                        <CbOption TValue="int" Value="@u.Id" Label="@u.DisplayName" />
                    }
                </CbSelect>
            </div>
            <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="AddShareAsync"
                      Disabled="@(_addRecipientId == 0)">
                Add
            </CbButton>
        </div>

        @if (_outgoing.Any())
        {
            <div style="font-size:12px;color:var(--ink-3);margin-bottom:6px;">Currently shared with</div>
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px;">
                @foreach (var p in _outgoing)
                {
                    <div class="cb-card" style="padding:10px 12px;display:flex;align-items:center;gap:10px;">
                        <span style="flex:1;font-size:13px;color:var(--ink);">@p.DisplayName</span>
                        <button type="button"
                                class="cb-btn ghost"
                                style="padding:4px 8px;color:var(--warn);"
                                aria-label="@($"Revoke share for {p.DisplayName}")"
                                @onclick="@(() => RevokeOutgoingAsync(p.UserId))">
                            <Icon Name="@Icon.Names.Link" Size="14" />
                            <span style="margin-left:4px;">Revoke</span>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <p style="margin:0 0 16px 0;font-size:12px;color:var(--ink-3);">
                You are not sharing your key with anyone yet.
            </p>
        }

        <div style="height:1px;background:var(--line);margin:16px 0;"></div>

        <div style="font-size:13px;font-weight:600;color:var(--ink);margin-bottom:8px;">
            API access others share with you
        </div>

        @if (!_incomingAll.Any())
        {
            <p style="margin:0;font-size:13px;color:var(--ink-3);">
                No one has shared their key with this account. They can add you from the same
                dialog on their login.
            </p>
        }
        else if (_hasOwnKey)
        {
            <div class="cb-card" style="background:var(--accent-soft);color:var(--accent-ink);padding:12px;margin-bottom:12px;border:none;font-size:13px;">
                <strong>Your own saved Anthropic key is used</strong> for CookBot AI. Incoming
                shares stay on file if you clear your key later.
            </div>
            <div style="font-size:12px;color:var(--ink-3);margin-bottom:4px;">Granted by</div>
            <div style="display:flex;flex-direction:column;gap:4px;">
                @foreach (var p in _incomingAll)
                {
                    <span style="font-size:13px;color:var(--ink);">@p.DisplayName</span>
                }
            </div>
        }
        else if (!_incomingUsable.Any())
        {
            <div class="cb-card" style="background:var(--warn-soft);color:var(--warn);padding:12px;border:none;font-size:13px;">
                One or more people have shared with you, but <strong>none of them currently have
                an API key saved</strong> on their profile. They need to add a key before you can
                use shared access.
            </div>
            <p style="margin:12px 0 0 0;font-size:12px;color:var(--ink-3);">
                Share relationships: @string.Join(", ", _incomingAll.Select(p => p.DisplayName))
            </p>
        }
        else if (_effectiveAi?.SharedFromUserId != null)
        {
            <p style="margin:0 0 12px 0;font-size:13px;color:var(--ink-3);">
                CookBot is using API access from <strong>@_effectiveAi.SharedFromDisplayName</strong>.
                You never see their key; model and billing follow their profile.
            </p>
            @if (_incomingUsable.Count > 1)
            {
                <p style="margin:0 0 8px 0;font-size:12px;color:var(--ink-3);">
                    Several people could share with you. Change which account to use:
                </p>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <CbSelect TValue="int" Value="_preferredOwnerId" ValueChanged="OnPreferredOwnerChanged">
                        <CbOption TValue="int" Value="0" Label="Choose account…" />
                        @foreach (var p in _incomingUsable)
                        {
                            <CbOption TValue="int" Value="@p.UserId" Label="@p.DisplayName" />
                        }
                    </CbSelect>
                    <div>
                        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="SavePreferredAsync"
                                  Disabled="@(_preferredOwnerId == 0)">
                            Save choice
                        </CbButton>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="cb-card" style="background:var(--warn-soft);color:var(--warn);padding:12px;margin-bottom:12px;border:none;font-size:13px;">
                More than one person can share a working key with you. Pick whose key CookBot
                should use (or add your own key in Profile).
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <CbSelect TValue="int" Value="_preferredOwnerId" ValueChanged="OnPreferredOwnerChanged">
                    <CbOption TValue="int" Value="0" Label="Choose account…" />
                    @foreach (var p in _incomingUsable)
                    {
                        <CbOption TValue="int" Value="@p.UserId" Label="@p.DisplayName" />
                    }
                </CbSelect>
                <div>
                    <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="SavePreferredAsync"
                              Disabled="@(_preferredOwnerId == 0)">
                        Save choice
                    </CbButton>
                </div>
            </div>
        }
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Close">Close</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }

    private List<User> _allUsers = new();
    private List<AiApiKeyShareService.ShareParty> _outgoing = new();
    private List<AiApiKeyShareService.ShareParty> _incomingAll = new();
    private List<AiApiKeyShareService.ShareParty> _incomingUsable = new();
    private List<User> _eligibleRecipients = new();
    private EffectiveAiCredentials? _effectiveAi;
    private bool _hasOwnKey;

    /// <summary>0 means none selected.</summary>
    private int _addRecipientId;
    private int _preferredOwnerId;

    protected override async Task OnInitializedAsync()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var me = UserService.CurrentUserId!.Value;
        _allUsers = await UserService.GetAllUsersAsync();
        _outgoing = (await ShareService.ListOutgoingAsync(me)).ToList();
        _incomingAll = (await ShareService.ListIncomingAsync(me)).ToList();
        _incomingUsable = (await ShareService.ListIncomingWithUsableOwnerKeyAsync(me)).ToList();

        var outgoingIds = _outgoing.Select(o => o.UserId).ToHashSet();
        _eligibleRecipients = _allUsers
            .Where(u => u.Id != me && !outgoingIds.Contains(u.Id))
            .OrderBy(u => u.DisplayName)
            .ToList();

        _effectiveAi = await AiKeyResolver.ResolveAsync(me);

        var profile = await DbContext.UserProfiles.AsNoTracking()
            .FirstOrDefaultAsync(p => p.UserId == me);
        _hasOwnKey = !string.IsNullOrWhiteSpace(profile?.AiApiKey);

        var usableIds = _incomingUsable.Select(p => p.UserId).ToHashSet();
        _preferredOwnerId = profile?.AiSharedKeyOwnerUserId ?? 0;
        if (_effectiveAi?.SharedFromUserId is int activeOwner && usableIds.Contains(activeOwner))
            _preferredOwnerId = activeOwner;
        else if (_incomingUsable.Count == 1)
            _preferredOwnerId = _incomingUsable[0].UserId;
        else if (_preferredOwnerId != 0 && !usableIds.Contains(_preferredOwnerId))
            _preferredOwnerId = 0;

        _addRecipientId = 0;
    }

    private async Task AddShareAsync()
    {
        if (!UserService.CurrentUserId.HasValue || _addRecipientId == 0) return;

        var err = await ShareService.GrantAsync(UserService.CurrentUserId.Value, _addRecipientId);
        if (err != null)
        {
            Toast.Show(err, CbToastSeverity.Warning);
            return;
        }

        Toast.Show("Share added.", CbToastSeverity.Success);
        await ReloadAsync();
    }

    private async Task RevokeOutgoingAsync(int recipientId)
    {
        if (!UserService.CurrentUserId.HasValue) return;
        await ShareService.RevokeAsync(UserService.CurrentUserId.Value, recipientId);
        Toast.Show("Share revoked.", CbToastSeverity.Info);
        await ReloadAsync();
    }

    private Task OnPreferredOwnerChanged(int value)
    {
        _preferredOwnerId = value;
        return Task.CompletedTask;
    }

    private async Task SavePreferredAsync()
    {
        if (!UserService.CurrentUserId.HasValue || _preferredOwnerId == 0) return;
        await ShareService.SetPreferredSharedOwnerAsync(UserService.CurrentUserId.Value, _preferredOwnerId);
        Toast.Show("Preference saved.", CbToastSeverity.Success);
        await ReloadAsync();
    }

    private void Close() => DialogInstance?.Close(CbDialogResult.Ok());
}
