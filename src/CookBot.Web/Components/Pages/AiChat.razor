@page "/ai"
@using System.Text
@using System.Text.RegularExpressions
@using CookBot.Application.DTOs
@using CookBot.Application.Services
@using CookBot.Domain.Recipes
@using CookBot.Infrastructure.AI
@using Markdig
@inject Microsoft.Extensions.Options.IOptions<CookBotSettings> CookBotSettingsOptions
@inject CurrentUserService UserService
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookBot.Domain.Interfaces.IAiService AiService
@inject CookBot.Application.AI.IAiRecipeGenerator AiRecipeGenerator
@inject CookBot.Application.Recipes.JsonRecipeSerializer CanonicalSerializer
@inject AiApiKeyResolutionService AiKeyResolver
@inject CookBot.Application.Services.PromptBuilderService PromptBuilder
@inject CookBot.Application.Services.PantryService PantryService
@inject CookBot.Domain.Interfaces.IRecipeFormatParser Parser
@inject ICbToastService Toast
@inject ICbDialogService CbDialogService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@* Phase 7 / Plan 07-04 / AIC-01..05.
   AiChat.razor — full rewrite of the markup against Phase 5 atoms per
   `.planning/design-handoff/project/screens/ai-chat.jsx`.

   Hard invariants preserved verbatim from the previous (Mud-based) implementation:
     - IAiRecipeGenerator orchestrator wiring (validate → repair → fail; never throws).
     - StructuredResult<RecipeDocument> drives Save / Edit-anyway / Retry surfaces.
     - SecretRedactor / PromptInjectionGuard run inside AnthropicAiService and
       AiRecipeGenerator — this page is a presentation surface only.
     - SaveRecipeDialog / CookbookReferenceDialog / SharedKeysDialog launched via
       ICbDialogService (Phase 7 / 07-01 / 07-05 migrations).
     - POLISH-01: legacy three-tier ExtractRecipeContent extractor stays DELETED
       (no projection from rendered text — RecipeDocument is the single source).
     - AI-off contract: full-screen "AI disabled" / "API key missing" panes
       redirect users to /profile via inline CbButton; sidebar already hides the
       /ai entry when AI off (Phase 5 Sidebar.razor).
     - AssembleMessagesForAiCall (D-23): pre-Phase-2 conversation transient note
       prepended; stamp FormatVersion=2 on save (D-22).
     - AssistantContentPipeline: Markdig with DisableHtml() — raw HTML can't
       reach the DOM (AI-08-AUDIT / D-15).

   Layout (per ai-chat.jsx):
     - 380px chat rail (paper-2 bg) + flex right canvas
     - Left rail: scrollable message stream + bottom chat input with
       suggestion chips + accent send button
     - Right canvas: drafting save-bar + streaming RecipeDocument card
       (eyebrow + title + 2-col ingredients/method)
     - Streaming caret on active chat turn + active step (cb-blink keyframe)
     - Drafting pulse dot on save-bar chip (cb-pulse keyframe)

   Hard invariant: zero Mud* symbols in this file. *@

<PageTitle>CookBot - AI Assistant</PageTitle>

<UserGuard>
@if (!CookBotSettingsOptions.Value.AiFeaturesEnabled)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:14px;">
        <Icon Name="@Icon.Names.Spark" Size="40" />
        <h2 style="font-size:22px;letter-spacing:-0.022em;margin:0;">AI is disabled on this server</h2>
        <p style="color:var(--ink-3);font-size:13.5px;text-align:center;max-width:420px;margin:0;">
            The administrator set <code>CookBot:AiFeaturesEnabled</code> to false. Recipe management and cooking features still work locally.
        </p>
    </div>
}
else if (_profile?.AiEnabled == false)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:14px;">
        <Icon Name="@Icon.Names.Spark" Size="40" />
        <h2 style="font-size:22px;letter-spacing:-0.022em;margin:0;">AI features are disabled</h2>
        <p style="color:var(--ink-3);font-size:13.5px;text-align:center;max-width:420px;margin:0;">
            Enable AI in your Profile Settings to use the assistant.
        </p>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="@(() => Navigation.NavigateTo("/profile"))">
            Open Profile
        </CbButton>
    </div>
}
else if (_profile != null && _profile.AiEnabled && _effectiveAi == null)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:14px;">
        <Icon Name="@Icon.Names.Spark" Size="40" />
        <h2 style="font-size:22px;letter-spacing:-0.022em;margin:0;">No API access configured</h2>
        <p style="color:var(--ink-3);font-size:13.5px;text-align:center;max-width:480px;margin:0;">
            Add your own Anthropic key in Profile, or ask another user on this device to share their key with you.
        </p>
        <div style="display:flex;gap:8px;">
            <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="@(() => Navigation.NavigateTo("/profile"))">
                Open Profile
            </CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Share" OnClick="OpenSharedKeysDialog">
                Shared keys
            </CbButton>
        </div>
    </div>
}
else if (_profile != null && _profile.AiEnabled && _effectiveAi != null)
{
    @* ── Two-column AI Chat shell ─────────────────────────────────────────
       The page sits inside MainLayout's main column (24px padding); we
       pull padding off the inner shell so the rail's paper-2 background
       extends edge-to-edge inside the page bounds. *@
    <div style="display:grid;grid-template-columns:380px 1fr;height:calc(100vh - 96px);min-height:520px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--paper);">

        @* ── Left rail: chat conversation + input ─────────────────────── *@
        <section style="border-right:1px solid var(--line);display:flex;flex-direction:column;background:var(--paper-2);min-width:0;">

            @* Header inside rail: model id + new-conversation + shared-keys *@
            <div style="padding:14px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;">
                <div style="flex:1;min-width:0;">
                    <div style="font-size:11.5px;color:var(--ink-3);font-weight:500;letter-spacing:0.04em;text-transform:uppercase;">generate</div>
                    <div style="font-size:12.5px;color:var(--ink-3);">@(_effectiveAi?.ModelId ?? "claude") · streaming</div>
                </div>
                <button type="button" class="cb-btn ghost" style="padding:6px 10px;font-size:12px;"
                        title="Shared API keys" aria-label="Shared API keys" @onclick="OpenSharedKeysDialog">
                    <Icon Name="@Icon.Names.Share" Size="13" />
                </button>
                <button type="button" class="cb-btn ghost" style="padding:6px 10px;font-size:12px;"
                        title="New conversation" aria-label="New conversation" @onclick="NewConversation">
                    <Icon Name="@Icon.Names.Plus" Size="13" />
                </button>
            </div>

            @* Conversation list (compact rows) *@
            @if (_conversations.Any())
            {
                <div style="padding:10px 12px;border-bottom:1px solid var(--line);max-height:140px;overflow-y:auto;display:flex;flex-direction:column;gap:2px;">
                    @foreach (var conv in _conversations)
                    {
                        <div role="button" tabindex="0"
                             class="@($"ai-conv-row{(conv.Id == _selectedConversationId ? " is-active" : string.Empty)}")"
                             style="@ConvRowStyle(conv.Id == _selectedConversationId)"
                             @onclick="() => LoadConversation(conv)"
                             @onkeydown="@(e => OnConvRowKeyDown(e, conv))">
                            <span style="flex:1;min-width:0;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@conv.Title</span>
                            <button type="button" class="cb-btn ghost"
                                    style="padding:4px;border:0;"
                                    title="Delete conversation"
                                    aria-label="@($"Delete conversation {conv.Title}")"
                                    @onclick="() => DeleteConversation(conv)"
                                    @onclick:stopPropagation="true">
                                <Icon Name="@Icon.Names.Trash" Size="12" />
                            </button>
                        </div>
                    }
                </div>
            }

            @* Message stream *@
            <div style="flex:1;padding:24px 22px;overflow-y:auto;display:flex;flex-direction:column;gap:18px;min-height:0;" @ref="_chatContainer">
                @if (!_messages.Any() && !_isStreaming && !_isDraftingRecipe)
                {
                    <div style="margin:auto;text-align:center;color:var(--ink-3);">
                        <Icon Name="@Icon.Names.Spark" Size="32" />
                        <div style="font-size:15px;font-weight:600;color:var(--ink-1);margin-top:10px;">Ask me anything about cooking</div>
                        <div style="font-size:12.5px;margin-top:4px;">I can suggest recipes, help with substitutions, or build a structured recipe for you.</div>
                    </div>
                }

                @{
                    var lastMessage = _messages.LastOrDefault();
                }
                @foreach (var msg in _messages)
                {
                    var isLast = msg == lastMessage;
                    var streamingThisTurn = isLast && (_isStreaming || _isDraftingRecipe);
                    @RenderTurn(msg, streamingThisTurn)
                }
                @if (_isStreaming && string.IsNullOrEmpty(_streamingContent))
                {
                    @* Awaiting first chunk — placeholder turn *@
                    <div>
                        <div style="font-size:11.5px;color:var(--accent);margin-bottom:5px;font-weight:500;display:flex;align-items:center;gap:6px;">
                            <Icon Name="@Icon.Names.Spark" Size="11" /> CookBot
                        </div>
                        <div style="font-size:13.5px;line-height:1.55;color:var(--ink-2);">
                            <span style="color:var(--ink-3);">Thinking</span><span class="cb-caret"></span>
                        </div>
                    </div>
                }
                else if (_isStreaming)
                {
                    <div>
                        <div style="font-size:11.5px;color:var(--accent);margin-bottom:5px;font-weight:500;display:flex;align-items:center;gap:6px;">
                            <Icon Name="@Icon.Names.Spark" Size="11" /> CookBot
                        </div>
                        <div class="recipe-body" style="font-size:13.5px;line-height:1.55;color:var(--ink-2);">
                            @((MarkupString)RenderContent(_streamingContent))<span class="cb-caret"></span>
                        </div>
                    </div>
                }

                @if (_lastStructuredRecipe is { Ok: false, Validation: not null })
                {
                    @* Surface 3 — edit-and-save-anyway after orchestrator exhausts retries *@
                    <div style="background:var(--paper);border:1px solid var(--line-strong);border-radius:12px;padding:14px;">
                        <div style="font-size:13px;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:6px;margin-bottom:6px;">
                            <Icon Name="@Icon.Names.Flag" Size="13" /> Could not validate recipe
                        </div>
                        <p style="font-size:12.5px;color:var(--ink-2);line-height:1.5;margin:0 0 10px 0;">
                            The AI could not produce a valid recipe after 2 attempts. You can edit the draft below or try again.
                        </p>
                        <div style="display:flex;gap:6px;">
                            <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Pencil" OnClick="OpenDraftInEditor">
                                Edit and save anyway
                            </CbButton>
                            <CbButton Variant="CbButton.CbButtonVariant.Subtle" OnClick="RetryRecipeGeneration">
                                Try again
                            </CbButton>
                        </div>
                    </div>
                }
            </div>

            @* Chat input *@
            <div style="padding:14px 18px 18px;border-top:1px solid var(--line);background:var(--paper-2);">
                <div style="background:var(--paper);border:1px solid var(--line-strong);border-radius:14px;padding:10px 12px;display:flex;flex-direction:column;gap:8px;">
                    <textarea class="cb-textarea ai-prompt"
                              placeholder="Refine the recipe…"
                              rows="2"
                              disabled="@(_isStreaming || _isDraftingRecipe)"
                              style="border:0;padding:0;background:transparent;min-height:0;resize:none;font-size:13.5px;line-height:1.45;color:var(--ink-1);"
                              @bind="_userInput"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"></textarea>
                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                        <button type="button" class="cb-chip" style="cursor:pointer;border:0;font-family:inherit;"
                                @onclick='() => InsertSuggestion("make spicier")'>make spicier</button>
                        <button type="button" class="cb-chip" style="cursor:pointer;border:0;font-family:inherit;"
                                @onclick='() => InsertSuggestion("half it")'>half it</button>
                        <button type="button" class="cb-chip" style="cursor:pointer;border:0;font-family:inherit;"
                                @onclick='() => InsertSuggestion("vegan")'>vegan</button>
                        <div style="flex:1;"></div>
                        <button type="button" class="ai-send"
                                title="Generate recipe"
                                aria-label="Generate recipe"
                                disabled="@(_isStreaming || _isDraftingRecipe || string.IsNullOrWhiteSpace(_userInput))"
                                @onclick="GenerateRecipeFromInput"
                                style="@SendBtnStyle(true)">
                            <Icon Name="@Icon.Names.Spark" Size="14" />
                        </button>
                        <button type="button" class="ai-send"
                                title="Send chat message"
                                aria-label="Send chat message"
                                disabled="@(_isStreaming || _isDraftingRecipe || string.IsNullOrWhiteSpace(_userInput))"
                                @onclick="SendMessage"
                                style="@SendBtnStyle(false)">
                            <Icon Name="@Icon.Names.Send" Size="15" />
                        </button>
                    </div>
                </div>
                <div style="font-size:11px;color:var(--ink-4);margin-top:8px;text-align:center;">
                    Recipe stays a draft until you save it
                </div>
            </div>
        </section>

        @* ── Right canvas: streaming recipe card ──────────────────────── *@
        <section style="overflow:auto;padding:32px 48px;position:relative;min-width:0;">

            @* Save bar *@
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
                <div style="display:flex;align-items:center;gap:10px;">
                    @if (_isDraftingRecipe)
                    {
                        <span class="cb-chip" style="background:var(--accent-soft);color:var(--accent-ink);">
                            <span style="width:6px;height:6px;border-radius:3px;background:var(--accent);display:inline-block;animation:cb-pulse 1.4s ease-in-out infinite;"></span>
                            drafting
                        </span>
                    }
                    else if (_lastStructuredRecipe?.Ok == true)
                    {
                        <span class="cb-chip" style="background:var(--accent-soft);color:var(--accent-ink);">
                            <Icon Name="@Icon.Names.Check" Size="11" /> ready
                        </span>
                    }
                    else if (_lastStructuredRecipe is { Ok: false, Validation: null, SanitizedError: not null })
                    {
                        <span class="cb-chip" style="background:var(--warn-soft);color:var(--warn);font-weight:600;">
                            <Icon Name="@Icon.Names.Flag" Size="11" /> AI error
                        </span>
                    }
                    else
                    {
                        <span class="cb-chip">
                            <Icon Name="@Icon.Names.Bolt" Size="11" /> empty canvas
                        </span>
                    }
                    <span style="font-size:12.5px;color:@(_lastStructuredRecipe is { Ok: false, Validation: null, SanitizedError: not null } ? "var(--warn)" : "var(--ink-3)");">
                        @_canvasStatusText
                    </span>
                </div>
                <div style="display:flex;gap:8px;">
                    <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Copy"
                              Disabled="@(_lastStructuredRecipe?.Ok != true)"
                              OnClick="CopyRecipeJsonAsync">
                        Copy JSON
                    </CbButton>
                    <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Save"
                              Disabled="@(_lastStructuredRecipe?.Ok != true)"
                              OnClick="SaveRecipeFromMessageAsync">
                        Save to cookbook
                    </CbButton>
                </div>
            </div>

            @* Recipe card — placeholder skeleton when no recipe; bound to canonical RecipeDocument when ready *@
            <CbCard Padding="40" Style="background:var(--paper);">
                @if (_lastStructuredRecipe?.Ok == true && _lastStructuredRecipe.Value is RecipeDocument doc)
                {
                    @RenderRecipeDocument(doc)
                }
                else if (_isDraftingRecipe)
                {
                    @RenderDraftingSkeleton()
                }
                else
                {
                    @RenderEmptyCanvas()
                }
            </CbCard>
        </section>
    </div>
}
else
{
    @* Loading skeleton while user/profile resolves *@
    <div style="display:flex;align-items:center;justify-content:center;min-height:60vh;color:var(--ink-3);">
        Loading…
    </div>
}
</UserGuard>

@code {
    private UserProfile? _profile;
    private EffectiveAiCredentials? _effectiveAi;
    private List<AiConversation> _conversations = new();
    private List<CookBot.Domain.Interfaces.AiMessage> _messages = new();
    private AiConversation? _currentConversation;
    private int _selectedConversationId;
    private string _userInput = "";
    private string _streamingContent = "";
    private bool _isStreaming;
    private ElementReference _chatContainer;
    private string _systemPrompt = "";

    private int? _loadedUserId;

    // Plan 02-04 / AI-08-AUDIT (D-15): assistant content is rendered through a pipeline with
    // raw HTML disabled, so injected markdown like "<img src='https://attacker/log'>"
    // or "<a href='javascript:...'>" cannot reach the DOM. Markdown image syntax
    // "![](url)" is still rendered (Markdig generates the <img> tag itself, not from
    // attacker HTML), but DisableHtml() removes the raw-HTML exfil surface that
    // the dropped AI-09 banner was theoretically guarding against.
    private static readonly Markdig.MarkdownPipeline AssistantContentPipeline =
        new Markdig.MarkdownPipelineBuilder().DisableHtml().Build();

    // Plan 02-04 — recipe-generation state.
    private bool _isDraftingRecipe;
    private CookBot.Application.AI.StructuredResult<CookBot.Domain.Recipes.RecipeDocument>? _lastStructuredRecipe;
    private CancellationTokenSource? _generationCts;

    // PHOTO-12 / PITFALL H4 — one-shot photo-load-failure flag for the AiChat canvas card.
    // Reset every time _lastStructuredRecipe is cleared (new conversation, conversation switch,
    // free-form chat turn, retry, or new generation start) so each generated doc.PhotoUrl gets
    // a fresh load attempt. POLISH-01 invariant: PhotoUrl is read DIRECTLY from doc, no extractor.
    private bool _aiChatPhotoFailed;

    private static readonly Regex CookbookRecipeTokenRegex = new(@"\{\{cookbook_recipes:(\d+)\}\}", RegexOptions.Compiled);

    private string _canvasStatusText
    {
        get
        {
            if (_isDraftingRecipe) return "validating against canonical schema…";
            if (_lastStructuredRecipe?.Ok == true && _lastStructuredRecipe.Value is { } doc)
                return $"{doc.Ingredients.Count} ingredients · {CountContentSteps(doc)} steps";
            if (_lastStructuredRecipe is { Ok: false, Validation: not null })
                return "validation failed — review draft";
            if (_lastStructuredRecipe is { Ok: false, Validation: null, SanitizedError: { } err })
                return MapToSanitizedSnackbarCopy(err);
            return "send a recipe request to generate";
        }
    }

    private static int CountContentSteps(RecipeDocument doc) =>
        doc.Steps.Count(s => s is ContentStep);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UserService.CurrentUserId.HasValue && _loadedUserId != UserService.CurrentUserId.Value)
        {
            _loadedUserId = UserService.CurrentUserId.Value;
            var user = await UserService.GetCurrentUserAsync();
            _profile = user?.Profile;
            _effectiveAi = user != null ? await AiKeyResolver.ResolveAsync(user.Id) : null;
            await LoadConversations();
            await BuildSystemPrompt();
            StateHasChanged();
        }
    }

    private async Task OpenSharedKeysDialog()
    {
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Md, FullWidth: true);
        var result = await CbDialogService.ShowAsync<SharedKeysDialog>("Shared API keys", null, options);
        if (result != null && !result.Canceled && UserService.CurrentUserId is int uid)
        {
            _effectiveAi = await AiKeyResolver.ResolveAsync(uid);
            StateHasChanged();
        }
    }

    private async Task BuildSystemPrompt()
    {
        if (_profile != null)
        {
            var user = await UserService.GetCurrentUserAsync();
            var pantryItems = await PantryService.GetAllUserAccessibleItemsAsync(user!.Id);
            // Load Ingredient navigation property for items from repository
            var ingredientIds = pantryItems.Select(p => p.IngredientId).Distinct().ToList();
            var ingredients = await DbContext.Ingredients.Where(i => ingredientIds.Contains(i.Id)).ToDictionaryAsync(i => i.Id);
            foreach (var item in pantryItems)
                item.Ingredient ??= ingredients.GetValueOrDefault(item.IngredientId)!;
            var template = _profile.AiSystemPromptTemplate ?? CookBot.Application.Services.PromptBuilderService.DefaultTemplate;
            template = await ExpandCookbookRecipeTokensAsync(template, user!.Id);
            _systemPrompt = PromptBuilder.ResolveTemplate(template, _profile, pantryItems);
        }
    }

    private async Task LoadConversations()
    {
        if (UserService.CurrentUserId is int userId)
        {
            _conversations = await DbContext.AiConversations
                .Where(c => c.UserId == userId)
                .OrderByDescending(c => c.UpdatedAt)
                .ToListAsync();
        }
    }

    private void LoadConversation(AiConversation conv)
    {
        _currentConversation = conv;
        _selectedConversationId = conv.Id;
        _messages = System.Text.Json.JsonSerializer.Deserialize<List<CookBot.Domain.Interfaces.AiMessage>>(conv.MessagesJson) ?? new();
        // Plan 02-04 / D-23: pre-Phase-2 conversations had FormatVersion < 2; the next AI
        // call within this conversation gets a transient resume note prepended at request
        // assembly time (see AssembleMessagesForAiCall). The note is NOT persisted.
        // Drop any stale structured-recipe state from a different conversation.
        _lastStructuredRecipe = null;
        _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.
    }

    private void OnConvRowKeyDown(KeyboardEventArgs e, AiConversation conv)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            LoadConversation(conv);
        }
    }

    private async Task NewConversation()
    {
        _currentConversation = null;
        _messages.Clear();
        _selectedConversationId = 0;
        _lastStructuredRecipe = null;
        _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.
        await Task.CompletedTask;
    }

    private async Task DeleteConversation(AiConversation conv)
    {
        DbContext.AiConversations.Remove(conv);
        await DbContext.SaveChangesAsync();
        _conversations.Remove(conv);
        if (_currentConversation?.Id == conv.Id)
        {
            _currentConversation = null;
            _messages.Clear();
            _lastStructuredRecipe = null;
            _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.
        }
    }

    private void InsertSuggestion(string text)
    {
        if (string.IsNullOrWhiteSpace(_userInput))
        {
            _userInput = text;
        }
        else
        {
            _userInput = _userInput.TrimEnd() + " " + text;
        }
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_isStreaming && !_isDraftingRecipe && !string.IsNullOrWhiteSpace(_userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isStreaming || _isDraftingRecipe) return;

        var userMsg = _userInput.Trim();
        _userInput = "";
        _messages.Add(new CookBot.Domain.Interfaces.AiMessage { Role = "user", Content = userMsg });
        // A free-form chat turn invalidates any prior structured-recipe state.
        _lastStructuredRecipe = null;
        _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.

        _isStreaming = true;
        _streamingContent = "";
        StateHasChanged();

        try
        {
            var apiKey = _effectiveAi?.ApiKey;
            var modelId = _effectiveAi?.ModelId;
            var messagesForCall = AssembleMessagesForAiCall();

            await foreach (var chunk in AiService.StreamMessageAsync(_systemPrompt, messagesForCall, apiKey, modelId))
            {
                _streamingContent += chunk;
                StateHasChanged();
            }

            _messages.Add(new CookBot.Domain.Interfaces.AiMessage { Role = "assistant", Content = _streamingContent });
            await SaveConversation();
        }
        catch (Exception ex)
        {
            // UI-SPEC Surface 4: sanitized snackbar copy — never bind raw ex.Message.
            Toast.Show(MapToSanitizedSnackbarCopy(ex.Message), CbToastSeverity.Error);
            _messages.RemoveAt(_messages.Count - 1);
        }
        finally
        {
            _isStreaming = false;
            _streamingContent = "";
            StateHasChanged();
        }
    }

    /// <summary>Submit handler for the explicit "Generate Recipe" button.</summary>
    private async Task GenerateRecipeFromInput()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _isStreaming || _isDraftingRecipe) return;

        var userMsg = _userInput.Trim();
        _userInput = "";
        _messages.Add(new CookBot.Domain.Interfaces.AiMessage { Role = "user", Content = userMsg });
        StateHasChanged();

        await GenerateRecipeAsync(userMsg);
    }

    /// <summary>
    /// AI-02 / AI-03 wiring — runs the IAiRecipeGenerator orchestrator (validate -> repair ->
    /// fail) and updates UI state for Surfaces 1-4 of UI-SPEC. Never throws — the orchestrator
    /// returns a populated StructuredResult on every path.
    /// </summary>
    private async Task GenerateRecipeAsync(string userPrompt)
    {
        _generationCts?.Cancel();
        _generationCts = new CancellationTokenSource();

        _isDraftingRecipe = true;
        _lastStructuredRecipe = null;
        _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.
        StateHasChanged();

        try
        {
            var apiKey = _effectiveAi?.ApiKey;
            var modelId = _effectiveAi?.ModelId;
            var result = await AiRecipeGenerator.GenerateAsync(
                userPrompt, apiKey, modelId, _generationCts.Token);

            _lastStructuredRecipe = result;

            if (result.Ok && result.Value is not null)
            {
                // Add the assistant turn to the conversation. We serialize the canonical
                // RecipeDocument as indented JSON inside a ```json fence so Markdig renders
                // it as a code block — the typed Save flow keys off _lastStructuredRecipe,
                // not on the rendered text.
                var assistantContent = "```json\n" + CanonicalSerializer.SerializeIndented(result.Value) + "\n```";
                _messages.Add(new CookBot.Domain.Interfaces.AiMessage { Role = "assistant", Content = assistantContent });
                await SaveConversation();
            }
            else if (result.SanitizedError is not null && result.Validation is null)
            {
                // Transport / auth / refusal — sanitized snackbar copy.
                Toast.Show(MapToSanitizedSnackbarCopy(result.SanitizedError), CbToastSeverity.Error);
            }
            // else: validation failure — _lastStructuredRecipe drives the DRAFT_FAILED bubble.
        }
        catch (OperationCanceledException)
        {
            // User navigated away or cancelled — silent.
        }
        catch (Exception ex)
        {
            // Defensive: orchestrator promises never to throw, but if a future change breaks
            // that, route through the sanitized snackbar mapper instead of binding ex.Message.
            Toast.Show(MapToSanitizedSnackbarCopy(ex.Message), CbToastSeverity.Error);
        }
        finally
        {
            _isDraftingRecipe = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// UI-SPEC Surface 4 — maps a sanitized error string to a user-facing toast.
    /// The input has already been redacted by SecretRedactor at the IAiService boundary;
    /// this routes well-known failure modes to actionable copy and falls through to the
    /// raw sanitized text otherwise (truncated) so model errors like "invalid model id"
    /// or "rate limit" surface to the user instead of a generic "something went wrong".
    /// </summary>
    private static string MapToSanitizedSnackbarCopy(string? sanitizedError)
    {
        if (string.IsNullOrEmpty(sanitizedError))
            return "Something went wrong with the AI. Please try again.";

        var lower = sanitizedError.ToLowerInvariant();

        if (lower.Contains("401") || lower.Contains("authentication") || lower.Contains("invalid api key") || lower.Contains("invalid x-api-key"))
            return "Could not authenticate with the AI — check your API key in Profile settings.";

        if (lower.Contains("403") || lower.Contains("permission") || lower.Contains("not allowed"))
            return "API key does not have permission for this model. Pick a different model in Profile.";

        if (lower.Contains("404") || lower.Contains("not_found") || lower.Contains("not found") || lower.Contains("model") && lower.Contains("does not exist"))
            return "The configured AI model was not found. Pick a different model in Profile.";

        if (lower.Contains("429") || lower.Contains("rate") && lower.Contains("limit"))
            return "AI rate limit hit. Wait a moment and try again.";

        if (lower.Contains("overloaded") || lower.Contains("503") || lower.Contains("502"))
            return "Anthropic is temporarily overloaded. Try again in a moment.";

        if (lower.Contains("transport failure") || lower.Contains("network") || lower.Contains("timeout") || lower.Contains("refused"))
            return "Could not reach the AI. Check your internet connection and try again.";

        if (lower.Contains("declined"))
            return "The AI declined this request. Try a different prompt.";

        if (lower.Contains("empty content") || lower.Contains("deserialization"))
            return "AI returned a malformed response. Try again or simplify the prompt.";

        // Fallback: surface the actual sanitized error (truncated). The redactor already
        // stripped any API key from the string at the IAiService boundary.
        const int maxLen = 220;
        var trimmed = sanitizedError.Trim();
        if (trimmed.Length > maxLen) trimmed = trimmed[..maxLen] + "…";
        return $"AI error: {trimmed}";
    }

    private async Task SaveRecipeFromMessageAsync()
    {
        if (_lastStructuredRecipe?.Ok != true || _lastStructuredRecipe.Value is null)
        {
            Toast.Show("No recipe is available to save.", CbToastSeverity.Warning);
            return;
        }

        if (!UserService.CurrentUserId.HasValue) return;

        var cookbooks = await DbContext.Cookbooks
            .Where(c => c.UserId == UserService.CurrentUserId.Value)
            .ToListAsync();

        if (!cookbooks.Any())
        {
            Toast.Show("Create a cookbook first!", CbToastSeverity.Warning);
            return;
        }

        // The existing SaveRecipeDialog accepts a serialized recipe string (it parses via
        // IRecipeFormatParser). Serialize the typed RecipeDocument as canonical JSON;
        // RecipeFormatParser.TryParse handles raw-JSON input (the non-frontmatter branch).
        var recipeJson = CanonicalSerializer.SerializeIndented(_lastStructuredRecipe.Value);

        // Phase 7 / Plan 07-01: SaveRecipeDialog migrated to CbDialogService.
        var parameters = new CbDialogParameters
        {
            ["Cookbooks"] = cookbooks,
            ["RecipeContent"] = recipeJson,
        };
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Sm, FullWidth: true);
        var result = await CbDialogService.ShowAsync<SaveRecipeDialog>("Save Recipe to Cookbook", parameters, options);
        if (result != null && !result.Canceled)
        {
            Toast.Show("Recipe saved to cookbook!", CbToastSeverity.Success);
        }
    }

    private async Task CopyRecipeJsonAsync()
    {
        if (_lastStructuredRecipe?.Ok != true || _lastStructuredRecipe.Value is null) return;
        var json = CanonicalSerializer.SerializeIndented(_lastStructuredRecipe.Value);
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            Toast.Show("Recipe JSON copied to clipboard.", CbToastSeverity.Success);
        }
        catch
        {
            Toast.Show("Could not copy to clipboard.", CbToastSeverity.Error);
        }
    }

    [Inject] private IJSRuntime JsRuntime { get; set; } = default!;

    private async Task OpenDraftInEditor()
    {
        if (_lastStructuredRecipe?.RawResponse is null)
        {
            Toast.Show("No draft is available to edit.", CbToastSeverity.Warning);
            return;
        }

        var rawJson = _lastStructuredRecipe.RawResponse.ToJsonString();

        // D-08 primary path: try to coerce via IRecipeFormatParser (parser-route).
        if (Parser.TryParse(rawJson, out var _, out var _))
        {
            // Parser succeeded — open SaveRecipeDialog with the raw JSON; the user can pick a
            // cookbook and the dialog will re-parse + persist (Phase 1 invariant: never persist
            // a non-conforming recipe).
            if (UserService.CurrentUserId.HasValue)
            {
                var cookbooks = await DbContext.Cookbooks
                    .Where(c => c.UserId == UserService.CurrentUserId.Value)
                    .ToListAsync();
                if (cookbooks.Any())
                {
                    // Phase 7 / Plan 07-01: SaveRecipeDialog migrated to CbDialogService.
                    var parameters = new CbDialogParameters
                    {
                        ["Cookbooks"] = cookbooks,
                        ["RecipeContent"] = rawJson,
                    };
                    var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Sm, FullWidth: true);
                    await CbDialogService.ShowAsync<SaveRecipeDialog>("Save Recipe to Cookbook", parameters, options);
                    return;
                }
            }
        }

        // D-09 fallback: parser couldn't coerce — surface the raw JSON for manual edit.
        Toast.Show("The AI draft could not be parsed automatically. Copy it from the chat and paste into the recipe editor.", CbToastSeverity.Info);
    }

    private async Task RetryRecipeGeneration()
    {
        _lastStructuredRecipe = null;
        _aiChatPhotoFailed = false; // PHOTO-12 / PITFALL H4 — reset photo-failure flag alongside the canonical accumulator.
        var lastUserMessage = _messages.LastOrDefault(m => m.Role == "user")?.Content;
        if (!string.IsNullOrEmpty(lastUserMessage))
            await GenerateRecipeAsync(lastUserMessage);
    }

    /// <summary>
    /// D-23 — when the active conversation pre-dates Phase 2 (FormatVersion &lt; 2), prepend a
    /// transient user-role note to the request so the model knows to emit current-format
    /// recipes. The note is NOT persisted to MessagesJson; once SaveConversation re-stamps
    /// FormatVersion = 2 (D-22), the note disappears on subsequent calls.
    /// </summary>
    private List<CookBot.Domain.Interfaces.AiMessage> AssembleMessagesForAiCall()
    {
        var prepared = new List<CookBot.Domain.Interfaces.AiMessage>(_messages);
        if (_currentConversation is { } conv && conv.FormatVersion < 2)
        {
            prepared.Insert(0, new CookBot.Domain.Interfaces.AiMessage
            {
                Role = "user",
                Content = "Note: this conversation's earlier assistant outputs may reference an older recipe format. Emit any new recipes in the current structured format only."
            });
        }
        return prepared;
    }

    private async Task SaveConversation()
    {
        if (!UserService.CurrentUserId.HasValue) return;

        if (_currentConversation == null)
        {
            var title = _messages.First().Content;
            if (title.Length > 50) title = title[..50] + "...";

            _currentConversation = new AiConversation
            {
                UserId = UserService.CurrentUserId.Value,
                Title = title,
            };
            DbContext.AiConversations.Add(_currentConversation);
        }

        _currentConversation.MessagesJson = System.Text.Json.JsonSerializer.Serialize(_messages);
        _currentConversation.UpdatedAt = DateTime.UtcNow;
        // POLISH-06 / D-22: every save stamps the conversation as v2 (Phase 2+). Resumed
        // pre-Phase-2 conversations had FormatVersion=1 (back-fill default in the migration);
        // after the first save in Phase 2 they're indistinguishable from natively-v2 rows.
        _currentConversation.FormatVersion = 2;
        await DbContext.SaveChangesAsync();
        await LoadConversations();
        _selectedConversationId = _currentConversation.Id;
    }

    private async Task<string> ExpandCookbookRecipeTokensAsync(string template, int userId)
    {
        var matches = CookbookRecipeTokenRegex.Matches(template);
        if (matches.Count == 0)
            return template;

        var ids = matches.Select(m => int.Parse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture)).Distinct().ToList();
        var blocks = new Dictionary<int, string>();
        foreach (var id in ids)
            blocks[id] = await FormatCookbookRecipesForPromptAsync(userId, id);

        return CookbookRecipeTokenRegex.Replace(template, m =>
        {
            var id = int.Parse(m.Groups[1].Value, System.Globalization.CultureInfo.InvariantCulture);
            return blocks.TryGetValue(id, out var b) ? b : "";
        });
    }

    private async Task<string> FormatCookbookRecipesForPromptAsync(int userId, int cookbookId)
    {
        var cookbook = await DbContext.Cookbooks
            .AsNoTracking()
            .Include(c => c.Shares)
            .FirstOrDefaultAsync(c => c.Id == cookbookId);

        if (cookbook == null)
            return $"(Cookbook {cookbookId} was not found.)";

        var canAccess = cookbook.UserId == userId
                        || cookbook.Shares.Any(s => s.SharedWithUserId == userId);
        if (!canAccess)
            return $"(Cookbook {cookbookId} is not available to this account.)";

        var names = await DbContext.Recipes.AsNoTracking()
            .Where(r => r.CookbookId == cookbookId)
            .OrderBy(r => r.Name)
            .Select(r => r.Name)
            .ToListAsync();

        if (names.Count == 0)
        {
            return
                $"The user's cookbook \"{cookbook.Name}\" (ID {cookbook.Id}) has no saved recipes yet.";
        }

        var sb = new StringBuilder();
        sb.AppendLine(
            $"The user already has these recipes in cookbook \"{cookbook.Name}\" (ID {cookbook.Id}). Prefer suggesting new ideas or variations that complement this collection:");
        foreach (var n in names)
            sb.AppendLine($"  - {n}");
        return sb.ToString().TrimEnd();
    }

    /// <summary>
    /// AI-08-AUDIT (D-15): rendered through the locked-down pipeline. DisableHtml() strips
    /// raw HTML blocks/inlines so attacker-injected &lt;img src='https://exfil/log'&gt; or
    /// &lt;a href='javascript:...'&gt; cannot reach the DOM. Markdown image syntax is still
    /// parsed; Markdig itself controls the &lt;img&gt; tag generation in that path.
    /// </summary>
    private string RenderContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdig.Markdown.ToHtml(content, AssistantContentPipeline);
    }

    /// <summary>
    /// PHOTO-12 / PITFALL H4 — Blazor-side one-shot debounce for a broken AI-emitted photo URL.
    /// Setting _aiChatPhotoFailed and calling StateHasChanged causes RenderRecipeDocument to
    /// skip the <img> entirely on next render; the browser cannot re-fire onerror because the
    /// element is gone. The flag is cleared everywhere _lastStructuredRecipe is cleared
    /// (new conversation, retry, free-form chat turn, new generation start).
    /// </summary>
    private void HandleAiChatPhotoError()
    {
        _aiChatPhotoFailed = true;
        StateHasChanged();
    }

