    private RenderFragment RenderRecipeDocument(RecipeDocument doc) => __builder =>
    {
        var ingredients = doc.Ingredients;
        var contentSteps = doc.Steps.OfType<ContentStep>().ToList();
        var stepCount = contentSteps.Count;

        @* PHOTO-12 — surface doc.PhotoUrl directly from the canonical accumulator
           (_lastStructuredRecipe.Value).
           POLISH-01 invariant: ONE direct property access on the doc — no extractor,
           no helper, no projection from rendered text. PHOTO-08 referrerpolicy +
           lazy load. PITFALL H4 one-shot debounce via _aiChatPhotoFailed; when the
           flag is set (or doc.PhotoUrl is empty), render NOTHING — the AI canvas
           legitimately can omit a photo and we do not want a striped tile in that case. *@
        @if (!string.IsNullOrEmpty(doc.PhotoUrl) && !_aiChatPhotoFailed)
        {
            <img src="@doc.PhotoUrl"
                 alt="@($"{doc.Name} photo")"
                 referrerpolicy="no-referrer"
                 loading="lazy"
                 @onerror="HandleAiChatPhotoError"
                 style="width:100%;max-height:280px;object-fit:cover;border-radius:12px;margin-bottom:16px;display:block;" />
        }

        <CbEyebrow>
            @{
                var headerParts = new List<string>();
                if (!string.IsNullOrWhiteSpace(doc.Tags?.FirstOrDefault())) headerParts.Add(doc.Tags!.First());
                if (doc.PrepTimeMinutes is int p && doc.CookTimeMinutes is int c) headerParts.Add($"{p + c} min");
                else if (doc.CookTimeMinutes is int c2) headerParts.Add($"{c2} min");
                else if (doc.PrepTimeMinutes is int p2) headerParts.Add($"{p2} min");
                if (doc.Servings > 0) headerParts.Add($"serves {doc.Servings}");
            }
            @string.Join(" · ", headerParts.DefaultIfEmpty("recipe"))
        </CbEyebrow>

        <h1 style="font-size:44px;line-height:1.05;letter-spacing:-0.03em;margin:12px 0 14px 0;text-wrap:balance;">
            @doc.Name
        </h1>

        @if (doc.Tags is { Count: > 0 } tags)
        {
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:24px;">
                @foreach (var tag in tags.Take(8))
                {
                    <CbChip Variant="CbChip.CbChipVariant.Tag" Label="@tag" />
                }
            </div>
        }
        else
        {
            <div style="margin-bottom:14px;"></div>
        }

        <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:36px;">
            @* Ingredients *@
            <div>
                <CbEyebrow>Ingredients</CbEyebrow>
                <div style="margin-top:10px;">
                    @foreach (var ing in ingredients)
                    {
                        <div style="display:flex;gap:12px;padding:8px 0;border-bottom:1px solid var(--line);font-size:14px;">
                            <span class="num" style="width:90px;color:var(--ink-2);font-weight:500;flex-shrink:0;">
                                @FormatIngredientQuantity(ing)
                            </span>
                            <span style="color:var(--ink-2);">
                                @ing.Name@(string.IsNullOrEmpty(ing.Note) ? "" : $", {ing.Note}")
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Method *@
            <div>
                <CbEyebrow>Method</CbEyebrow>
                <div style="margin-top:10px;">
                    @{
                        var contentIndex = 0;
                    }
                    @foreach (var step in doc.Steps)
                    {
                        if (step is ContentStep cs)
                        {
                            var stepIdx = contentIndex;
                            var isLast = stepIdx == stepCount - 1;
                            var numStyle = isLast
                                ? "width:28px;height:28px;border-radius:14px;background:var(--accent-soft);display:grid;place-items:center;font-size:13px;font-weight:600;color:var(--accent);flex-shrink:0;"
                                : "width:28px;height:28px;border-radius:14px;background:var(--cream-2);display:grid;place-items:center;font-size:13px;font-weight:600;color:var(--ink-2);flex-shrink:0;";
                            <div style="display:flex;gap:16px;padding:12px 0;border-bottom:1px solid var(--line);">
                                <span class="num" style="@numStyle">@(stepIdx + 1)</span>
                                <span style="font-size:14px;line-height:1.55;color:var(--ink-2);">
                                    @cs.Text
                                </span>
                            </div>
                            contentIndex++;
                        }
                        else if (step is SectionStep ss)
                        {
                            <div style="padding:14px 0 6px 0;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-3);font-weight:600;">
                                @ss.Heading
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    };

