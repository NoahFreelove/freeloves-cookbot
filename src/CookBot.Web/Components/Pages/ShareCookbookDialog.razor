@* Phase 7 / Plan 07-01: cookbook share + export dialog.
   Renders inside CbDialogHost; the People/Export tabs are a small inline
   segmented-button switcher. Existing PDF export (CookbookPdfService via
   QuestPDF) is preserved verbatim through CookbookDownloadHelper. *@
@inject CurrentUserService UserService
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookbookTransferService TransferService
@inject CookbookPdfService PdfService
@inject IJSRuntime JS
@inject ICbToastService Toast

<div>
    @* Tab strip *@
    <div role="tablist" aria-label="Share or export"
         style="display:inline-flex;background:var(--cream-2);border-radius:999px;padding:2px;gap:2px;margin-bottom:18px;">
        <button type="button"
                role="tab"
                aria-selected="@(_tab == Tab.People)"
                class="@(_tab == Tab.People ? "cb-btn" : "cb-btn ghost")"
                style="padding:6px 14px;font-size:13px;border-radius:999px;@(_tab == Tab.People ? "" : "background:transparent;border:0;")"
                @onclick="() => _tab = Tab.People">
            People
        </button>
        <button type="button"
                role="tab"
                aria-selected="@(_tab == Tab.Export)"
                class="@(_tab == Tab.Export ? "cb-btn" : "cb-btn ghost")"
                style="padding:6px 14px;font-size:13px;border-radius:999px;@(_tab == Tab.Export ? "" : "background:transparent;border:0;")"
                @onclick="() => _tab = Tab.Export">
            Export
        </button>
    </div>

    @if (_tab == Tab.People)
    {
        @if (_sharedWith.Any())
        {
            <div style="font-size:13px;color:var(--ink-2);font-weight:500;margin-bottom:8px;">Currently shared with:</div>
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:16px;">
                @foreach (var share in _sharedWith)
                {
                    <div style="display:flex;align-items:center;gap:10px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;">
                        <Icon Name="@Icon.Names.User" Size="14" />
                        <span style="flex:1;font-size:13.5px;">@share.SharedWithUser.DisplayName</span>
                        <button type="button" class="cb-btn ghost" style="padding:4px;"
                                aria-label="Remove share"
                                @onclick="@(() => RemoveShare(share))">
                            <Icon Name="@Icon.Names.Trash" Size="14" />
                        </button>
                    </div>
                }
            </div>
            <div style="height:1px;background:var(--line);margin-bottom:16px;"></div>
        }

        <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:12px;">
            <span>Share with user</span>
            <CbSelect TValue="int" Value="_selectedUserId" ValueChanged="@((int v) => _selectedUserId = v)">
                @foreach (var user in _availableUsers)
                {
                    <CbOption TValue="int" Value="@user.Id" Label="@user.DisplayName" />
                }
            </CbSelect>
        </label>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" FullWidth="true"
                  OnClick="AddShare" Disabled="@(_selectedUserId == 0)">
            Share with selected user
        </CbButton>
    }
    else
    {
        <p style="font-size:13.5px;color:var(--ink-2);line-height:1.5;margin:0 0 14px 0;">
            Download a PDF for printing or emailing, or a JSON file for backup and import into another account.
        </p>
        <div style="display:flex;flex-direction:column;gap:8px;">
            <CbButton Variant="CbButton.CbButtonVariant.Primary"
                      StartIcon="@Icon.Names.Download"
                      OnClick="DownloadPdfAsync" Disabled="_exportBusy">
                Download PDF
            </CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                      StartIcon="@Icon.Names.Save"
                      OnClick="DownloadJsonAsync" Disabled="_exportBusy">
                Download JSON
            </CbButton>
        </div>
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:24px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Close</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }
    [Parameter] public int CookbookId { get; set; }
    [Parameter] public string CookbookName { get; set; } = "";

    private enum Tab { People, Export }
    private Tab _tab = Tab.People;

    private List<CookbookShare> _sharedWith = new();
    private List<User> _availableUsers = new();
    private int _selectedUserId;
    private bool _exportBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadShares();
    }

    private async Task LoadShares()
    {
        _sharedWith = await DbContext.CookbookShares
            .Include(cs => cs.SharedWithUser)
            .Where(cs => cs.CookbookId == CookbookId)
            .ToListAsync();

        var sharedUserIds = _sharedWith.Select(s => s.SharedWithUserId).ToHashSet();
        var ownerId = (await DbContext.Cookbooks.FindAsync(CookbookId))?.UserId ?? 0;
        sharedUserIds.Add(ownerId);

        _availableUsers = await DbContext.Users
            .Where(u => !sharedUserIds.Contains(u.Id))
            .OrderBy(u => u.DisplayName)
            .ToListAsync();

        _selectedUserId = _availableUsers.FirstOrDefault()?.Id ?? 0;
    }

    private void Cancel() => DialogInstance?.Close(CbDialogResult.Ok(null));

    private async Task AddShare()
    {
        if (_selectedUserId == 0) return;

        DbContext.CookbookShares.Add(new CookbookShare
        {
            CookbookId = CookbookId,
            SharedWithUserId = _selectedUserId,
        });
        await DbContext.SaveChangesAsync();
        Toast.Show("Cookbook shared!", CbToastSeverity.Success);
        await LoadShares();
        StateHasChanged();
    }

    private async Task RemoveShare(CookbookShare share)
    {
        DbContext.CookbookShares.Remove(share);
        await DbContext.SaveChangesAsync();
        Toast.Show("Share removed.", CbToastSeverity.Info);
        await LoadShares();
        StateHasChanged();
    }

    private async Task DownloadPdfAsync()
    {
        if (!UserService.CurrentUserId.HasValue) return;
        _exportBusy = true;
        try
        {
            await CookbookDownloadHelper.TryDownloadPdfAsync(
                TransferService, PdfService, JS, CookbookId, UserService.CurrentUserId.Value, Toast);
        }
        finally
        {
            _exportBusy = false;
        }
    }

    private async Task DownloadJsonAsync()
    {
        if (!UserService.CurrentUserId.HasValue) return;
        _exportBusy = true;
        try
        {
            await CookbookDownloadHelper.TryDownloadJsonAsync(
                TransferService, JS, CookbookId, UserService.CurrentUserId.Value, Toast);
        }
        finally
        {
            _exportBusy = false;
        }
    }
}
