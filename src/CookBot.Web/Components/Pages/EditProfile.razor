@page "/profile"
@using System.Text.Json
@using CookBot.Domain.Interfaces
@using CookBot.Infrastructure.AI
@using CookBot.Application.DTOs
@using CookBot.Application.Services
@using Microsoft.AspNetCore.DataProtection
@implements IDisposable
@inject CurrentUserService UserService
@inject Microsoft.Extensions.Options.IOptions<CookBotSettings> CookBotSettingsOptions
@inject ICbToastService Toast
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject IAiService AiService
@inject AiApiKeyResolutionService AiKeyResolver
@inject AiApiKeyShareService AiKeyShareService
@inject ICbDialogService CbDialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtectionProvider
@rendermode InteractiveServer

@* EditProfile — Phase 7 / Plan 07-05 / PROF-01 + PROF-02.
   Full rewrite against Phase 5 atoms. Settings grouped into <CbCard> cards:
     1. Display name — CbInput + Save
     2. Account password — CbInput type=password + Set/Change/Remove
     3. AI features — CbToggle bound to UserProfile.AiEnabled (sidebar AI rows
        re-check via Sidebar.OnAfterRenderAsync; toggling triggers a forceLoad
        navigation so the whole shell re-evaluates the AI-off contract)
     4. API key + Model + Shared keys (visible when AI enabled)
     5. Cooking preferences — Experience level, Unit system, Custom unit notes
     6. Theme & density — CbToggle bound to localStorage + cookbot.setDensity JS interop
     7. Kitchen tools — chip multi-select
     8. Dietary preferences — chip multi-select
   ZERO Mud* components. SharedKeysDialog is launched via CbDialogService. *@

<PageTitle>CookBot - Profile</PageTitle>

<div style="max-width:880px;display:flex;flex-direction:column;gap:18px;">
    <h1 style="margin:0;font-size:22px;font-weight:600;letter-spacing:-0.01em;color:var(--ink);">My Profile</h1>

    @if (_user != null && _profile != null)
    {
        <!-- Display name -->
        <CbCard>
            <CbEyebrow>Display name</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                Shown in the user switcher and on shared cookbooks.
            </p>
            <div style="display:flex;gap:8px;align-items:center;">
                <div style="flex:1;">
                    <CbInput Value="@_displayNameEdit" ValueChanged="@((string? v) => _displayNameEdit = v ?? "")"
                             Placeholder="Display name" />
                </div>
                <CbButton Variant="CbButton.CbButtonVariant.Primary" StartIcon="@Icon.Names.Save"
                          OnClick="SaveDisplayName"
                          Disabled="@(string.IsNullOrWhiteSpace(_displayNameEdit) || _displayNameEdit == _user.DisplayName)">
                    Save
                </CbButton>
            </div>
        </CbCard>

        <!-- Account password -->
        <CbCard>
            <CbEyebrow>Account password</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                @if (_hasPassword)
                {
                    <text>This account is password-protected.</text>
                }
                else
                {
                    <text>No password set. Anyone can switch to this account.</text>
                }
            </p>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                <div style="flex:1;min-width:220px;">
                    <CbInput Type="password" Value="@_newPassword"
                             ValueChanged="@((string? v) => _newPassword = v ?? "")"
                             Placeholder="@(_hasPassword ? "New password" : "Set password")" />
                </div>
                <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="SetPassword"
                          Disabled="@string.IsNullOrWhiteSpace(_newPassword)">
                    @(_hasPassword ? "Change password" : "Set password")
                </CbButton>
                @if (_hasPassword)
                {
                    <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="RemovePassword">
                        Remove password
                    </CbButton>
                }
            </div>
        </CbCard>

        <!-- Accent color (ordinal #3 — W-05 card-order contract, Plan 10-12 QOL-05) -->
        <CbCard>
            <CbEyebrow>Accent color</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                Changes the highlight color across the app. Saved in your browser only.
            </p>
            <div style="display:flex;flex-direction:column;gap:8px;">
                <CbRadio TValue="string" GroupName="accent" Value="@("orange")" CurrentValue="@_accent" CurrentValueChanged="OnAccentChanged" Label="Default" />
                <CbRadio TValue="string" GroupName="accent" Value="@("terracotta")" CurrentValue="@_accent" CurrentValueChanged="OnAccentChanged" Label="Terracotta" />
                <CbRadio TValue="string" GroupName="accent" Value="@("sage")" CurrentValue="@_accent" CurrentValueChanged="OnAccentChanged" Label="Sage" />
            </div>
        </CbCard>

        <!-- AI assistant instructions (ordinal #4 — W-05 card-order contract, Plan 10-07 QOL-06) -->
        <CbCard>
            <CbEyebrow>AI assistant instructions</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">Customize how CookBot's AI introduces itself. Variables expand at request time.</p>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;">
                @foreach (var token in PromptTokens)
                {
                    var t = token;
                    <button type="button" class="cb-chip" style="cursor:pointer;border:0;" @onclick="@(() => InsertToken(t))">@t</button>
                }
            </div>
            <textarea id="@_promptTextareaId"
                      value="@_promptTemplate"
                      @oninput="@((ChangeEventArgs e) => _promptTemplate = e.Value as string ?? "")"
                      rows="12"
                      style="width:100%;font-family:var(--font-mono);font-size:13px;resize:vertical;min-height:240px;"
                      aria-label="Custom AI system prompt template"></textarea>
            <CbCard Padding="14" Style="background:var(--accent-soft);margin-top:12px;">
                <strong style="font-size:13px;">About custom prompts</strong>
                <p style="margin:6px 0 0 0;font-size:12.5px;color:var(--ink-2);line-height:1.5;">Your custom template is injected verbatim into the system prompt. CookBot's PromptInjectionGuard wraps user-supplied <em>content</em>, but not the system template itself. Avoid instructions that tell the model to disregard or override the rest of the prompt.</p>
            </CbCard>
            <div style="display:flex;gap:8px;margin-top:12px;justify-content:flex-end;">
                <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="ConfirmResetPromptAsync">Reset to default</CbButton>
                <CbButton Variant="CbButton.CbButtonVariant.Primary" StartIcon="@Icon.Names.Save" OnClick="SavePromptTemplateAsync">Save</CbButton>
            </div>
        </CbCard>

        <!-- AI features toggle -->
        <CbCard>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;">
                <div style="flex:1;">
                    <CbEyebrow>AI features</CbEyebrow>
                    @if (!CookBotSettingsOptions.Value.AiFeaturesEnabled)
                    {
                        <p style="margin:6px 0 0 0;font-size:13px;color:var(--ink-3);">
                            The server has turned off optional AI features. Assistant, prompt builder,
                            and related controls are hidden. No recipe or pantry data is sent to external
                            services from this app unless you use other tools yourself.
                        </p>
                    }
                    else
                    {
                        <p style="margin:6px 0 0 0;font-size:13px;color:var(--ink-3);">
                            When off, all AI surfaces are hidden across the app — sidebar Assistant + Prompt
                            Builder rows, AI buttons in Pantry, AI suggestion cards on Home. Your API key
                            and model selection stay saved.
                        </p>
                    }
                </div>
                @if (CookBotSettingsOptions.Value.AiFeaturesEnabled)
                {
                    <CbToggle Value="_profile.AiEnabled" ValueChanged="OnAiEnabledChanged"
                              Label="@(_profile.AiEnabled ? "On" : "Off")" />
                }
            </div>
        </CbCard>

        @if (CookBotSettingsOptions.Value.AiFeaturesEnabled && _profile.AiEnabled)
        {
            <!-- API key + Model + Shared keys -->
            <CbCard>
                <CbEyebrow>API key &amp; model</CbEyebrow>
                <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                    Stored in your local database (not encrypted unless you encrypt the database file at
                    the host level). Shared keys let other users on this server use your key without ever
                    seeing it.
                </p>

                @if (_usingSharedKeyOnly && !_forceShowOwnKeyFields)
                {
                    <div class="cb-card" style="background:var(--accent-soft);color:var(--accent-ink);padding:12px;margin-bottom:14px;border:none;">
                        Using API access shared by <strong>@(_effectiveAi?.SharedFromDisplayName ?? "another user")</strong>.
                        The key is never shown to you. Model and billing follow their Profile settings.
                        @if (_incomingShareCount > 1)
                        {
                            <div style="margin-top:6px;font-size:12.5px;">
                                Several people share with you. Open Shared keys to choose whose key to use.
                            </div>
                        }
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <CbButton Variant="CbButton.CbButtonVariant.Accent" StartIcon="@Icon.Names.Share"
                                  OnClick="OpenSharedKeysDialog">
                            Manage shared keys
                        </CbButton>
                        <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                                  OnClick="@(() => { _forceShowOwnKeyFields = true; })">
                            Use my own API key instead
                        </CbButton>
                    </div>
                }
                else
                {
                    @if (_incomingSharesButNoUsableKey)
                    {
                        <div class="cb-card" style="background:var(--warn-soft);color:var(--warn);padding:12px;margin-bottom:14px;border:none;">
                            Someone shared access with you, but <strong>none of those accounts have a
                            saved API key</strong> yet. They need to save a key, or enter your own below.
                        </div>
                    }
                    else if (_pendingShareChoice)
                    {
                        <div class="cb-card" style="background:var(--warn-soft);color:var(--warn);padding:12px;margin-bottom:14px;border:none;">
                            @if (_incomingUsableCount > 1)
                            {
                                <text>Several people can share a key with you. Open <strong>Shared keys</strong>
                                to choose whose key to use, or enter your own below.</text>
                            }
                            else
                            {
                                <text>Shared access could not be activated. Open <strong>Shared keys</strong>
                                to check the offer, or enter your own key below.</text>
                            }
                        </div>
                    }

                    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:14px;">
                        <span>Anthropic API key</span>
                        <CbInput Type="password" @bind-Value="_aiApiKeyEdit"
                                 Placeholder="sk-ant-..." />
                        <span style="font-size:11.5px;color:var(--ink-4);">
                            Not auto-saved. Click Save AI settings below to store in your local database.
                        </span>
                    </label>

                    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:14px;">
                        <span>Model</span>
                        <div style="display:flex;gap:8px;align-items:flex-end;">
                            <div style="flex:1;">
                                <CbSelect TValue="string" @bind-Value="_selectedModelId">
                                    @foreach (var model in _availableModels)
                                    {
                                        <CbOption TValue="string" Value="@model.Id" Label="@model.DisplayName" />
                                    }
                                </CbSelect>
                            </div>
                            <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                                      OnClick="FetchModels"
                                      Disabled="@((string.IsNullOrWhiteSpace(_aiApiKeyEdit) && _effectiveAi == null) || _isFetchingModels)">
                                @(_isFetchingModels ? "Fetching..." : "Fetch models")
                            </CbButton>
                        </div>
                        <span style="font-size:11.5px;color:var(--ink-4);">
                            Curated models match <code>AnthropicAiService</code> in the source tree. Use
                            &quot;Fetch models&quot; to refresh from the API.
                        </span>
                    </label>

                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <CbButton Variant="CbButton.CbButtonVariant.Primary" StartIcon="@Icon.Names.Save"
                                  OnClick="SaveAiSettings">
                            Save AI settings
                        </CbButton>
                        <CbButton Variant="CbButton.CbButtonVariant.Ghost" StartIcon="@Icon.Names.Share"
                                  OnClick="OpenSharedKeysDialog">
                            Manage shared keys
                        </CbButton>
                    </div>
                }
            </CbCard>

            <!-- Cooking preferences (AI) -->
            <CbCard>
                <CbEyebrow>Cooking preferences</CbEyebrow>
                <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                    Used by the assistant, prompt builder, and AI pantry tools. Saved automatically when
                    you change something.
                </p>

                <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:14px;">
                    <span>Experience level</span>
                    <CbSelect TValue="ExperienceLevel" Value="_profile.ExperienceLevel"
                              ValueChanged="@(async (ExperienceLevel v) => await OnExperienceLevelChanged(v))">
                        @foreach (ExperienceLevel level in Enum.GetValues<ExperienceLevel>())
                        {
                            <CbOption TValue="ExperienceLevel" Value="@level" Label="@level.ToString()" />
                        }
                    </CbSelect>
                </label>

                <div style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:14px;">
                    <span>Unit system preset</span>
                    <div style="display:flex;flex-direction:column;gap:8px;">
                        <CbRadio TValue="UnitSystem" GroupName="unit-system"
                                 Value="UnitSystem.Canadian" CurrentValue="_profile.UnitSystem"
                                 CurrentValueChanged="OnUnitSystemChanged"
                                 Label="Canadian (cups, tbsp, grams, kg, Fahrenheit)" />
                        <CbRadio TValue="UnitSystem" GroupName="unit-system"
                                 Value="UnitSystem.Imperial" CurrentValue="_profile.UnitSystem"
                                 CurrentValueChanged="OnUnitSystemChanged"
                                 Label="Imperial (cups, oz, lbs, Fahrenheit)" />
                        <CbRadio TValue="UnitSystem" GroupName="unit-system"
                                 Value="UnitSystem.Metric" CurrentValue="_profile.UnitSystem"
                                 CurrentValueChanged="OnUnitSystemChanged"
                                 Label="Metric (mL, g, kg, Celsius)" />
                    </div>
                </div>

                <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);">
                    <span>Custom unit notes for AI</span>
                    <CbTextarea Value="@(_profile.AiUnitExceptions ?? "")"
                                ValueChanged="@((string? v) => OnAiUnitExceptionsChanged(v ?? string.Empty))"
                                Placeholder="Optional. Add exceptions to the preset (e.g. always use sticks of butter, weigh salt in grams, oven in °F only)."
                                Rows="3" />
                </label>
            </CbCard>
        }

        <!-- Theme & density -->
        <CbCard>
            <CbEyebrow>Theme &amp; density</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                Compact density tightens row heights and gaps across all surfaces. Persists across sessions.
            </p>
            <CbToggle Value="_isCompactDensity" ValueChanged="OnDensityChanged"
                      Label="@(_isCompactDensity ? "Compact" : "Comfy")" />
        </CbCard>

        <!-- Equipment -->
        <CbCard>
            <CbEyebrow>Kitchen tools</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                Tap to add or remove. Saved automatically.
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
                @foreach (var tool in _availableTools)
                {
                    var isSelected = _kitchenTools.Contains(tool);
                    var variant = isSelected ? CbChip.CbChipVariant.Timer : CbChip.CbChipVariant.Tag;
                    <button type="button"
                            class="@(isSelected ? "cb-chip timer" : "cb-chip tag")"
                            style="cursor:pointer;border-color:var(--line);background:@(isSelected ? "var(--accent-soft)" : "transparent");color:@(isSelected ? "var(--accent-ink)" : "var(--ink-2)");"
                            aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                            @onclick="@(() => ToggleTool(tool))">
                        @tool
                    </button>
                }
            </div>
        </CbCard>

        <!-- Dietary preferences -->
        <CbCard>
            <CbEyebrow>Dietary preferences</CbEyebrow>
            <p style="margin:6px 0 14px 0;font-size:13px;color:var(--ink-3);">
                Tap to add or remove. Saved automatically.
            </p>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
                @foreach (var diet in _availableDiets)
                {
                    var isSelected = _dietaryPrefs.Contains(diet);
                    <button type="button"
                            class="@(isSelected ? "cb-chip ing" : "cb-chip tag")"
                            style="cursor:pointer;border-color:var(--line);"
                            aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                            @onclick="@(() => ToggleDiet(diet))">
                        @diet
                    </button>
                }
            </div>
        </CbCard>
    }
    else
    {
        <CbCard>
            <p style="margin:0;color:var(--ink-3);">Please select a user first.</p>
        </CbCard>
    }
</div>

@code {
    private User? _user;
    private UserProfile? _profile;
    private HashSet<string> _kitchenTools = new();
    private HashSet<string> _dietaryPrefs = new();
    private string _newPassword = "";
    private string _aiApiKeyEdit = "";
    private string _displayNameEdit = "";
    private bool _hasPassword;
    private List<AiModelInfo> _availableModels = AnthropicAiService.CuratedModels;
    private bool _isFetchingModels;
    private string _selectedModelId = AnthropicAiService.DefaultModelId;
    private EffectiveAiCredentials? _effectiveAi;
    private int _incomingShareCount;
    private int _incomingUsableCount;
    private bool _forceShowOwnKeyFields;
    private bool _isCompactDensity;
    private string _accent = "orange";

    // QOL-06 / Plan 10-07: AI assistant instructions prompt editor
    private static readonly string[] PromptTokens =
    {
        "{{experience_level}}", "{{unit_system}}", "{{equipment}}",
        "{{dietary_preferences}}", "{{pantry}}", "{{recipe_format}}"
    };
    private string _promptTemplate = "";
    private string _promptTextareaId = "";

    private bool _hasOwnKey => !string.IsNullOrWhiteSpace(_profile?.AiApiKey);
    private bool _usingSharedKeyOnly => !_hasOwnKey && _effectiveAi?.SharedFromUserId != null;
    /// <summary>Incoming shares exist but no owner currently has a key (cannot resolve).</summary>
    private bool _incomingSharesButNoUsableKey =>
        !_hasOwnKey && _effectiveAi == null && _incomingShareCount > 0 && _incomingUsableCount == 0;
    /// <summary>Must pick a sharer (or fix access) in Shared keys.</summary>
    private bool _pendingShareChoice =>
        !_hasOwnKey && _effectiveAi == null && _incomingUsableCount >= 1;

    private readonly string[] _availableTools =
    {
        "Oven", "Stovetop", "Microwave", "Air Fryer", "Slow Cooker", "Instant Pot",
        "Stand Mixer", "Hand Mixer", "Food Processor", "Blender", "Immersion Blender",
        "Grill", "Smoker", "Sous Vide", "Dutch Oven", "Cast Iron Skillet", "Wok",
        "Bread Machine", "Toaster Oven", "Pressure Cooker", "Rice Cooker",
        "Waffle Iron", "Mandoline", "Mortar and Pestle", "Pizza Stone",
        "Springform Pan", "Muffin Tin", "Bundt Pan", "Rolling Pin",
        "Thermometer", "Kitchen Scale", "Pasta Maker", "Ice Cream Maker",
        "Dehydrator", "Deep Fryer", "Griddle", "Torch", "Steamer Basket"
    };

    private readonly string[] _availableDiets =
    {
        "Vegetarian", "Gluten Free", "High Protein", "Low Carb"
    };

    private int? _loadedUserId;
    private bool _isLoadingProfile;
    private CancellationTokenSource? _prefsDebounceCts;

    // PROD-08 (Phase 9 / Plan 09-04) — encrypt the key before it lands in cookbot.db.
    // Single shared scope "AiApiKey.v1"; the matching Unprotect call lives in
    // AiApiKeyResolutionService and DatabaseSeeder, so all three sites round-trip.
    private Microsoft.AspNetCore.DataProtection.IDataProtector? _protector;

    protected override void OnInitialized()
    {
        _protector = DataProtectionProvider.CreateProtector("AiApiKey.v1");
        _promptTextareaId = $"prompt-editor-textarea-{Guid.NewGuid():N}";
        base.OnInitialized();
    }

    /// <summary>
    /// Phase 9 / Plan 09-04 — bridge stored ciphertext → editor plaintext. Legacy
    /// plaintext rows (pre-encryption) flow through unchanged; the DatabaseSeeder
    /// will re-encrypt them on next boot. Mirrors the gating logic in
    /// AiApiKeyResolutionService.DecryptIfNeeded so all three sites agree.
    /// </summary>
    private string DecryptForEditor(string? stored)
    {
        if (string.IsNullOrEmpty(stored)) return "";
        if (!CookBot.Infrastructure.Data.DatabaseSeeder.LooksLikeDataProtectionCiphertext(stored)) return stored;
        try { return _protector!.Unprotect(stored); }
        catch { return ""; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (UserService.CurrentUserId.HasValue && _loadedUserId != UserService.CurrentUserId.Value)
        {
            _loadedUserId = UserService.CurrentUserId.Value;
            _isLoadingProfile = true;
            _user = await UserService.GetCurrentUserAsync();
            if (_user != null)
            {
                _profile = _user.Profile;
                _hasPassword = _user.PasswordHash != null;
                _kitchenTools = JsonSerializer.Deserialize<HashSet<string>>(_profile.KitchenToolsJson) ?? new();
                _dietaryPrefs = JsonSerializer.Deserialize<HashSet<string>>(_profile.DietaryPreferencesJson) ?? new();
                _selectedModelId = _profile.AiModel ?? AnthropicAiService.DefaultModelId;
                // Phase 9 / Plan 09-04 / PROD-08 — the row may now be ciphertext-on-disk.
                // Decrypt for the editor so the user sees what they typed last (the password-masked
                // field still hides it visually), and so a no-op Save round-trips cleanly via Protect.
                _aiApiKeyEdit = DecryptForEditor(_profile.AiApiKey);
                _displayNameEdit = _user.DisplayName;
                _promptTemplate = _profile.AiSystemPromptTemplate ?? "";
                _forceShowOwnKeyFields = false;
                _effectiveAi = await AiKeyResolver.ResolveAsync(_loadedUserId!.Value);
                _incomingShareCount = (await AiKeyShareService.ListIncomingAsync(_loadedUserId.Value)).Count;
                _incomingUsableCount =
                    (await AiKeyShareService.ListIncomingWithUsableOwnerKeyAsync(_loadedUserId.Value)).Count;
            }
            _isLoadingProfile = false;
            StateHasChanged();
        }

        if (firstRender)
        {
            // Read persisted density preference and reflect it in the toggle state.
            try
            {
                var density = await JS.InvokeAsync<string>("cookbot.getDensity");
                var compact = density == "compact";
                if (compact != _isCompactDensity)
                {
                    _isCompactDensity = compact;
                    StateHasChanged();
                }
            }
            catch (InvalidOperationException) { /* prerender — ignore */ }

            // Read persisted accent preference (QOL-05 / Plan 10-12).
            try
            {
                _accent = await JS.InvokeAsync<string?>("localStorage.getItem", "cookbot_accent") ?? "orange";
                if (_accent != "orange" && _accent != "terracotta" && _accent != "sage") _accent = "orange";
                StateHasChanged();
            }
            catch { _accent = "orange"; }
        }
    }

    private async Task OpenSharedKeysDialog()
    {
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Md, FullWidth: true);
        var result = await CbDialogService.ShowAsync<SharedKeysDialog>("Shared API keys", null, options);
        if (result != null && !result.Canceled && _loadedUserId is int uid)
        {
            _user = await UserService.GetCurrentUserAsync();
            if (_user != null)
                _profile = _user.Profile;
            _effectiveAi = await AiKeyResolver.ResolveAsync(uid);
            _incomingShareCount = (await AiKeyShareService.ListIncomingAsync(uid)).Count;
            _incomingUsableCount = (await AiKeyShareService.ListIncomingWithUsableOwnerKeyAsync(uid)).Count;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _prefsDebounceCts?.Cancel();
        _prefsDebounceCts?.Dispose();
    }

    private async Task DebouncedSavePreferencesAsync()
    {
        if (_isLoadingProfile || _user == null || _profile == null) return;

        _prefsDebounceCts?.Cancel();
        _prefsDebounceCts?.Dispose();
        _prefsDebounceCts = new CancellationTokenSource();
        var token = _prefsDebounceCts.Token;
        try
        {
            await Task.Delay(450, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await PersistPreferencesAsync();
    }

    private async Task PersistPreferencesAsync()
    {
        if (_isLoadingProfile || _user == null || _profile == null) return;

        _profile.KitchenToolsJson = JsonSerializer.Serialize(_kitchenTools);
        _profile.DietaryPreferencesJson = JsonSerializer.Serialize(_dietaryPrefs);
        DbContext.Users.Update(_user);
        DbContext.UserProfiles.Update(_profile);
        await DbContext.SaveChangesAsync();
    }

    private async Task SaveDisplayName()
    {
        if (_user == null || string.IsNullOrWhiteSpace(_displayNameEdit)) return;
        _user.DisplayName = _displayNameEdit.Trim();
        DbContext.Users.Update(_user);
        await DbContext.SaveChangesAsync();
        Toast.Show("Display name saved.", CbToastSeverity.Success);
    }

    private async Task OnExperienceLevelChanged(ExperienceLevel value)
    {
        if (_profile == null || _isLoadingProfile) return;
        _profile.ExperienceLevel = value;
        await DebouncedSavePreferencesAsync();
    }

    private async Task OnUnitSystemChanged(UnitSystem value)
    {
        if (_profile == null || _isLoadingProfile) return;
        _profile.UnitSystem = value;
        await DebouncedSavePreferencesAsync();
    }

    private async Task OnAiUnitExceptionsChanged(string value)
    {
        if (_profile == null || _isLoadingProfile) return;
        _profile.AiUnitExceptions = string.IsNullOrWhiteSpace(value) ? null : value;
        await DebouncedSavePreferencesAsync();
    }

    private async Task ToggleTool(string tool)
    {
        if (_isLoadingProfile) return;
        if (!_kitchenTools.Add(tool))
            _kitchenTools.Remove(tool);
        await DebouncedSavePreferencesAsync();
    }

    private async Task ToggleDiet(string diet)
    {
        if (_isLoadingProfile) return;
        if (!_dietaryPrefs.Add(diet))
            _dietaryPrefs.Remove(diet);
        await DebouncedSavePreferencesAsync();
    }

    private async Task SetPassword()
    {
        if (_user == null || string.IsNullOrWhiteSpace(_newPassword)) return;
        _user.PasswordHash = CurrentUserService.HashPassword(_newPassword);
        await DbContext.SaveChangesAsync();
        _hasPassword = true;
        _newPassword = "";
        Toast.Show("Password set.", CbToastSeverity.Success);
    }

    private async Task RemovePassword()
    {
        if (_user == null) return;
        _user.PasswordHash = null;
        await DbContext.SaveChangesAsync();
        _hasPassword = false;
        Toast.Show("Password removed.", CbToastSeverity.Info);
    }

    private async Task FetchModels()
    {
        var key = !string.IsNullOrWhiteSpace(_aiApiKeyEdit) ? _aiApiKeyEdit.Trim() : _effectiveAi?.ApiKey;
        if (string.IsNullOrWhiteSpace(key)) return;
        _isFetchingModels = true;
        StateHasChanged();
        try
        {
            var models = await AiService.ListModelsAsync(key);
            if (models.Any())
            {
                _availableModels = models;
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Failed to fetch models: {ex.Message}", CbToastSeverity.Error);
        }
        finally
        {
            _isFetchingModels = false;
            StateHasChanged();
        }
    }

    private async Task OnAiEnabledChanged(bool value)
    {
        if (_profile == null) return;
        _profile.AiEnabled = value;
        DbContext.UserProfiles.Update(_profile);
        await DbContext.SaveChangesAsync();
        // Force a full reload so Sidebar / TopBar / cascading values re-evaluate the
        // AI-off contract from a fresh circuit. Mirrors the previous Mud-based behavior.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task SaveAiSettings()
    {
        if (_profile == null || _user == null) return;
        // Phase 9 / Plan 09-04 / PROD-08 — encrypt the plaintext key before it lands in the DB.
        // _aiApiKeyEdit is decrypted on load (DecryptForEditor) and re-encrypted here on save so
        // a no-op Save round-trips through Protect/Unprotect without double-encryption.
        _profile.AiApiKey = string.IsNullOrWhiteSpace(_aiApiKeyEdit)
            ? null
            : _protector!.Protect(_aiApiKeyEdit.Trim());
        _profile.AiModel = _selectedModelId;
        if (!string.IsNullOrWhiteSpace(_profile.AiApiKey))
            _profile.AiSharedKeyOwnerUserId = null;
        DbContext.UserProfiles.Update(_profile);
        await DbContext.SaveChangesAsync();
        _effectiveAi = await AiKeyResolver.ResolveAsync(_user.Id);
        _incomingShareCount = (await AiKeyShareService.ListIncomingAsync(_user.Id)).Count;
        _incomingUsableCount = (await AiKeyShareService.ListIncomingWithUsableOwnerKeyAsync(_user.Id)).Count;
        _forceShowOwnKeyFields = false;
        Toast.Show("AI settings saved (API key and model).", CbToastSeverity.Success);
    }

    private async Task OnDensityChanged(bool isCompact)
    {
        _isCompactDensity = isCompact;
        var mode = isCompact ? "compact" : "comfy";
        try
        {
            await JS.InvokeVoidAsync("cookbot.setDensity", mode);
        }
        catch (InvalidOperationException) { /* prerender — ignore */ }
    }

    private async Task OnAccentChanged(string newAccent)
    {
        _accent = newAccent;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "cookbot_accent", newAccent); } catch { }
        try { await JS.InvokeVoidAsync("cookbot.setAccent", newAccent); } catch { }
    }

    // QOL-06 / Plan 10-07: AI assistant instructions prompt editor methods

    private async Task InsertToken(string token)
    {
        try { await JS.InvokeVoidAsync("CookbotPromptEditor.insertAtCursor", _promptTextareaId, token); }
        catch (JSException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private async Task ConfirmResetPromptAsync()
    {
        var parameters = new CbDialogParameters
        {
            { nameof(CbConfirmDialog.Title), "Reset prompt template?" },
            { nameof(CbConfirmDialog.Body), "Your custom template will be lost. The default will be loaded into the editor — you can still cancel by closing the page without saving." },
            { nameof(CbConfirmDialog.ConfirmLabel), "Reset" },
            { nameof(CbConfirmDialog.ConfirmVariant), CbButton.CbButtonVariant.Accent },
        };
        var result = await CbDialogService.ShowAsync<CbConfirmDialog>("Reset prompt template?", parameters);
        if (!result.Canceled)
        {
            _promptTemplate = PromptBuilderService.DefaultTemplate;
            StateHasChanged();
        }
    }

    private async Task SavePromptTemplateAsync()
    {
        if (_profile == null || _user == null) return;
        try
        {
            _profile.AiSystemPromptTemplate = string.IsNullOrWhiteSpace(_promptTemplate) ? null : _promptTemplate;
            DbContext.UserProfiles.Update(_profile);
            await DbContext.SaveChangesAsync();
            Toast.Show("AI assistant instructions saved.", CbToastSeverity.Success);
        }
        catch (Exception ex)
        {
            Toast.Show($"Save failed: {ex.Message}", CbToastSeverity.Error);
        }
    }
