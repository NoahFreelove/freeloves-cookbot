@page "/cookbooks/{CookbookId:int}/recipes/new"
@page "/recipes/{RecipeId:int}/edit"
@using CookBot.Application.DTOs
@using CookBot.Application.Services
@using CookBot.Domain.Entities
@using CookBot.Domain.Interfaces
@using CookBot.Web.Components.Atoms
@using CookBot.Web.Components.Pages.RecipeEditorParts
@using Microsoft.Extensions.Options
@inject CookBot.Infrastructure.Data.CookBotDbContext DbContext
@inject CookBot.Domain.Interfaces.IRecipeFormatParser Parser
@inject CookBot.Application.Services.RecipeService RecipeService
@inject CurrentUserService UserService
@inject NavigationManager Navigation
@inject ICbToastService Toast
@inject ICbDialogService CbDialogService
@inject IOptions<CookBotSettings> CookBotSettingsOptions
@inject ICbTopBarService TopBarService
@implements IDisposable
@rendermode InteractiveServer

@*  Recipe Editor — Phase 6 / Plan 06-04 / ED-01..ED-09 (absorbs v1.1 EDITOR-01..07).
    Custom Razor rewrite against Phase 5 atoms per design handoff
    `screens/recipe-editor.jsx`. Borderless title/subtitle inputs, ingredients grid
    table, chip-aware step composer, right meta rail (Cookbook/Times/Tags/AI), inline
    timer-suggestion banner, paste-raw-text routing through the canonical schema parser.

    Saves go through RecipeService.UpdateAsync / CreateAsync — which canonicalize via
    JsonRecipeSerializer round-trip on every save (v1.1 Phase 1). The editor's only
    obligation is to produce a valid ParsedRecipe; the service handles the rest.

    Hard invariants:
      - Round-trip integrity (SC#4): Project → Serialize → Parse → ValidateSemantically
        returns identical RecipeDocument.
      - AI Suggestions card hidden when UserProfile.AiEnabled = false. *@

<PageTitle>CookBot - @(_isEdit ? "Edit" : "New") Recipe</PageTitle>

<UserGuard>
@* Top action row — also rendered in TopBar.RightSlot on wide viewports (Phase 10 / Plan 10-09 / POLISH-04).
   D-59: class="recipe-actions-inline-fallback" is hidden above 720px by CSS media query; the TopBar slot
   shows the same _topBarActions RenderFragment instead. Below 720px the slot is hidden and this row shows. *@
<div class="recipe-actions-inline-fallback" style="max-width:1180px;margin:0 auto;padding:24px 32px 0 32px;display:flex;align-items:center;gap:10px;">
    <button type="button"
            class="cb-btn ghost"
            style="padding:6px 12px;"
            aria-label="Back"
            @onclick="GoBack">
        <Icon Name="@Icon.Names.ArrowL" Size="14" /> Back
    </button>
    <div style="flex:1;color:var(--ink-3);font-size:13px;">
        @(_existingRecipe?.Cookbook?.Name is { Length: > 0 } cb ? $"Cookbooks / {cb}" : "Cookbooks")
    </div>
    @_topBarActions
</div>

@if (_warnings.Any())
{
    <div style="max-width:1180px;margin:12px auto 0 auto;padding:0 32px;">
        <div role="status"
             style="background:var(--warn-soft);color:var(--warn);border-radius:10px;padding:10px 14px;font-size:13.5px;">
            <strong>Heads up — some fields need attention:</strong>
            @foreach (var w in _warnings)
            {
                <div>@w</div>
            }
        </div>
    </div>
}

<div style="max-width:1180px;margin:0 auto;padding:32px 32px 80px;display:grid;grid-template-columns:1fr 320px;gap:32px;">
    @* === Main column === *@
    <div>
        @* Phase 9 / Plan 09-02 / D-38 — Photo composite at TOP of the editor.
           Both inputs (paste-URL + upload) always visible inside the composite.
           Wraps the cb-card in drag-cancel handlers so a stray drag-and-drop
           on the surrounding margin cannot navigate the page away (legacy
           PITFALL: dropping a URL on the editor used to wipe unsaved state). *@
        <div @ondragover:preventDefault
             @ondragover:stopPropagation
             @ondrop:preventDefault
             @ondrop:stopPropagation>
            <RecipePhotoComposite PhotoUrl="@_photoUrl"
                                  PhotoUrlChanged="OnPhotoUrlChanged" />
        </div>

        @* Title (ED-01) — borderless, design tokens *@
        <input type="text"
               value="@_name"
               placeholder="Recipe title"
               aria-label="Recipe title"
               style="font-size:38px;font-weight:600;letter-spacing:-0.025em;width:100%;border:0;outline:none;background:transparent;font-family:inherit;color:var(--ink);margin-bottom:6px;"
               @oninput="OnNameInput" />

        @* Phase 9 / Plan 09-02 / D-39 — Description directly BELOW the title,
           ABOVE the ingredients section. CbTextarea (3 rows) replaces the
           previous borderless single-line input. Reading order: photo
           composite → name → description → ingredients → steps. *@
        <div style="margin-bottom:24px;">
            <CbTextarea Value="@_description"
                        ValueChanged="OnDescriptionChanged"
                        Rows="3"
                        Placeholder="A short description of this recipe — what it is, not the first step"
                        AriaLabel="Recipe description" />
        </div>

        @* === Ingredients (ED-02 / ED-06) === *@
        <CbEyebrow><div style="margin-bottom:12px;">Ingredients</div></CbEyebrow>
        <div style="background:var(--paper);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:32px;">
            @if (_ingredients.Count == 0)
            {
                <div style="padding:14px;color:var(--ink-3);font-size:13.5px;text-align:center;">
                    No ingredients yet. Click "Add ingredient" to get started.
                </div>
            }
            else
            {
                @for (int i = 0; i < _ingredients.Count; i++)
                {
                    var index = i;
                    var ing = _ingredients[index];
                    var isLast = index == _ingredients.Count - 1;
                    <div style="display:grid;grid-template-columns:60px 70px 1fr 32px 28px;gap:0;align-items:center;border-bottom:@(isLast ? "none" : "1px solid var(--line)");">
                        <input type="text"
                               class="num"
                               value="@(ing.Amount > 0 ? FormatAmount(ing.Amount) : string.Empty)"
                               placeholder="qty"
                               aria-label="Quantity"
                               style="padding:12px 14px;border:0;background:transparent;font-family:inherit;font-size:14px;font-weight:500;outline:none;"
                               @oninput="@(e => OnIngredientAmountInput(index, e))"
                               @onkeydown="@(e => OnIngredientKeyDown(index, 0, e))" />
                        <input type="text"
                               value="@ing.Unit"
                               placeholder="unit"
                               aria-label="Unit"
                               style="padding:12px 8px;border:0;background:transparent;font-family:inherit;font-size:13.5px;color:var(--ink-3);outline:none;"
                               @oninput="@(e => ing.Unit = e.Value as string ?? string.Empty)"
                               @onkeydown="@(e => OnIngredientKeyDown(index, 1, e))" />
                        <input type="text"
                               value="@ing.Name"
                               placeholder="ingredient name"
                               aria-label="Ingredient name"
                               style="padding:12px 8px;border:0;background:transparent;font-family:inherit;font-size:14px;outline:none;"
                               @oninput="@(e => ing.Name = e.Value as string ?? string.Empty)"
                               @onkeydown="@(e => OnIngredientKeyDown(index, 2, e))" />
                        <button type="button"
                                aria-label="Move ingredient up"
                                title="Move up"
                                disabled="@(index == 0)"
                                style="background:transparent;border:0;color:var(--ink-4);cursor:@(index == 0 ? "not-allowed" : "pointer");padding:0;display:flex;align-items:center;justify-content:center;"
                                @onclick="@(() => MoveIngredientUp(index))">
                            <Icon Name="@Icon.Names.ChevD" Size="14" Style="transform:rotate(180deg);" />
                        </button>
                        <button type="button"
                                aria-label="Delete ingredient"
                                title="Delete"
                                style="background:transparent;border:0;color:var(--ink-4);cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center;"
                                @onclick="@(() => RemoveIngredient(index))">
                            <Icon Name="@Icon.Names.Trash" Size="14" />
                        </button>
                    </div>
                }
            }
            <div style="padding:10px;border-top:1px solid var(--line);background:var(--paper-2);">
                <button type="button"
                        class="cb-btn ghost"
                        style="width:100%;justify-content:center;font-weight:500;"
                        @onclick="AddIngredient">
                    <Icon Name="@Icon.Names.Plus" Size="14" /> Add ingredient
                </button>
            </div>
        </div>

        @* === Steps (ED-03 / ED-04 / ED-05) === *@
        <CbEyebrow><div style="margin-bottom:12px;">Steps</div></CbEyebrow>
        @if (_steps.Count == 0)
        {
            <div class="cb-card" style="padding:14px;color:var(--ink-3);font-size:13.5px;text-align:center;margin-bottom:12px;">
                No steps yet. Click "Add step" to get started.
            </div>
        }
        @for (int i = 0; i < _steps.Count; i++)
        {
            var index = i;
            var step = _steps[index];
            var isLast = index == _steps.Count - 1;
            <RecipeStepEditor Step="@step"
                              Index="@index"
                              IsLast="@isLast"
                              Ingredients="@_ingredients"
                              OnRemove="@(() => RemoveStep(index))"
                              OnMoveUp="@(() => MoveStepUp(index))"
                              OnMoveDown="@(() => MoveStepDown(index))" />
        }
        <button type="button"
                class="cb-btn ghost"
                style="margin-top:8px;width:100%;justify-content:center;"
                @onclick="AddStep">
            <Icon Name="@Icon.Names.Plus" Size="14" /> Add step
        </button>
    </div>

    @* === Right rail — meta cards === *@
    <aside style="display:flex;flex-direction:column;gap:16px;">

        @* Cookbook (selector) *@
        <CbCard Padding="18">
            <CbEyebrow><div style="margin-bottom:10px;">Cookbook</div></CbEyebrow>
            @if (_availableCookbooks.Count == 0)
            {
                <div class="cb-row active" style="background:var(--cream-2);color:var(--ink-2);">
                    <Icon Name="@Icon.Names.Book" Size="14" />
                    <span style="flex:1;">No cookbook</span>
                </div>
            }
            else
            {
                <CbDropdown TValue="int"
                            Value="@_selectedCookbookId"
                            ValueChanged="OnCookbookChanged"
                            Label="@(_availableCookbooks.FirstOrDefault(c => c.Id == _selectedCookbookId)?.Name ?? "Select cookbook")"
                            StartIcon="@Icon.Names.Book">
                    @foreach (var cb in _availableCookbooks)
                    {
                        <CbDropdownItem TValue="int" Value="@cb.Id" Label="@cb.Name" Icon="@Icon.Names.Book" />
                    }
                </CbDropdown>
            }
        </CbCard>

        @* Times & servings *@
        <CbCard Padding="18">
            <CbEyebrow><div style="margin-bottom:10px;">Times &amp; servings</div></CbEyebrow>
            <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);font-size:13.5px;align-items:center;gap:8px;">
                <span style="color:var(--ink-3);">Active</span>
                <span style="display:flex;align-items:center;gap:4px;">
                    <input type="number"
                           class="num cb-meta-num"
                           min="0"
                           value="@(_prepTimeMinutes?.ToString() ?? string.Empty)"
                           aria-label="Active / prep time in minutes"
                           style="font-weight:500;width:48px;text-align:right;border:0;background:transparent;font-family:inherit;font-size:13.5px;outline:none;color:var(--ink);"
                           @oninput="OnPrepTimeInput" />
                    <span style="color:var(--ink-3);font-size:12.5px;">min</span>
                </span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);font-size:13.5px;align-items:center;gap:8px;">
                <span style="color:var(--ink-3);">Cook</span>
                <span style="display:flex;align-items:center;gap:4px;">
                    <input type="number"
                           class="num cb-meta-num"
                           min="0"
                           value="@(_cookTimeMinutes?.ToString() ?? string.Empty)"
                           aria-label="Cook time in minutes"
                           style="font-weight:500;width:48px;text-align:right;border:0;background:transparent;font-family:inherit;font-size:13.5px;outline:none;color:var(--ink);"
                           @oninput="OnCookTimeInput" />
                    <span style="color:var(--ink-3);font-size:12.5px;">min</span>
                </span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:13.5px;align-items:center;">
                <span style="color:var(--ink-3);">Serves</span>
                <input type="number"
                       class="num cb-meta-num"
                       min="1"
                       value="@_servings"
                       aria-label="Servings"
                       style="font-weight:500;width:48px;text-align:right;border:0;background:transparent;font-family:inherit;font-size:13.5px;outline:none;color:var(--ink);"
                       @oninput="OnServingsInput" />
            </div>
        </CbCard>

        @* Tags *@
        <CbCard Padding="18">
            <CbEyebrow><div style="margin-bottom:10px;">Tags</div></CbEyebrow>
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;">
                @if (_tags.Count == 0)
                {
                    <span style="font-size:12.5px;color:var(--ink-3);">No tags yet.</span>
                }
                else
                {
                    @foreach (var t in _tags.ToList())
                    {
                        var captured = t;
                        <span class="cb-chip" style="cursor:default;">
                            @captured
                            <button type="button"
                                    aria-label="@($"Remove tag {captured}")"
                                    style="background:transparent;border:0;color:inherit;cursor:pointer;font-size:14px;line-height:1;padding:0 0 0 4px;display:inline-flex;align-items:center;"
                                    @onclick="@(() => RemoveTag(captured))">×</button>
                        </span>
                    }
                }
            </div>
            <input type="text"
                   value="@_tagInput"
                   placeholder="add tag…"
                   aria-label="Add tag"
                   style="width:100%;padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--cream);font-family:inherit;font-size:13px;outline:none;"
                   @oninput="OnTagInputInput"
                   @onkeydown="OnTagInputKeyDown" />
        </CbCard>

        @* AI suggestions — hidden when AI off (Phase 6 hard invariant) *@
        @if (_aiOn)
        {
            <CbCard Padding="18" Style="background:var(--accent-soft);border:1px solid var(--accent-soft);">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                    <Icon Name="@Icon.Names.Spark" Size="14" />
                    <span style="font-size:13px;font-weight:600;color:var(--accent-ink);">AI suggestions</span>
                </div>
                <p style="font-size:12.5px;color:var(--accent-ink);line-height:1.5;margin-bottom:10px;">
                    Add ingredients and steps; AI suggestions for refinements will appear here once a draft is in place.
                </p>
                <button type="button"
                        class="cb-btn ghost"
                        style="font-size:12.5px;padding:6px 10px;border-color:rgba(107,31,0,.25);"
                        disabled
                        title="AI suggestions are a future capability — Plan 06-04 wires the surface; the backing service ships in Phase 7+">Apply</button>
            </CbCard>
        }
    </aside>
</div>
</UserGuard>

@code {
    [Parameter] public int CookbookId { get; set; }
    [Parameter] public int RecipeId { get; set; }

    // Phase 10 / Plan 10-09 / POLISH-04 / W-02 — RenderFragment fed to TopBar.RightSlot.
    // Constructed once in OnInitialized using the Razor @<text> markup-template form (W-02
    // committed shape, identical to RecipeView). The same fragment also renders in the inline
    // fallback below 720px.
    private RenderFragment? _topBarActions;

    protected override void OnInitialized()
    {
        // W-02: @<text> markup-template construction — identical shape in RecipeView + RecipeEditor.
        _topBarActions = @<text>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                      StartIcon="@Icon.Names.Copy"
                      OnClick="PasteRawText">Paste raw text</CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Ghost"
                      OnClick="GoBack">Cancel</CbButton>
            <CbButton Variant="CbButton.CbButtonVariant.Primary"
                      StartIcon="@Icon.Names.Save"
                      OnClick="SaveRecipe"
                      Disabled="@_saving">
                @(_saving ? "Saving..." : "Save")
            </CbButton>
        </text>;
        // D-57: auto-clear on navigation is handled by CbTopBarService.LocationChanged; no explicit Clear() needed.
        TopBarService.SetRightSlot(_topBarActions);
    }

    // Phase 10 / Plan 10-09 / POLISH-04 — IDisposable required by @implements directive.
    // D-57: service auto-clears on navigation; Dispose is a no-op here but satisfies the contract.
    public void Dispose() { }

    private string _name = string.Empty;
    private string _description = string.Empty;
    // Phase 9 / Plan 09-02 / PHOTO-09 — paste-URL or upload-derived URL bound
    // to RecipePhotoComposite via @bind-style PhotoUrl/PhotoUrlChanged. Null
    // means "no photo" — empty strings are normalized to null in
    // OnPhotoUrlChanged (matches D-38: empty strings are not persisted).
    private string? _photoUrl;
    private int _servings = 4;
    private int? _prepTimeMinutes;
    private int? _cookTimeMinutes;
    private List<string> _tags = new();
    private string _tagInput = string.Empty;

    private List<ParsedIngredient> _ingredients = new();
    private List<ParsedStep> _steps = new();
    private List<string> _warnings = new();

    private List<Cookbook> _availableCookbooks = new();
    private int _selectedCookbookId;

    private int _nextLocalId = 1;
    private bool _isEdit;
    private bool _saving;
    private bool _aiOn;
    private Recipe? _existingRecipe;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!UserService.CurrentUserId.HasValue) return;
        var userId = UserService.CurrentUserId.Value;

        if (firstRender)
        {
            // Load AI flag (host kill-switch + per-user opt-in).
            var user = await UserService.GetCurrentUserAsync();
            var hostOn = CookBotSettingsOptions.Value.AiFeaturesEnabled;
            var userOn = user?.Profile?.AiEnabled ?? false;
            _aiOn = hostOn && userOn;

            // Load owned cookbooks for the right-rail selector.
            _availableCookbooks = await DbContext.Cookbooks
                .Where(c => c.UserId == userId)
                .OrderBy(c => c.Name)
                .ToListAsync();

            if (RecipeId > 0)
            {
                _isEdit = true;
                _existingRecipe = await DbContext.Recipes
                    .Include(r => r.Cookbook)
                    .Include(r => r.Steps)
                    .Include(r => r.RecipeIngredients).ThenInclude(ri => ri.Ingredient)
                    .Include(r => r.Tags) // CLEAN-02: tag read switches to relational path (Plan 08)
                    .FirstOrDefaultAsync(r => r.Id == RecipeId);

                if (_existingRecipe != null)
                {
                    if (_existingRecipe.Cookbook.UserId != userId)
                    {
                        Navigation.NavigateTo("/cookbooks");
                        return;
                    }
                    _existingRecipe.Steps = _existingRecipe.Steps.OrderBy(s => s.Order).ToList();
                    CookbookId = _existingRecipe.CookbookId;
                    _selectedCookbookId = CookbookId;
                    PopulateFromRecipe(_existingRecipe);
                }
            }
            else if (CookbookId > 0)
            {
                var cookbook = await DbContext.Cookbooks.FindAsync(CookbookId);
                if (cookbook == null || cookbook.UserId != userId)
                {
                    Navigation.NavigateTo("/cookbooks");
                    return;
                }
                _selectedCookbookId = CookbookId;
            }

            StateHasChanged();
        }
    }

    private void PopulateFromRecipe(Recipe recipe)
    {
        _name = recipe.Name;
        // Phase 8 / SCHEMA-06 added Recipe.Description; Phase 9 / Plan 09-02
        // surfaces it in the editor (D-39).
        _description = recipe.Description ?? string.Empty;
        // Phase 8 / SCHEMA-05 added Recipe.PhotoUrl; Phase 9 / Plan 09-02
        // surfaces it via the photo composite at the top of the editor (D-38).
        _photoUrl = recipe.PhotoUrl;
        _servings = recipe.Servings;
        _prepTimeMinutes = recipe.PrepTimeMinutes;
        _cookTimeMinutes = recipe.CookTimeMinutes;

        // CLEAN-02 (Plan 08): read tags from relational RecipeTag collection (.Include(r => r.Tags) in load query above).
        _tags = recipe.Tags.Select(t => t.Name).ToList();

        _ingredients = recipe.RecipeIngredients
            .OrderBy(ri => ri.RecipeLocalId)
            .Select(ri => new ParsedIngredient
            {
                LocalId = ri.RecipeLocalId,
                Name = ri.Ingredient.Name,
                Amount = ri.Amount,
                Unit = ri.Unit,
                Note = ri.Note,
            }).ToList();

        _nextLocalId = _ingredients.Any() ? _ingredients.Max(i => i.LocalId) + 1 : 1;

        _steps = recipe.Steps
            .OrderBy(s => s.Order)
            .Select(s => new ParsedStep
            {
                Text = s.Text,
                IsSection = s.IsSection,
                Timers = s.Timers?.Select(t => new ParsedTimer
                {
                    Duration = t.Duration,
                    Unit = t.Unit,
                    Label = t.Label,
                }).ToList() ?? new List<ParsedTimer>(),
            }).ToList();
    }

    private void PopulateFromParsed(ParsedRecipe parsed)
    {
        if (!string.IsNullOrWhiteSpace(parsed.Name))
            _name = parsed.Name;
        if (parsed.Servings > 0)
            _servings = parsed.Servings;
        _prepTimeMinutes = parsed.PrepTimeMinutes;
        _cookTimeMinutes = parsed.CookTimeMinutes;
        // Phase 9 / Plan 09-02 — paste-raw-text dialog may surface PhotoUrl /
        // Description if the source already carried them through the canonical
        // parser. Only overwrite when the parser actually produced a value so
        // existing editor state isn't clobbered by a paste that omitted them.
        if (!string.IsNullOrWhiteSpace(parsed.PhotoUrl))
            _photoUrl = parsed.PhotoUrl;
        if (!string.IsNullOrWhiteSpace(parsed.Description))
            _description = parsed.Description!;

        if (parsed.Tags.Any())
            _tags = parsed.Tags.ToList();

        if (parsed.Ingredients.Any())
        {
            _ingredients = parsed.Ingredients.Select(i => new ParsedIngredient
            {
                LocalId = i.LocalId > 0 ? i.LocalId : _nextLocalId++,
                Name = i.Name,
                Amount = i.Amount,
                Unit = i.Unit,
                Note = i.Note,
            }).ToList();
            _nextLocalId = _ingredients.Max(i => i.LocalId) + 1;
        }

        if (parsed.Steps.Any())
        {
            _steps = parsed.Steps.Select(s => new ParsedStep
            {
                Text = s.Text,
                IsSection = s.IsSection,
                Timers = s.Timers?.Select(t => new ParsedTimer
                {
                    Duration = t.Duration,
                    Unit = t.Unit,
                    Label = t.Label,
                }).ToList() ?? new List<ParsedTimer>(),
            }).ToList();
        }

        _warnings.Clear();
    }

    // ------------------------------------------------------------------------
    // Title / description / numeric meta inputs
    // ------------------------------------------------------------------------

    private void OnNameInput(ChangeEventArgs e) => _name = e.Value as string ?? string.Empty;

    // Phase 9 / Plan 09-02 — Description is now a CbTextarea (D-39), which exposes
    // a string?-typed ValueChanged callback instead of the raw ChangeEventArgs the
    // previous borderless input used.
    private void OnDescriptionChanged(string? newValue) => _description = newValue ?? string.Empty;

    // Phase 9 / Plan 09-02 — Photo URL flows from RecipePhotoComposite as either
    // a validated http/https URL, an uploaded file URL (/uploads/{guid}.ext), or
    // null on clear / whitespace-only paste (D-38: empty strings are not
    // persisted, normalized to null here as a belt-and-braces guard).
    private void OnPhotoUrlChanged(string? newUrl)
        => _photoUrl = string.IsNullOrWhiteSpace(newUrl) ? null : newUrl;

    private void OnPrepTimeInput(ChangeEventArgs e)
    {
        var v = e.Value as string;
        _prepTimeMinutes = int.TryParse(v, out var n) && n >= 0 ? n : null;
    }

    private void OnCookTimeInput(ChangeEventArgs e)
    {
        var v = e.Value as string;
        _cookTimeMinutes = int.TryParse(v, out var n) && n >= 0 ? n : null;
    }

    private void OnServingsInput(ChangeEventArgs e)
    {
        var v = e.Value as string;
        if (int.TryParse(v, out var n) && n >= 1) _servings = n;
    }

    // ------------------------------------------------------------------------
    // Tags
    // ------------------------------------------------------------------------

    private void OnTagInputInput(ChangeEventArgs e) => _tagInput = e.Value as string ?? string.Empty;

    private void OnTagInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == ",")
        {
            CommitTag();
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_tagInput) && _tags.Count > 0)
        {
            _tags.RemoveAt(_tags.Count - 1);
        }
    }

    private void CommitTag()
    {
        var t = (_tagInput ?? string.Empty).Trim().TrimEnd(',').Trim();
        if (t.Length > 0 && !_tags.Contains(t, StringComparer.OrdinalIgnoreCase))
            _tags.Add(t);
        _tagInput = string.Empty;
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
    }

    // ------------------------------------------------------------------------
    // Cookbook selector
    // ------------------------------------------------------------------------

    private void OnCookbookChanged(int newId)
    {
        if (newId <= 0) return;
        _selectedCookbookId = newId;
        CookbookId = newId;
    }

    // ------------------------------------------------------------------------
    // Ingredient operations (ED-02 / ED-06 — preserve immutable LocalId on reorder)
    // ------------------------------------------------------------------------

    private void AddIngredient()
    {
        _ingredients.Add(new ParsedIngredient
        {
            LocalId = _nextLocalId++,
            Amount = 0,
            Unit = string.Empty,
            Name = string.Empty,
        });
    }

    private void RemoveIngredient(int index)
    {
        if (index >= 0 && index < _ingredients.Count)
            _ingredients.RemoveAt(index);
    }

    private void MoveIngredientUp(int index)
    {
        if (index <= 0 || index >= _ingredients.Count) return;
        // ED-06: swap REFERENCES — LocalId is preserved on each ParsedIngredient.
        (_ingredients[index], _ingredients[index - 1]) = (_ingredients[index - 1], _ingredients[index]);
    }

    private void OnIngredientAmountInput(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _ingredients.Count) return;
        var s = e.Value as string;
        if (string.IsNullOrWhiteSpace(s))
        {
            _ingredients[index].Amount = 0;
            return;
        }
        // Accept "1", "1.5", "1/2", "1 1/2".
        if (TryParseAmount(s, out var amt))
            _ingredients[index].Amount = amt;
    }

    private static bool TryParseAmount(string s, out double amount)
    {
        amount = 0;
        s = s.Trim();
        if (string.IsNullOrEmpty(s)) return false;
        // "1 1/2" or "1/2"
        var parts = s.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        double total = 0;
        foreach (var p in parts)
        {
            if (p.Contains('/'))
            {
                var seg = p.Split('/');
                if (seg.Length != 2) return false;
                if (!double.TryParse(seg[0], System.Globalization.CultureInfo.InvariantCulture, out var num)) return false;
                if (!double.TryParse(seg[1], System.Globalization.CultureInfo.InvariantCulture, out var den) || den == 0) return false;
                total += num / den;
            }
            else
            {
                if (!double.TryParse(p, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)) return false;
                total += v;
            }
        }
        amount = total;
        return true;
    }

    private static string FormatAmount(double amount)
    {
        if (Math.Abs(amount - Math.Round(amount)) < 0.001) return ((int)Math.Round(amount)).ToString();
        return amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void OnIngredientKeyDown(int rowIndex, int fieldIndex, KeyboardEventArgs e)
    {
        // ED-02 keyboard semantics:
        //   Backspace on an empty row deletes the row.
        // Tab/Shift+Tab between fields is browser-native (we don't intercept).
        if (e.Key == "Backspace")
        {
            var ing = _ingredients[rowIndex];
            var rowEmpty = ing.Amount == 0
                && string.IsNullOrEmpty(ing.Unit)
                && string.IsNullOrEmpty(ing.Name);
            if (rowEmpty && _ingredients.Count > 1)
            {
                _ingredients.RemoveAt(rowIndex);
            }
        }
    }

    // ------------------------------------------------------------------------
    // Step operations
    // ------------------------------------------------------------------------

    private void AddStep()
    {
        _steps.Add(new ParsedStep
        {
            Text = string.Empty,
            IsSection = false,
            Timers = new List<ParsedTimer>(),
        });
    }

    private void RemoveStep(int index)
    {
        if (index >= 0 && index < _steps.Count)
            _steps.RemoveAt(index);
    }

    private void MoveStepUp(int index)
    {
        if (index <= 0 || index >= _steps.Count) return;
        (_steps[index], _steps[index - 1]) = (_steps[index - 1], _steps[index]);
    }

    private void MoveStepDown(int index)
    {
        if (index < 0 || index >= _steps.Count - 1) return;
        (_steps[index], _steps[index + 1]) = (_steps[index + 1], _steps[index]);
    }

    // ------------------------------------------------------------------------
    // Paste raw text (ED-07) — opens PasteRawTextDialog via CbDialogService.
    // ------------------------------------------------------------------------

    private async Task PasteRawText()
    {
        var options = new CbDialogOptions(MaxWidth: CbDialogMaxWidth.Md, FullWidth: true, CloseOnEscape: true);
        var result = await CbDialogService.ShowAsync<PasteRawTextDialog>("Paste Raw Recipe Text", null, options);

        if (result != null && !result.Canceled && result.Data is ParsedRecipe parsed)
        {
            PopulateFromParsed(parsed);
            StateHasChanged();
        }
    }

    // ------------------------------------------------------------------------
    // Save
    // ------------------------------------------------------------------------

    private async Task SaveRecipe()
    {
        // Commit any pending tag input.
        if (!string.IsNullOrWhiteSpace(_tagInput)) CommitTag();

        if (string.IsNullOrWhiteSpace(_name))
        {
            Toast.Show("Recipe name is required.", CbToastSeverity.Warning);
            return;
        }

        if (!_ingredients.Any())
        {
            Toast.Show("Add at least one ingredient.", CbToastSeverity.Warning);
            return;
        }

        if (!_steps.Any())
        {
            Toast.Show("Add at least one step.", CbToastSeverity.Warning);
            return;
        }

        if (_selectedCookbookId <= 0)
        {
            Toast.Show("Pick a cookbook.", CbToastSeverity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var userId = UserService.CurrentUserId!.Value;

            var parsed = new ParsedRecipe
            {
                Name = _name,
                Servings = _servings,
                PrepTimeMinutes = _prepTimeMinutes,
                CookTimeMinutes = _cookTimeMinutes,
                // Phase 9 / Plan 09-02 — propagate the new v3 editor fields
                // through ParsedRecipe; RecipeService canonicalizes them into
                // both the entity columns AND Recipe.CanonicalDocumentJson via
                // JsonRecipeSerializer round-trip on every save.
                // D-38 / D-39: empty strings are not persisted — normalize
                // empty description to null so we don't write empty strings to
                // Recipe.Description (Recipe.PhotoUrl is already null-safe
                // from OnPhotoUrlChanged).
                PhotoUrl = _photoUrl,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                Tags = _tags.ToList(),
                Ingredients = _ingredients.ToList(),
                Steps = _steps.ToList(),
            };

            if (_isEdit && _existingRecipe != null)
            {
                await RecipeService.UpdateAsync(_existingRecipe.Id, userId, parsed);
                Toast.Show("Recipe updated!", CbToastSeverity.Success);
            }
            else
            {
                await RecipeService.CreateAsync(_selectedCookbookId, userId, parsed);
                Toast.Show("Recipe created!", CbToastSeverity.Success);
            }
            Navigation.NavigateTo($"/cookbooks/{_selectedCookbookId}");
        }
        catch (Exception ex)
        {
            Toast.Show($"Error saving recipe: {ex.Message}", CbToastSeverity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void GoBack()
    {
        if (_selectedCookbookId > 0)
            Navigation.NavigateTo($"/cookbooks/{_selectedCookbookId}");
        else if (CookbookId > 0)
            Navigation.NavigateTo($"/cookbooks/{CookbookId}");
        else
            Navigation.NavigateTo("/cookbooks");
    }
}
