@* Phase 7 / Plan 07-01: paste-raw-recipe-text → ParsedRecipe dialog.
   Renders inside CbDialogHost; supplies Body + Footer markup only. *@
@inject CookBot.Domain.Interfaces.IRecipeFormatParser Parser

<div>
    <label style="display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-2);margin-bottom:12px;">
        <span>Paste your recipe text here</span>
        <CbTextarea @bind-Value="_rawText" Rows="15"
                    Placeholder="Paste or write your recipe here..." />
    </label>

    @if (_errors.Any())
    {
        <div role="alert"
             style="margin-top:6px;padding:10px 12px;background:rgba(230, 81, 0, 0.08);border:1px solid rgba(230, 81, 0, 0.25);border-radius:8px;font-size:13px;color:var(--ink-2);">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:18px;">
        <CbButton Variant="CbButton.CbButtonVariant.Ghost" OnClick="Cancel">Cancel</CbButton>
        <CbButton Variant="CbButton.CbButtonVariant.Primary" OnClick="Submit"
                  Disabled="@string.IsNullOrWhiteSpace(_rawText)">Import</CbButton>
    </div>
</div>

@code {
    [CascadingParameter] private CbDialogInstance? DialogInstance { get; set; }

    private string _rawText = string.Empty;
    private List<string> _errors = new();

    private void Cancel() => DialogInstance?.Cancel();

    private void Submit()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_rawText))
            return;

        if (Parser.TryParse(_rawText, out var parsed, out var errors))
        {
            DialogInstance?.Close(CbDialogResult.Ok(parsed));
            return;
        }

        _errors = errors;
    }
}
