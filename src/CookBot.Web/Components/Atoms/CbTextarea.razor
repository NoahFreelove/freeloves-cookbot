@namespace CookBot.Web.Components.Atoms

@* Styled textarea wrapper (D-17 / ATOM-10).
   Same baseline visual as CbInput — line border, paper bg, 8px radius, accent
   focus ring. Default Rows=4; min-height 64px; vertical resize allowed. *@

<textarea class="cb-textarea" rows="@Rows"
          placeholder="@Placeholder" disabled="@Disabled"
          aria-label="@AriaLabel"
          @oninput="HandleInput">@Value</textarea>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int Rows { get; set; } = 4;
    /// <summary>A11Y-03: optional accessible name when no associated label
    /// wraps the textarea. Plan 07-06.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        var v = e.Value as string;
        if (v != Value)
        {
            Value = v;
            await ValueChanged.InvokeAsync(v);
        }
    }
}
