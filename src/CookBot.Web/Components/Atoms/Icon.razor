@namespace CookBot.Web.Components.Atoms

@* Single Razor component dispatching all 36 outline icons from
   .planning/design-handoff/project/icons.jsx (Phase 5 / ATOM-07 / D-08).
   Path data is ported verbatim. Stroke uses currentColor; sized via Size param.
   Unknown names render a fixed "?" glyph and log a one-line stderr warning. *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
     class="icon" style="@_combinedStyle"
     aria-hidden="true" focusable="false">
    @((MarkupString)PathFor(Name))
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Style { get; set; }

    private string _combinedStyle => string.IsNullOrEmpty(Style)
        ? "flex-shrink:0;vertical-align:middle;"
        : $"flex-shrink:0;vertical-align:middle;{Style}";

    /// <summary>
    /// Canonical icon-name constants. Use these from C# to avoid typos:
    /// <c>&lt;Icon Name="@Icon.Names.Home" /&gt;</c>.
    /// </summary>
    public static class Names
    {
        public const string Home = "home";
        public const string Book = "book";
        public const string Pantry = "pantry";
        public const string Cart = "cart";
        public const string Spark = "spark";
        public const string Prompt = "prompt";
        public const string User = "user";
        public const string Menu = "menu";
        public const string Search = "search";
        public const string Plus = "plus";
        public const string Check = "check";
        public const string Clock = "clock";
        public const string Flame = "flame";
        public const string Pause = "pause";
        public const string Play = "play";
        public const string ArrowR = "arrowR";
        public const string ArrowL = "arrowL";
        public const string Bell = "bell";
        public const string Sun = "sun";
        public const string Moon = "moon";
        public const string Share = "share";
        public const string Download = "download";
        public const string Copy = "copy";
        public const string Pencil = "pencil";
        public const string More = "more";
        public const string Trash = "trash";
        public const string Scale = "scale";
        public const string Bolt = "bolt";
        public const string Filter = "filter";
        public const string Grid = "grid";
        public const string List = "list";
        public const string ChevD = "chevD";
        public const string ChevR = "chevR";
        public const string Flag = "flag";
        public const string Send = "send";
        public const string Save = "save";
        public const string Link = "link";
    }

    private static string PathFor(string name) => name switch
    {
        "home"     => "<path d=\"M3 11.5L12 4l9 7.5\"/><path d=\"M5 10.5V20h14v-9.5\"/><path d=\"M10 20v-5h4v5\"/>",
        "book"     => "<path d=\"M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4z\"/><path d=\"M5 17h14\"/>",
        "pantry"   => "<rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M4 9h16M4 15h16M12 3v18\"/>",
        "cart"     => "<path d=\"M3 4h2l2.5 11h11l2-8H6\"/><circle cx=\"9\" cy=\"19\" r=\"1.4\"/><circle cx=\"17\" cy=\"19\" r=\"1.4\"/>",
        "spark"    => "<path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8\"/>",
        "prompt"   => "<path d=\"M4 6h16M4 12h10M4 18h16\"/>",
        "user"     => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 5-6 8-6s6.5 2 8 6\"/>",
        "menu"     => "<path d=\"M4 7h16M4 12h16M4 17h16\"/>",
        "search"   => "<circle cx=\"11\" cy=\"11\" r=\"6\"/><path d=\"M16 16l4 4\"/>",
        "plus"     => "<path d=\"M12 5v14M5 12h14\"/>",
        "check"    => "<path d=\"M5 12.5l4 4 10-10\"/>",
        "clock"    => "<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 7.5V12l3 2\"/>",
        "flame"    => "<path d=\"M12 3s5 4 5 9a5 5 0 0 1-10 0c0-1.5.5-2.5 1.5-3.5C8 10 9 11 9 12c0-3 1.5-6 3-9z\"/>",
        "pause"    => "<rect x=\"7\" y=\"5\" width=\"3.5\" height=\"14\" rx=\"1\"/><rect x=\"13.5\" y=\"5\" width=\"3.5\" height=\"14\" rx=\"1\"/>",
        "play"     => "<path d=\"M7 5v14l12-7-12-7z\" fill=\"currentColor\"/>",
        "arrowR"   => "<path d=\"M5 12h14M13 6l6 6-6 6\"/>",
        "arrowL"   => "<path d=\"M19 12H5M11 6l-6 6 6 6\"/>",
        "bell"     => "<path d=\"M6 17V11a6 6 0 1 1 12 0v6l1.5 2H4.5L6 17z\"/><path d=\"M10 21h4\"/>",
        "sun"      => "<circle cx=\"12\" cy=\"12\" r=\"3.5\"/><path d=\"M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4\"/>",
        "moon"     => "<path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"/>",
        "share"    => "<circle cx=\"6\" cy=\"12\" r=\"2.5\"/><circle cx=\"18\" cy=\"6\" r=\"2.5\"/><circle cx=\"18\" cy=\"18\" r=\"2.5\"/><path d=\"M8.2 11l7.6-3.6M8.2 13l7.6 3.6\"/>",
        "download" => "<path d=\"M12 4v12M6 11l6 6 6-6M5 20h14\"/>",
        "copy"     => "<rect x=\"8\" y=\"8\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2\"/>",
        "pencil"   => "<path d=\"M4 20l4-1 11-11-3-3L5 16l-1 4z\"/>",
        "more"     => "<circle cx=\"6\" cy=\"12\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"12\" r=\"1.4\" fill=\"currentColor\"/><circle cx=\"18\" cy=\"12\" r=\"1.4\" fill=\"currentColor\"/>",
        "trash"    => "<path d=\"M5 7h14M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M7 7v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V7\"/>",
        "scale"    => "<path d=\"M5 19h14M12 4v15M6 9l6-5 6 5M3 14a3 3 0 0 0 6 0l-3-5-3 5zM15 14a3 3 0 0 0 6 0l-3-5-3 5z\"/>",
        "bolt"     => "<path d=\"M13 3L4 14h7l-2 7 9-11h-7l2-7z\"/>",
        "filter"   => "<path d=\"M3 5h18M6 12h12M10 19h4\"/>",
        "grid"     => "<rect x=\"4\" y=\"4\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"13\" y=\"4\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"4\" y=\"13\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"13\" y=\"13\" width=\"7\" height=\"7\" rx=\"1\"/>",
        "list"     => "<path d=\"M8 6h12M8 12h12M8 18h12\"/><circle cx=\"4\" cy=\"6\" r=\"1.2\" fill=\"currentColor\"/><circle cx=\"4\" cy=\"12\" r=\"1.2\" fill=\"currentColor\"/><circle cx=\"4\" cy=\"18\" r=\"1.2\" fill=\"currentColor\"/>",
        "chevD"    => "<path d=\"M6 9l6 6 6-6\"/>",
        "chevR"    => "<path d=\"M9 6l6 6-6 6\"/>",
        "flag"     => "<path d=\"M5 3v18M5 4h12l-2 4 2 4H5\"/>",
        "send"     => "<path d=\"M4 12L20 4l-7 16-2-7-7-1z\"/>",
        "save"     => "<path d=\"M5 5h11l3 3v11H5z\"/><path d=\"M8 5v5h7V5M8 19v-6h8v6\"/>",
        "link"     => "<path d=\"M9 15a4 4 0 0 1 0-6l3-3a4 4 0 0 1 6 6l-1 1\"/><path d=\"M15 9a4 4 0 0 1 0 6l-3 3a4 4 0 0 1-6-6l1-1\"/>",
        _          => UnknownGlyph(name),
    };

    private static string UnknownGlyph(string name)
    {
        Console.Error.WriteLine($"[Icon] Unknown name: {name}");
        return "<text x=\"6\" y=\"17\" font-size=\"14\" stroke=\"none\" fill=\"currentColor\">?</text>";
    }
}
