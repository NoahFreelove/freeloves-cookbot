@namespace CookBot.Web.Components.Atoms

@* CbButton — Phase 5 / ATOM-01 / D-10.
   Renders a 999px pill button using the .cb-btn class (light/dark wired in cookbot-design.css).
   Variants: Primary (cocoa fill, default), Accent (orange), Ghost (transparent + border), Subtle.
   StartIcon / EndIcon accept icon-name strings and resolve through <Icon> (Plan 05-01). *@

<button @attributes="AdditionalAttributes"
        type="@Type"
        class="@ClassAttr"
        style="@StyleAttr"
        disabled="@Disabled"
        @onclick="OnClick">
    @if (!string.IsNullOrEmpty(StartIcon))
    {
        <Icon Name="@StartIcon" Size="14" />
    }
    @ChildContent
    @if (!string.IsNullOrEmpty(EndIcon))
    {
        <Icon Name="@EndIcon" Size="14" />
    }
</button>

@code {
    public enum CbButtonVariant { Primary, Accent, Ghost, Subtle }

    [Parameter] public CbButtonVariant Variant { get; set; } = CbButtonVariant.Primary;
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Style { get; set; }

    // Forward unmatched HTML attributes (title, aria-*, data-*, etc.) onto the
    // underlying <button>. Without this, passing any attribute the component does
    // not explicitly declare throws InvalidOperationException at render time
    // (e.g. RecipeView's "Export as .cook" title tooltip — INTEROP-04). Additive
    // and backward-compatible: existing callers pass no extra attributes.
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ClassAttr => Variant switch
    {
        CbButtonVariant.Primary => "cb-btn",
        CbButtonVariant.Accent  => "cb-btn accent",
        CbButtonVariant.Ghost   => "cb-btn ghost",
        CbButtonVariant.Subtle  => "cb-btn subtle",
        _                        => "cb-btn"
    };

    private string StyleAttr
    {
        get
        {
            var s = FullWidth ? "width:100%;justify-content:center;" : string.Empty;
            return string.IsNullOrEmpty(Style) ? s : s + Style;
        }
    }
}
