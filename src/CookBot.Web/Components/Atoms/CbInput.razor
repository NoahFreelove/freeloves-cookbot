@namespace CookBot.Web.Components.Atoms

@* Styled text input wrapper (D-17 / ATOM-10).
   Renders a native <input> with class="cb-input" — line border, paper bg, 8px radius,
   accent focus-visible ring (foundation for A11Y-01). String two-way binding via
   @bind-Value. By default value updates fire on every keystroke (oninput); set
   DebounceOnInput="true" to defer until blur/change. *@

<input type="@Type" class="cb-input" value="@Value"
       placeholder="@Placeholder" disabled="@Disabled"
       style="@Style"
       aria-label="@AriaLabel"
       @oninput="HandleInput" @onchange="HandleChange" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public bool DebounceOnInput { get; set; } = false;
    /// <summary>A11Y-03: optional accessible name for the input when no
    /// associated &lt;label&gt; element wraps it. Plan 07-06.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (DebounceOnInput) return;  // wait for change (blur) instead
        var v = e.Value as string;
        if (v != Value)
        {
            Value = v;
            await ValueChanged.InvokeAsync(v);
        }
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        var v = e.Value as string;
        if (v != Value)
        {
            Value = v;
            await ValueChanged.InvokeAsync(v);
        }
    }
}
