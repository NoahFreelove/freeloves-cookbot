@namespace CookBot.Web.Components.Atoms

@* Custom-styled checkbox (D-16 / ATOM-09).
   Native <input type="checkbox"> is hidden via CSS — it stays in the DOM so the
   browser handles keyboard activation (Space) and screen-reader semantics.
   The .box span renders the visual square; the ::after pseudo-element draws the
   check glyph when input:checked. *@

<label class="cb-checkbox">
    <input type="checkbox" checked="@Value" @onchange="HandleChange" disabled="@Disabled" />
    <span class="box"></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleChange(ChangeEventArgs e)
    {
        var newValue = e.Value is bool b && b;
        if (newValue != Value)
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}
