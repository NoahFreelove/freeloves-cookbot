@namespace CookBot.Web.Components.Atoms
@typeparam TValue

@* Custom-styled radio button (D-16 / ATOM-09).
   Generic over TValue so callers can use string / int / enum group values.

   Binding pattern: caller supplies @bind-CurrentValue="_selected" plus a
   per-radio Value="@theOption". This radio is selected when
   EqualityComparer<TValue>.Default.Equals(CurrentValue, Value).

   GroupName ties radios into a native HTML radio group — required for keyboard
   arrow-key navigation between options. *@

<label class="cb-radio">
    <input type="radio" name="@GroupName" checked="@IsSelected" @onchange="HandleChange" disabled="@Disabled" />
    <span class="circle"></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</label>

@code {
    [Parameter, EditorRequired] public TValue Value { get; set; } = default!;
    [Parameter] public TValue? CurrentValue { get; set; }
    [Parameter] public EventCallback<TValue> CurrentValueChanged { get; set; }
    [Parameter] public string GroupName { get; set; } = "default";
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool IsSelected => EqualityComparer<TValue>.Default.Equals(CurrentValue, Value);

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (!IsSelected)
        {
            await CurrentValueChanged.InvokeAsync(Value);
        }
    }
}
